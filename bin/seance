#!/bin/sh
# seance -- dispatcher.
#
# Plain sh on purpose: everything below the CBSD verb wrapper must run without
# cbsd, because tiers 1-4 and the pseudo-cluster drive it directly (D-2).
#
# stdout is data, stderr is diagnostics, and the exit code is the verdict:
#   0  ok
#   1  operation failed
#   2  usage or contract error
#  75  EX_TEMPFAIL: another process owns what this one was asked to do.
#      `promote` only -- another ladder holds the dead node's lock (D-155).
#
# shellcheck disable=SC3043
#   'local' is not in POSIX sh but is implemented by FreeBSD /bin/sh (sh(1),
#   "local"); seance targets FreeBSD sh and nothing else (handoff §5).
set -u

# ---------------------------------------------------------------------------
# THE PATH, PINNED BEFORE ANYTHING EXTERNAL RUNS (D-171)
#
# THE DEFECT, measured on a real three-node cluster with truss(1). The module's
# CBSD verb wrapper runs under cbsdsh, and CBSD puts ${workdir}/modules FIRST
# in PATH -- that directory IS its dispatch mechanism (cbsd.conf:119), and it
# plants a verb there for every module the node has enabled. One of them is
# named `ssh`. So every bare `ssh` this dispatcher issued from wrapper context
# execve'd ${workdir}/modules/ssh, CBSD's verb, and not ssh(1): `seance verify`
# FAILED every mesh probe while the identical command typed by hand succeeded.
#
# THE CLASS, not the instance. `ssh` is the name that bit, and nothing makes it
# special: seance also runs zfs, zpool, timeout, daemon, lockf, logger, ping,
# awk, sed, cut, cat, cp, rm, mkdir, find, realpath, ps, id, mktemp, patch,
# printf and column, and a platform that front-loads a dispatch directory can
# shadow any of them at any release. The fix is therefore not "call ssh by
# absolute path" but "nothing may precede the base system in seance's PATH".
#
# THE VALUE, argued. The six directories below are FreeBSD's own base and
# package binary directories in the order the system itself uses them
# (hier(7); /etc/login.conf's default path is the same list). Every command
# seance runs bare lives in one of them: base utilities in /sbin /bin
# /usr/sbin /usr/bin, and the packages a node must have for seance to work --
# ssh(1) is base, and the rest arrive with CBSD -- in /usr/local/sbin and
# /usr/local/bin.
#
# THE CALLER'S PATH IS KEPT, AFTER THEM, and that is deliberate rather than
# lazy. Two things seance runs are the SITE's and are documented to be found on
# PATH: a fence driver it does not ship (`fence_<driver>`, lib/promote.subr,
# promote_fence_exe -- the module's own drivers/ directory is searched first, so
# a shipped driver still cannot be shadowed) and `notify_cmd`. A site that
# installs those in a directory of its own is not this dispatcher's to break.
# Putting the base directories in front is the whole fix: after it, no earlier
# directory exists to shadow anything, and the tail can only answer for names
# the base system does not have.
#
# DEDUPLICATED, so that re-entry is idempotent: `repl` re-executes this
# dispatcher once per guest-peer pair and `promote` re-enters it once under
# lockf(1), and a pin that prepended six directories at every level would grow
# the environment for as long as the recursion lasted.
#
# FIRST, before `realpath` below: this file's very first external command is
# itself a name that can be shadowed.
#
# The platform verb is NOT found through PATH and is unaffected: `adapter_fact
# verb` answers with an absolute command (D-117, D-163), which is what cron,
# devd and the detached promotion are all given.
_seance_path="/sbin:/bin:/usr/sbin:/usr/bin:/usr/local/sbin:/usr/local/bin"
_seance_rest=${PATH:-}
while [ -n "${_seance_rest}" ]; do
    _seance_dir=${_seance_rest%%:*}
    case "${_seance_rest}" in
        *:*) _seance_rest=${_seance_rest#*:} ;;
        *)   _seance_rest="" ;;
    esac

    [ -n "${_seance_dir}" ] || continue
    case ":${_seance_path}:" in
        *":${_seance_dir}:"*) continue ;;
    esac

    _seance_path="${_seance_path}:${_seance_dir}"
done
PATH=${_seance_path}
export PATH
unset _seance_path _seance_rest _seance_dir

# Resolve through symlinks: ${workdir}/modules/seance points at the module
# directory, and lib/ and VERSION are siblings of bin/.
_self=$( realpath "$0" ) || exit 1
_bindir=${_self%/*}
SEANCE_ROOT=${_bindir%/*}
readonly SEANCE_ROOT

# shellcheck source-path=SCRIPTDIR
# shellcheck source=../lib/common.subr
. "${SEANCE_ROOT}/lib/common.subr"
# shellcheck source-path=SCRIPTDIR
# shellcheck source=../lib/policy.subr
. "${SEANCE_ROOT}/lib/policy.subr"
# shellcheck source-path=SCRIPTDIR
# shellcheck source=../lib/conf.subr
. "${SEANCE_ROOT}/lib/conf.subr"
# shellcheck source-path=SCRIPTDIR
# shellcheck source=../lib/transport.subr
. "${SEANCE_ROOT}/lib/transport.subr"
# shellcheck source-path=SCRIPTDIR
# shellcheck source=../lib/notify.subr
. "${SEANCE_ROOT}/lib/notify.subr"
# shellcheck source-path=SCRIPTDIR
# shellcheck source=../lib/zfs.subr
. "${SEANCE_ROOT}/lib/zfs.subr"
# shellcheck source-path=SCRIPTDIR
# shellcheck source=../lib/lineage.subr
. "${SEANCE_ROOT}/lib/lineage.subr"
# shellcheck source-path=SCRIPTDIR
# shellcheck source=../lib/repl.subr
. "${SEANCE_ROOT}/lib/repl.subr"
# shellcheck source-path=SCRIPTDIR
# shellcheck source=../lib/status.subr
. "${SEANCE_ROOT}/lib/status.subr"
# shellcheck source-path=SCRIPTDIR
# shellcheck source=../lib/carp.subr
. "${SEANCE_ROOT}/lib/carp.subr"
# shellcheck source-path=SCRIPTDIR
# shellcheck source=../lib/carp_repair.subr
. "${SEANCE_ROOT}/lib/carp_repair.subr"
# shellcheck source-path=SCRIPTDIR
# shellcheck source=../lib/verify.subr
. "${SEANCE_ROOT}/lib/verify.subr"
# shellcheck source-path=SCRIPTDIR
# shellcheck source=../lib/gate.subr
. "${SEANCE_ROOT}/lib/gate.subr"
# shellcheck source-path=SCRIPTDIR
# shellcheck source=../lib/promote.subr
. "${SEANCE_ROOT}/lib/promote.subr"
# shellcheck source-path=SCRIPTDIR
# shellcheck source=../lib/failback.subr
. "${SEANCE_ROOT}/lib/failback.subr"
# shellcheck source-path=SCRIPTDIR
# shellcheck source=../lib/setup.subr
. "${SEANCE_ROOT}/lib/setup.subr"

# The adapter: everything that knows what a guest is on this host. One file,
# selected by $SEANCE_ADAPTER so that the pseudo-cluster and the conformance
# suite can put a different one in its place (D-3) -- the seam is the point of
# the design (§2), and a seam only one implementation can pass is not a seam.
#
# Sourced when present, and only then: version, help and config are answerable
# on a workstation with no adapter at all, and a dispatcher that could not
# print its own version without CBSD would be a dispatcher the cheap test tiers
# could not drive. adapter_init is NOT called here -- see seance_adapter_init.
#
# Exported, not merely set: `repl` re-executes this dispatcher once per
# guest-peer pair under lockf(1) (D-62), and a child that resolved a different
# adapter from its parent would be a seam with two sides.
SEANCE_ADAPTER=${SEANCE_ADAPTER:-${SEANCE_ROOT}/lib/adapter.subr}
export SEANCE_ADAPTER
if [ -r "${SEANCE_ADAPTER}" ]; then
    # shellcheck disable=SC1090
    #   The adapter's path is chosen at run time by design; there is no
    #   constant path for shellcheck to follow.
    . "${SEANCE_ADAPTER}"
fi

# seance_adapter_init
#
# Bring the adapter up, once, for the verbs that need it. Separate from the
# sourcing above because adapter_init talks to the host -- it finds CBSD's
# workdir and node name -- and a verb that does not need the host must not fail
# on a machine that has none.
seance_adapter_init()
{
    command -v adapter_node_self > /dev/null 2>&1 ||
        seance_die 2 "no adapter at ${SEANCE_ADAPTER}: this verb needs one"

    if command -v adapter_init > /dev/null 2>&1; then
        adapter_init || seance_die 2 "the adapter at ${SEANCE_ADAPTER} could not initialise"
    fi
}

seance_usage()
{
    cat <<EOF
usage: seance <verb> [args]

Verbs:
  repl [--guest <g>] [--peer <p>] [--dry-run] [--now]
                     run one replication tick: snapshot, send, prune, record.
                     --locked is internal: it is how a tick re-enters itself
                     under lockf(1) for one pair, and takes no snapshot
  status [--tsv]     the one screen: guests, replica freshness, mesh health
  verify [--render cron|carp|devd]
                     render the configuration seance expects and diff it
                     against reality; never writes anything
  promote <deadnode> [--auto] [--force[=<rung>,...]] [--guest <g>]
                     walk the succession ladder for a dead node's estate.
                     Forceable rungs: quorum, fence, lineage, kernel.
                     --auto is the devd path: rungs 1-4 must all be green,
                     and --force may not be combined with it.
                     One ladder per dead node per host: a promotion runs under
                     lockf(1) and a second one exits 75 saying who holds it,
                     --force included. --locked is internal: it is how the
                     devd path says its own lockf(1) already holds that lock
  promote-event <vhid>@<ifname>
                     internal: what a devd(8) CARP rule runs. Maps the vhid
                     to a node and either detaches "promote <node> --auto"
                     or notifies. Bounded: devd waits for it.
  failback <guest> [--discard-origin-writes]
                     bring a guest home; run this on the guest's home node
  failback-assist <guest> <stop|start|snapshot|unregister|release>
                     internal: the interim host's half of a failback
  gate [--check] [--release <guest>]
                     the resurrection gate: withhold any guest a living peer
                     still claims, and the whole estate if none answers
  placement [--remote]
                     print which guests this node hosts away from home;
                     --remote gathers the same from the living peers
  config [--check] [--file <path>]
                     print the effective configuration; --check validates it
                     and prints one line per problem
  setup [--non-interactive] [--set key=value]... [--out <file>]
        [--from <file>] [--answers <file>] [--dump-answers <file>]
        [--allow-invalid]
                     an interactive (bsddialog) or headless editor for the
                     config file. It only ever writes the target file; every
                     screen has a --set equivalent
  carp-repair [--check | --fix | --boot]
                     reconcile a STALE CARP demotion so a rebooted node
                     reclaims its own vhid; refuses a demotion that is TRUE
                     (a down vhid interface). --boot waits for the network to
                     settle, then fixes, logging to syslog -- it is what
                     rc.d/seance_carp_reconcile runs at boot. Needs root
  version            print the seance version
  help, --help, -h   print this usage

The configuration file is \$SEANCE_CONF if set, otherwise
\$SEANCE_CBSD_WORKDIR/etc/seance.conf, otherwise --file must say.

Exit codes: 0 ok, 1 operation failed, 2 usage or contract error. \`promote\`
adds 75 (EX_TEMPFAIL): another promotion of that node owns this host's lock.
EOF
}

# seance_load_conf
#
# Find, parse and validate the configuration for a verb that acts on the
# fleet. An invalid configuration is exit 2 and no action: a tick that ran on
# the defaults a typo hid is worse than a tick that did not run (D-34).
seance_load_conf()
{
    local _file

    _file=$( seance_conf_path ) ||
        seance_die 2 "no config file: set SEANCE_CONF, or run under CBSD"

    conf_load "${_file}" || exit 2

    conf_check > /dev/null || {
        conf_check >&2
        seance_die 2 "the configuration is invalid; nothing will run on it"
    }
}

# seance_repl [--guest <g>] [--peer <p>] [--dry-run] [--now] [--locked]
#
# --now      ignore the per-guest cadence gate and tick regardless. cron does
#            not pass it; an operator who wants a tick this minute does.
# --locked   internal: this invocation already holds the pair's lock and must
#            do exactly the one pair it was given. repl re-executes itself
#            under lockf(1) for each pair (D-62), and this is how the child
#            knows not to snapshot or to recurse.
seance_repl()
{
    local _guest _peer _dry _now _locked

    _guest=""
    _peer=""
    _dry=0
    _now=0
    _locked=0

    while [ $# -gt 0 ]; do
        case "$1" in
            --guest)
                [ $# -ge 2 ] || seance_die 2 "repl: --guest needs a guest name"
                _guest=$2
                shift
                ;;
            --guest=*) _guest=${1#--guest=} ;;
            --peer)
                [ $# -ge 2 ] || seance_die 2 "repl: --peer needs a node key"
                _peer=$2
                shift
                ;;
            --peer=*) _peer=${1#--peer=} ;;
            --dry-run) _dry=1 ;;
            --now) _now=1 ;;
            --locked) _locked=1 ;;
            *) seance_die 2 "repl: unknown argument: $1" ;;
        esac
        shift
    done

    seance_load_conf
    seance_adapter_init
    seance_tmp_init

    repl_tick "${_guest}" "${_peer}" "${_dry}" "${_now}" "${_locked}"
}

# seance_status [--tsv]
seance_status()
{
    local _tsv

    _tsv=0

    while [ $# -gt 0 ]; do
        case "$1" in
            --tsv) _tsv=1 ;;
            *) seance_die 2 "status: unknown argument: $1" ;;
        esac
        shift
    done

    seance_load_conf
    seance_adapter_init
    seance_tmp_init

    status_report "${_tsv}"
}

# seance_verify [--render <what>]
#
# EVERY rendering needs the adapter. `--render carp` and `--render devd` need
# this node's identity -- which vhids it carries depends on which node it IS.
# `--render cron` needs the platform's own verb: the line names the command
# cron will run with no environment at all, and only the platform can say what
# that command is (D-117; and repl_cron_line's header for the fresh install
# this cost). It used to be answerable on a workstation, which is what let it
# render a command that cannot run.
seance_verify()
{
    local _render

    _render=""

    while [ $# -gt 0 ]; do
        case "$1" in
            --render)
                [ $# -ge 2 ] ||
                    seance_die 2 "verify: --render needs a subject (${VERIFY_RENDERS})"
                _render=$2
                shift
                ;;
            --render=*) _render=${1#--render=} ;;
            *) seance_die 2 "verify: unknown argument: $1" ;;
        esac
        shift
    done

    seance_load_conf

    if [ -n "${_render}" ]; then
        case "${_render}" in
            cron|carp|devd)
                seance_adapter_init
                seance_tmp_init
                ;;
        esac
        verify_render "${_render}"
        return $?
    fi

    seance_adapter_init
    seance_tmp_init

    verify_report
}

# seance_promote <deadnode> [--auto] [--force[=rung,...]] [--guest <g>]
#                [--locked]
#
# The succession ladder (lib/promote.subr). --force names the rungs it skips
# and every skipped rung says so in its own line, so "force skips exactly the
# rungs it names" is readable in the log rather than promised in a comment.
#
# --locked  internal: this invocation's caller already holds the corpse's lock
#           and this one must not take it again. It is how the devd path's own
#           lockf(1) wrapper says so (lib/promote.subr, promote_event), and it
#           is the same flag `repl` uses for the same reason (D-62).
seance_promote()
{
    local _dead _guest _forced _locked _lock _rundir

    _dead=""
    _guest=""
    _forced=0
    _locked=0
    PROMOTE_FORCE=""
    PROMOTE_AUTO=0

    while [ $# -gt 0 ]; do
        case "$1" in
            --auto) PROMOTE_AUTO=1 ;;
            --locked) _locked=1 ;;
            --force)
                promote_parse_force "" || exit 2
                _forced=1
                ;;
            --force=*)
                promote_parse_force "${1#--force=}" || exit 2
                _forced=1
                ;;
            --guest)
                [ $# -ge 2 ] || seance_die 2 "promote: --guest needs a guest name"
                _guest=$2
                shift
                ;;
            --guest=*) _guest=${1#--guest=} ;;
            -*) seance_die 2 "promote: unknown argument: $1" ;;
            *)
                [ -z "${_dead}" ] ||
                    seance_die 2 "promote: more than one node named: ${_dead} and $1"
                _dead=$1
                ;;
        esac
        shift
    done

    [ -n "${_dead}" ] || seance_die 2 "promote: which node died? usage: seance promote <node>"
    [ "${_forced}" -eq 1 ] || PROMOTE_FORCE=""

    # Refused here as well as inside promote_run: this is the usage error an
    # operator makes, and it must be answered before a configuration is loaded
    # or an adapter is started rather than four rungs later.
    if [ "${PROMOTE_AUTO}" -eq 1 ] && [ "${_forced}" -eq 1 ]; then
        seance_die 2 "promote: --force may not be combined with --auto:" \
            "a force is a human accepting a rung that could not answer, and --auto" \
            "is a run with no human in it"
    fi

    # ONE LADDER PER CORPSE, ON THIS NODE, WHOEVER STARTED IT (D-155 completed).
    #
    # The devd path has run its detached ladder under
    # `lockf -s -t 0 -p <run-dir>/lock/promote.<dead>` since D-155, and the
    # manual verb did not, which left two ladders one typed command apart: a
    # human promoting a node devd is already promoting, or two humans on one
    # node's two terminals. Both walk the same estate, both mount, register and
    # start it, and neither notices the other -- the hazard D-155 measured for
    # devd's own flapping events, reached by hand instead.
    #
    # It is taken by re-entering the dispatcher under lockf(1) rather than by
    # writing a marker: that is repl's discipline for its per-pair locks (D-62)
    # and D-105's reasoning for this one -- the lock is released when its
    # holder dies, which is the property no marker file has.
    #
    # --force DOES NOT BYPASS IT. A force is a human accepting a rung that
    # could not answer; it is not a licence to run a second ladder over the top
    # of one that is already mounting an estate.
    #
    # AND THE LOCK IS THIS NODE'S. Two nodes promoting one corpse is what rung
    # 2's quorum and rung 4's fence are for; a file lock cannot say anything
    # about another machine, and this one does not pretend to -- exactly as the
    # devd path's lock does not (D-155).
    if [ "${_locked}" -eq 0 ]; then
        if ! _lock=$( promote_lock_path "${_dead}" ); then
            _rundir=$( seance_run_dir 2>/dev/null ) || _rundir=""
            printf 'promote: this node cannot say where its locks live (run directory: %s), so it cannot promise that only one ladder is walking %s'"'"'s estate.\n' \
                "${_rundir:-unset}" "${_dead}"
            promote_note "Set SEANCE_RUN_DIR, or run this verb through the platform's own seance verb, which exports the workdir (D-3)."
            printf 'promote: NOTHING WAS PROMOTED: there is nowhere to take the lock that keeps two promotions of %s apart\n' \
                "${_dead}"
            exit 1
        fi

        # Rebuilt rather than forwarded: the parsed state IS the argument
        # vector, and --force= naming every rung it parsed says the same thing
        # as the bare --force that produced it (promote_parse_force). The child
        # validates it all again, from scratch.
        set -- promote "${_dead}" --locked
        [ "${PROMOTE_AUTO}" -eq 1 ] && set -- "$@" --auto
        [ "${_forced}" -eq 1 ] &&
            set -- "$@" "--force=$( printf '%s\n' "${PROMOTE_FORCE}" | tr ' ' ',' )"
        [ -n "${_guest}" ] && set -- "$@" --guest "${_guest}"

        promote_lock_run "${_dead}" "${_lock}" "${SEANCE_ROOT}/bin/seance" "$@"
        exit $?
    fi

    seance_load_conf
    seance_adapter_init
    seance_tmp_init

    promote_run "${_dead}" "${_guest}"
}

# seance_promote_event <vhid@ifname>
#
# The devd(8) target (lib/promote.subr, promote_event). Not a verb an operator
# reaches for: devd runs it, once per CARP MASTER transition, and waits for it.
seance_promote_event()
{
    [ $# -eq 1 ] ||
        seance_die 2 "promote-event: usage: seance promote-event <vhid>@<ifname>"

    seance_load_conf
    seance_adapter_init
    seance_tmp_init

    promote_event "$1"
}

# seance_failback <guest> [--discard-origin-writes]
seance_failback()
{
    local _guest _discard

    _guest=""
    _discard=0

    while [ $# -gt 0 ]; do
        case "$1" in
            --discard-origin-writes) _discard=1 ;;
            -*) seance_die 2 "failback: unknown argument: $1" ;;
            *)
                [ -z "${_guest}" ] ||
                    seance_die 2 "failback: more than one guest named: ${_guest} and $1"
                _guest=$1
                ;;
        esac
        shift
    done

    [ -n "${_guest}" ] ||
        seance_die 2 "failback: which guest? usage: seance failback <guest>"

    seance_load_conf
    seance_adapter_init
    seance_tmp_init

    failback_run "${_guest}" "${_discard}"
}

# seance_failback_assist <guest> <op>
#
# INTERNAL. The interim host's half of a failback, invoked over the mesh by the
# origin. Documented because an operator finishing a half-failed failback by
# hand needs it, not because anybody should reach for it otherwise.
seance_failback_assist()
{
    [ $# -eq 2 ] ||
        seance_die 2 "failback-assist: usage: seance failback-assist <guest> <stop|start|snapshot|unregister|release>"

    seance_load_conf
    seance_adapter_init
    seance_tmp_init

    failback_assist "$1" "$2"
}

# seance_gate [--check] [--release <guest>]
seance_gate()
{
    local _mode

    _mode=act

    while [ $# -gt 0 ]; do
        case "$1" in
            --check) _mode=check ;;
            --release)
                [ $# -ge 2 ] || seance_die 2 "gate: --release needs a guest name"
                _mode="release:$2"
                shift
                ;;
            --release=*) _mode="release:${1#--release=}" ;;
            *) seance_die 2 "gate: unknown argument: $1" ;;
        esac
        shift
    done

    seance_load_conf
    seance_adapter_init
    seance_tmp_init

    gate_run "${_mode}"
}

# seance_placement [--remote]
seance_placement()
{
    local _remote

    _remote=0

    while [ $# -gt 0 ]; do
        case "$1" in
            --remote) _remote=1 ;;
            *) seance_die 2 "placement: unknown argument: $1" ;;
        esac
        shift
    done

    seance_load_conf
    seance_tmp_init

    # The LOCAL answer deliberately needs no adapter: this is the verb every
    # peer runs over ssh to answer "are you holding one of mine", and a node
    # whose CBSD is not up must still be able to say so. --remote needs to know
    # which node it is, which is the adapter's fact.
    [ "${_remote}" -eq 1 ] && seance_adapter_init

    placement_report "${_remote}"
}

# seance_setup [--non-interactive] [--set key=value]... [--out <file>]
#              [--from <file>] [--answers <file>] [--dump-answers <file>]
#              [--allow-invalid]
#
# lib/setup.subr's entry point. Needs no adapter and no existing configuration
# -- this is how a first configuration comes to exist -- so it is the one
# fleet-facing verb that does not call seance_load_conf.
seance_setup()
{
    local _out _from _answers _dump _allow _noninter

    _out=""
    _from=""
    _answers=""
    _dump=""
    _allow=0
    _noninter=0
    SETUP_SETS=""

    while [ $# -gt 0 ]; do
        case "$1" in
            --non-interactive) _noninter=1 ;;
            --set)
                [ $# -ge 2 ] || seance_die 2 "setup: --set needs key=value"
                SETUP_SETS="${SETUP_SETS}${SETUP_NL}$2"
                shift
                ;;
            --set=*) SETUP_SETS="${SETUP_SETS}${SETUP_NL}${1#--set=}" ;;
            --out)
                [ $# -ge 2 ] || seance_die 2 "setup: --out needs a path"
                _out=$2
                shift
                ;;
            --out=*) _out=${1#--out=} ;;
            --from)
                [ $# -ge 2 ] || seance_die 2 "setup: --from needs a path"
                _from=$2
                shift
                ;;
            --from=*) _from=${1#--from=} ;;
            --answers)
                [ $# -ge 2 ] || seance_die 2 "setup: --answers needs a path"
                _answers=$2
                shift
                ;;
            --answers=*) _answers=${1#--answers=} ;;
            --dump-answers)
                [ $# -ge 2 ] || seance_die 2 "setup: --dump-answers needs a path"
                _dump=$2
                shift
                ;;
            --dump-answers=*) _dump=${1#--dump-answers=} ;;
            --allow-invalid) _allow=1 ;;
            *) seance_die 2 "setup: unknown argument: $1" ;;
        esac
        shift
    done

    SETUP_NONINTERACTIVE=${_noninter}
    SETUP_OUT=${_out}
    SETUP_FROM=${_from}
    SETUP_ANSWERS_FILE=${_answers}
    SETUP_DUMP_ANSWERS=${_dump}
    SETUP_ALLOW_INVALID=${_allow}

    seance_tmp_init

    setup_run
}

# seance_version
#
# Print "seance <version>" and nothing else -- this verb is data, not a report,
# so that `seance version` is usable inside a shell substitution. It takes no
# arguments, and says so rather than ignoring them: a verb that accepts an
# argument it does not implement is a verb that will one day be given
# `--tsv` by somebody who then believes the output is TSV.
seance_version()
{
    local _v

    [ $# -eq 0 ] || seance_die 2 "version: takes no arguments (got: $*)"

    [ -r "${SEANCE_ROOT}/VERSION" ] ||
        seance_die 1 "no readable VERSION file at ${SEANCE_ROOT}/VERSION"

    # read(1) returns non-zero on a final line without a newline yet still
    # assigns, so emptiness is the verdict here, not read's exit status.
    _v=""
    read -r _v < "${SEANCE_ROOT}/VERSION"

    [ -n "${_v}" ] ||
        seance_die 1 "empty VERSION file at ${SEANCE_ROOT}/VERSION"

    echo "seance ${_v}"
}

# seance_conf_path
#
# Print the configuration file this node uses, per decision D-3: SEANCE_CONF
# wins (it is how the test tiers and the pseudo-cluster point seance at a file
# of their own), then the workdir CBSD told the wrapper about. rc 1 when
# neither is available, because guessing a path is how a node ends up running
# on a config nobody edited.
seance_conf_path()
{
    if [ -n "${SEANCE_CONF:-}" ]; then
        printf '%s\n' "${SEANCE_CONF}"
        return 0
    fi

    if [ -n "${SEANCE_CBSD_WORKDIR:-}" ]; then
        printf '%s\n' "${SEANCE_CBSD_WORKDIR}/etc/seance.conf"
        return 0
    fi

    return 1
}

# seance_config [--check] [--file <path>]
#
# Without --check: the effective configuration, then the validation verdict
# line -- so that a config which cannot be trusted says so on the same screen
# that shows what it currently means. The problem list is left to --check,
# which is where an operator goes to fix it.
#
# Exit status is the verdict: 0 valid, 1 loaded but invalid, 2 could not be
# parsed or was never found.
seance_config()
{
    local _check _file _rc

    _check=0
    _file=""

    while [ $# -gt 0 ]; do
        case "$1" in
            --check)
                _check=1
                ;;
            --file)
                [ $# -ge 2 ] || seance_die 2 "config: --file needs a path"
                _file=$2
                shift
                ;;
            --file=*)
                _file=${1#--file=}
                ;;
            *)
                seance_die 2 "config: unknown argument: $1"
                ;;
        esac
        shift
    done

    if [ -z "${_file}" ]; then
        _file=$( seance_conf_path ) ||
            seance_die 2 "config: no config file: set SEANCE_CONF, or run under CBSD, or pass --file"
    fi

    conf_load "${_file}" || exit 2

    if [ "${_check}" -eq 1 ]; then
        conf_check
        return $?
    fi

    conf_dump

    conf_check > /dev/null
    _rc=$?

    if [ "${_rc}" -eq 0 ]; then
        printf 'PASS\n'
    else
        printf 'FAIL: %d problems (run "seance config --check" for the list)\n' \
            "${CONF_PROBLEM_COUNT}"
    fi

    return "${_rc}"
}

# seance_carp_repair [--check | --fix | --boot]
#
# The one verb that touches live CARP state (lib/carp_repair.subr): it resets a
# STALE demotion so a rebooted node reclaims its own vhid, and refuses a demotion
# that is TRUE. --boot waits for the network to settle and routes its verdict to
# syslog, which is what rc.d/seance_carp_reconcile runs. Needs the host and root;
# needs neither the adapter nor the config.
seance_carp_repair()
{
    local _mode _out _rc _line

    _mode=check
    while [ $# -gt 0 ]; do
        case "$1" in
            --check) _mode=check ;;
            --fix)   _mode=fix ;;
            --boot)  _mode=boot ;;
            *) seance_die 2 "carp-repair: unknown argument: $1 (usage: seance carp-repair [--check | --fix | --boot])" ;;
        esac
        shift
    done

    [ "$( id -u )" -eq 0 ] || seance_die 2 "carp-repair: must run as root"

    if [ "${_mode}" = "boot" ]; then
        _out=$( carp_repair_run boot 2>&1 )
        _rc=$?
        printf '%s\n' "${_out}" | while IFS= read -r _line; do
            [ -n "${_line}" ] && logger -t seance -p daemon.notice "${_line}"
        done
        printf '%s\n' "${_out}"
        return "${_rc}"
    fi

    carp_repair_run "${_mode}"
}

if [ $# -eq 0 ]; then
    seance_usage >&2
    exit 2
fi

_verb=$1
shift

case "${_verb}" in
    repl)
        seance_repl "$@"
        exit $?
        ;;
    status)
        seance_status "$@"
        exit $?
        ;;
    verify)
        seance_verify "$@"
        exit $?
        ;;
    promote)
        seance_promote "$@"
        exit $?
        ;;
    promote-event)
        seance_promote_event "$@"
        exit $?
        ;;
    failback)
        seance_failback "$@"
        exit $?
        ;;
    failback-assist)
        seance_failback_assist "$@"
        exit $?
        ;;
    gate)
        seance_gate "$@"
        exit $?
        ;;
    placement)
        seance_placement "$@"
        exit $?
        ;;
    config)
        seance_config "$@"
        exit $?
        ;;
    setup)
        seance_setup "$@"
        exit $?
        ;;
    carp-repair)
        seance_carp_repair "$@"
        exit $?
        ;;
    version)
        seance_version "$@"
        ;;
    help|--help|-h)
        seance_usage
        ;;
    *)
        echo "seance: unknown verb: ${_verb}" >&2
        seance_usage >&2
        exit 2
        ;;
esac

exit 0
