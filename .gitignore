# seance .gitignore
#
# seance is pure sh: no build products, no dependency trees. What follows is
# noise from operating systems and editors, plus the few things this project's
# own tooling drops into the tree.

### Operating systems ###

# FreeBSD
*.core
.snap/
.sujournal

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
.fseventsd
.TemporaryItems
.VolumeIcon.icns

# Windows
Thumbs.db
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.lnk
*.stackdump

# Linux desktops / NFS
.directory
.Trash-*
.nfs*
.fuse_hidden*

### Editors ###

# Emacs
\#*\#
.\#*
*~
.projectile
.dir-locals-2.el
TAGS
.tags

# Vim
[._]*.s[a-v][a-z]
[._]*.sw[a-p]
[._]s[a-rt-v][a-z]
[._]ss[a-gi-z]
[._]sw[a-p]
Session.vim
Sessionx.vim
.netrwhist
tags
tags.lock
tags.temp

# VS Code / VSCodium
.vscode/
*.code-workspace
.history/

# JetBrains
.idea/
*.iml
*.iws
*.ipr

# Sublime Text
*.sublime-workspace
*.sublime-project

# Kate / KDevelop
*.kate-swp
.kateconfig
.kdev4/
*.kdev4

# nano, joe, mcedit
*.save
*.save.*
DEADJOE
*.mcedit

# ctags / cscope / GNU global
cscope.files
cscope.in.out
cscope.out
cscope.po.out
GPATH
GRTAGS
GTAGS

### Project tooling ###

# reaper pulls session results into out/ at the tree root
/out/

# direnv, local shell hooks
.direnv/
.envrc

# Claude Code local (per-machine) settings
.claude/settings.local.json

# A real site config or credential file must never be committed; only the
# committed sample (etc/seance.conf.sample) is source.
/etc/seance.conf
*.passfile
*.secret

# Test scratch and generic temp/backups
/tests/**/tmp/
*.tmp
*.bak
*.orig
*.rej
nohup.out

# Deliberately NOT ignored: *.patch (the rediscovery battery ships patches)
# and *.log in general (fixtures may be logs).
