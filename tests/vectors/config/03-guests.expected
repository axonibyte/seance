fleet set cadence 900
fleet default retention_recent 14400
fleet default retention_hourly 172800
fleet derived staleness_max 2700
fleet default skew_tolerance 120
fleet default debounce 45
fleet default fence_timeout 60
fleet default ssh_user root
fleet default ssh_port 22
fleet unset ssh_extra_opts
fleet runtime standby_root
fleet unset notify_cmd
fleet unset witness
node alpha nodename alpha.example.net
node alpha mgmt alpha-mgmt.example.net
node alpha heir bravo
node alpha heir2 charlie
node bravo nodename bravo.example.net
node bravo mgmt bravo-mgmt.example.net
node bravo heir charlie
node bravo heir2 alpha
node charlie nodename charlie.example.net
node charlie mgmt charlie-mgmt.example.net
node charlie heir alpha
node charlie heir2 bravo
guest db01 override cadence 300
guest db01 inherited staleness_max 900
guest db01 unset heir
guest db01 unset heir2
guest bulk01 override cadence 3600
guest bulk01 override staleness_max 14400
guest bulk01 unset heir
guest bulk01 unset heir2
guest web01 inherited cadence 900
guest web01 inherited staleness_max 2700
guest web01 override heir charlie
guest web01 override heir2 bravo
