fleet default cadence 900
fleet default retention_recent 14400
fleet default retention_hourly 172800
fleet derived staleness_max 2700
fleet default skew_tolerance 120
fleet default debounce 45
fleet default fence_timeout 60
fleet default ssh_user root
fleet default ssh_port 22
fleet unset ssh_extra_opts
fleet runtime standby_root
fleet unset notify_cmd
fleet set witness witness.example.net
fleet unset carp_interface
fleet unset carp_pass
fleet default auto 0
node alpha nodename alpha.example.net
node alpha mgmt alpha-mgmt.example.net
node alpha heir bravo
node bravo nodename bravo.example.net
node bravo mgmt bravo-mgmt.example.net
node bravo heir alpha
