# seance -- the shape-A pseudo-cluster adapter.
#
# Sourced by bin/seance through $SEANCE_ADAPTER when seance runs inside a
# pseudo-cluster node (TESTING.md §1, shape A). It implements the same function
# set as lib/adapter.subr, with the same contracts, and it is the reason tiers
# 6 and 7 can drive the real verbs: everything the replication engine and the
# policy engine actually touch -- datasets, snapshots, sends, ssh, CARP -- is
# real here. Only the guest LIFECYCLE is imaginary: a guest is a record in a
# file and a dataset tree, not a process.
#
# That is the honest boundary. A jail inside a vnet jail is not a guest, and
# pretending otherwise would make the expensive tier test the pretence. What
# the pseudo-cluster is for is the parts of seance that a fake CBSD cannot fake
# away, and every one of those is real below.
#
# Layout, per node:
#
#   <root>                       the node's delegated dataset, mounted /seance
#   <root>/<guest>               one guest's dataset root, LOCAL mountpoint
#                                (CBSD sets one at creation --
#                                sudoexec/mkdatadir:14-23 -- and the shadow-
#                                mount law is only tested if the source has one)
#   <root>/<guest>/sys           the guest's config directory, a dataset child
#                                so that it travels with replication the way
#                                jails-system/<name>/ does
#   <root>/standby               where other nodes' replicas land
#   /var/db/seance-pseudo/guests.tsv    the guest records
#
# Records are "<name> <type> <astart> <home> <running> <held> <data>", tab
# separated; <data> is where the guest's registration says its data lives and is
# empty for a guest that lives where this node puts its own.
#
# shellcheck shell=sh
# shellcheck disable=SC3043
#   'local' is not in POSIX sh but is implemented by FreeBSD /bin/sh (sh(1),
#   "local"); seance targets FreeBSD sh and nothing else (handoff §5).

PSEUDO_DIR=${SEANCE_PSEUDO_DIR:-/var/db/seance-pseudo}
PSEUDO_DB="${PSEUDO_DIR}/guests.tsv"
PSEUDO_MOUNT=${SEANCE_PSEUDO_MOUNT:-/seance}
PSEUDO_ROOT=""

# How a pseudo-cluster node is asked to run a seance verb: the wrapper the
# estate fixture puts on PATH, which is the same one a peer reaches over ssh.
PSEUDO_VERB=${SEANCE_PSEUDO_VERB:-/usr/local/bin/seance}

PSEUDO_TAB=$( printf '\t.' )
PSEUDO_TAB=${PSEUDO_TAB%.}

# pseudo_diag <message...>  -- diagnostics, to stderr, as the contract requires.
pseudo_diag()
{
    printf 'adapter-pseudo: %s\n' "$*" >&2
}

# pseudo_root  -- the node's delegated dataset.
#
# From $SEANCE_PSEUDO_ROOT when the stage says so, otherwise from the mount
# table: whatever is mounted at /seance inside this node. Derived rather than
# configured because the node's dataset name is a fact about the substrate, not
# a seance setting.
pseudo_root()
{
    local _r

    if [ -n "${PSEUDO_ROOT}" ]; then
        printf '%s\n' "${PSEUDO_ROOT}"
        return 0
    fi

    if [ -n "${SEANCE_PSEUDO_ROOT:-}" ]; then
        PSEUDO_ROOT=${SEANCE_PSEUDO_ROOT}
        printf '%s\n' "${PSEUDO_ROOT}"
        return 0
    fi

    _r=$( mount -p | awk -v m="${PSEUDO_MOUNT}" '$2 == m { print $1; exit }' )
    [ -n "${_r}" ] || return 1

    PSEUDO_ROOT=${_r}
    printf '%s\n' "${PSEUDO_ROOT}"
}

# pseudo_name_ok <name>  -- the guest-name rule, applied on the way in.
#
# [a-z0-9][a-z0-9._-]* -- CBSD's own jail names are of this shape, and a name
# outside it cannot appear in a tab-separated record or a dataset name without
# a quoting story the adapter contract does not have (handoff §2.3).
pseudo_name_ok()
{
    case "${1:-}" in
        ''|[!abcdefghijklmnopqrstuvwxyz0123456789]*) return 1 ;;
        *[!abcdefghijklmnopqrstuvwxyz0123456789._-]*) return 1 ;;
    esac

    return 0
}

# pseudo_field <name> <n>  -- the nth field of a guest's record, 1-based.
pseudo_field()
{
    [ -r "${PSEUDO_DB}" ] || return 1

    awk -F "${PSEUDO_TAB}" -v g="$1" -v n="$2" \
        '$1 == g { print $n; found = 1; exit } END { exit !found }' \
        "${PSEUDO_DB}"
}

# pseudo_set_field <name> <n> <value>  -- rewrite one field of one record.
pseudo_set_field()
{
    local _tmp

    [ -r "${PSEUDO_DB}" ] || return 1

    _tmp="${PSEUDO_DB}.new.$$"

    awk -F "${PSEUDO_TAB}" -v OFS="${PSEUDO_TAB}" \
        -v g="$1" -v n="$2" -v v="$3" \
        '$1 == g { $n = v; found = 1 } { print } END { exit !found }' \
        "${PSEUDO_DB}" > "${_tmp}" || { rm -f "${_tmp}"; return 1; }

    mv "${_tmp}" "${PSEUDO_DB}"
}

# ---------------------------------------------------------------------------
# The adapter contract
# ---------------------------------------------------------------------------

# contract: adapter_init() -> nothing [no output]
#
# Prepare the adapter for this process. rc 0 ready, 2 this host cannot host
# the adapter at all.
adapter_init()
{
    mkdir -p "${PSEUDO_DIR}" || {
        pseudo_diag "cannot create ${PSEUDO_DIR}"
        return 2
    }

    [ -e "${PSEUDO_DB}" ] || : > "${PSEUDO_DB}"

    pseudo_root > /dev/null || {
        pseudo_diag "no delegated dataset is mounted at ${PSEUDO_MOUNT};" \
            "set SEANCE_PSEUDO_ROOT"
        return 2
    }

    return 0
}

# contract: adapter_node_self() -> nodename [promises output]
#
# This node's name. rc 0 with output, 1 if it cannot be determined. Never
# empty with rc 0.
adapter_node_self()
{
    local _n

    _n=$( hostname -s 2>/dev/null ) || return 1
    [ -n "${_n}" ] || return 1

    printf '%s\n' "${_n}"
}

# contract: adapter_fact(key) -> value [promises output]
#
# The node facts, one at a time, by key: workdir, nodename, jailsysdir,
# jaildatadir, dbdir, etcdir, distdir, verb. rc 2 for an unknown key -- a
# typo'd fact must not read as an empty one.
#
# A pseudo-cluster node has no CBSD, so these are the jail-local equivalents of
# what CBSD would answer, and they are answered rather than refused because the
# seam is only a seam if every implementation can speak the whole of it:
#
#   workdir      the directory this adapter keeps its world in
#   jailsysdir   the parent of the guests' config directories -- a guest's own
#                is <jailsysdir>/<name>/sys, and adapter_guest_sysdir is the
#                accessor to use rather than that arithmetic
#   jaildatadir  the parent of the guests' data, which here is the same place
#   dbdir        this adapter's records
#   etcdir       where the node's configuration lives
#   distdir      the seance tree this node runs from
#   verb         how this node is asked to run a seance verb. On CBSD that is
#                the platform's own verb; here it is the wrapper the estate
#                fixture installs on PATH, which is the same wrapper a peer
#                reaches over ssh and the same one a devd rule would name.
adapter_fact()
{
    case "${1:-}" in
        workdir)     printf '%s\n' "${PSEUDO_DIR}" ;;
        nodename)    adapter_node_self ;;
        jailsysdir)  printf '%s\n' "${PSEUDO_MOUNT}" ;;
        jaildatadir) printf '%s\n' "${PSEUDO_MOUNT}" ;;
        dbdir)       printf '%s\n' "${PSEUDO_DIR}" ;;
        etcdir)      printf '%s\n' "/etc" ;;
        distdir)     printf '%s\n' "${SEANCE_ROOT:-/usr/local/seance}" ;;
        verb)        printf '%s\n' "${PSEUDO_VERB}" ;;
        *)
            pseudo_diag "adapter_fact: no such fact: [${1:-}]"
            return 2
            ;;
    esac

    return 0
}

# contract: adapter_guest_names_local() -> name-per-line [list: may be empty]
#
# The raw jnames of this node's guests, no status parsed -- the gate's D-191
# fail-safe. In the pseudo-cluster the DB is the tsv, so this is its first
# column for local guests.
adapter_guest_names_local()
{
    [ -r "${PSEUDO_DB}" ] || return 0
    awk -F "${PSEUDO_TAB}" -v self="$( adapter_node_self )" \
        'NF >= 6 { n = (NF >= 8 && $8 != "" && $8 != self) ? "" : $1; if (n != "") print n }' \
        "${PSEUDO_DB}" | sort -u
}

# contract: adapter_guest_list() -> name<TAB>type<TAB>astart<TAB>status<TAB>running [list: may be empty]
#
# One record per guest on this node. type is bhyve|jail, astart and running are
# 0|1, status is CBSD's status integer (0 master, 2 slave/held). No header. An
# empty list is a valid answer: rc 0 with no output means "no guests here", and
# this is one of the functions that does NOT promise output.
#
# A ROW THIS NODE DOES NOT HOST IS LISTED WITH AN EMPTY TYPE (D-184), because
# that is what a clustered platform does: CBSD's listing fills another node's
# row from replicated SQL that carries no emulator, and prints the field it
# could not fill as "0" or "-" (bhyvectl/bls:390-393). seance reads exactly
# that shape as "not local to this node" (D-177) and skips it. Until this
# fixture could produce such a row, no tier could reach the defect where a
# promotion registers an inherited configuration, the platform files the guest
# under the DEAD node's name, and seance then cannot see the guest it just
# promoted.
adapter_guest_list()
{
    [ -r "${PSEUDO_DB}" ] || return 0

    awk -F "${PSEUDO_TAB}" -v OFS="${PSEUDO_TAB}" -v self="$( adapter_node_self )" \
        'NF >= 6 {
            type = $2
            if (NF >= 8 && $8 != "" && $8 != self) type = "0"
            print $1, type, $3, ($6 == "1" ? 2 : 0), $5
        }' "${PSEUDO_DB}"
}

# contract: adapter_guest_type(name) -> bhyve|jail [promises output]
#
# rc 0 with output, 1 if there is no such guest, 2 for a name that is not one.
adapter_guest_type()
{
    local _t

    pseudo_name_ok "${1:-}" || { pseudo_diag "bad guest name: ${1:-}"; return 2; }

    _t=$( pseudo_field "$1" 2 ) || return 1
    [ -n "${_t}" ] || return 1

    printf '%s\n' "${_t}"
}

# contract: adapter_guest_running(name) -> 1|0 [promises output]
#
# rc 0 with output, 1 if there is no such guest, 2 for a name that is not one.
adapter_guest_running()
{
    local _r

    pseudo_name_ok "${1:-}" || { pseudo_diag "bad guest name: ${1:-}"; return 2; }

    _r=$( pseudo_field "$1" 5 ) || return 1

    if [ "${_r}" = "1" ]; then
        printf '1\n'
    else
        printf '0\n'
    fi
}

# contract: adapter_guest_start(name) -> nothing [no output]
#
# rc 0 started (or already running), 1 the start failed, 2 no such guest or a
# name that is not one.
adapter_guest_start()
{
    pseudo_name_ok "${1:-}" || { pseudo_diag "bad guest name: ${1:-}"; return 2; }

    pseudo_field "$1" 1 > /dev/null || { pseudo_diag "no such guest: $1"; return 2; }

    if [ "$( pseudo_field "$1" 6 )" = "1" ]; then
        pseudo_diag "$1 is held (slave mode); refusing to start it"
        return 1
    fi

    pseudo_set_field "$1" 5 1 || return 1
}

# contract: adapter_guest_stop(name) -> nothing [no output]
#
# rc 0 stopped (or already stopped), 1 the stop failed, 2 no such guest or a
# name that is not one.
adapter_guest_stop()
{
    pseudo_name_ok "${1:-}" || { pseudo_diag "bad guest name: ${1:-}"; return 2; }

    pseudo_field "$1" 1 > /dev/null || { pseudo_diag "no such guest: $1"; return 2; }

    pseudo_set_field "$1" 5 0 || return 1
}

# contract: adapter_guest_mountpoint(name,type) -> path [promises output]
#
# Where this platform expects a guest's root dataset to be mounted. Here that
# is ${PSEUDO_MOUNT}/<name> whatever the guest's type: a pseudo-node has no
# jails-data and no vm directory to tell apart, and inventing the distinction
# would be modelling CBSD's layout rather than this adapter's. rc 2 for a type
# no adapter supports, so that a typo cannot mount a replica somewhere nobody
# looks.
adapter_guest_mountpoint()
{
    pseudo_name_ok "${1:-}" || { pseudo_diag "bad guest name: ${1:-}"; return 2; }

    case "${2:-}" in
        jail|bhyve) ;;
        *) pseudo_diag "unsupported guest type: ${2:-}"; return 2 ;;
    esac

    printf '%s/%s\n' "${PSEUDO_MOUNT}" "$1"
}

# contract: adapter_guest_links(name,type,datapath) -> link<TAB>target per line [list: may be empty]
#
# None for a guest that lives where this node puts its own -- there is nothing
# for a symlink to reconcile, and an empty list is the answer rather than a
# failure, which is what the contract marker says and the same shape a jail
# produces on real CBSD.
#
# ONE, for a guest whose data is somewhere else: ${PSEUDO_MOUNT}/<name>, this
# platform's fixed place for a guest, pointed at the data. It is the analogue
# of what CBSD does for a VM (`ln -sf ${data} ${jailsysdir}/${jname}`,
# sudoexec/bcreate:599) and it is what makes adapter_guest_sysdir resolve into
# the guest's own datasets wherever they are mounted -- which is how the
# configuration of a guest promoted onto a path its home node chose is found
# after the ceremony.
#
# <datapath> is where the guest's data IS, passed in rather than looked up:
# before a registration there is nothing on this node to look it up in.
adapter_guest_links()
{
    pseudo_name_ok "${1:-}" || { pseudo_diag "bad guest name: ${1:-}"; return 2; }

    case "${2:-}" in
        jail|bhyve) ;;
        *) pseudo_diag "unsupported guest type: ${2:-}"; return 2 ;;
    esac

    case "${3:-}" in
        /*) ;;
        *) pseudo_diag "not an absolute data path: [${3:-}]"; return 2 ;;
    esac

    [ "$3" = "${PSEUDO_MOUNT}/$1" ] && return 0

    printf '%s/%s\t%s\n' "${PSEUDO_MOUNT}" "$1" "$3"
    return 0
}

# contract: adapter_guest_data_path(name) -> path [promises output]
#
# Where this node says the guest's data is -- OBSERVED, which here means "what
# was recorded when it was registered" and not "where a guest of this node's
# would have been put" (D-178, D-181). A guest promoted in place is registered
# from a configuration naming the path its home node used, and this adapter has
# to be able to say so or the pseudo-cluster cannot express the shape the first
# real fleet is built in.
#
# rc 1 for a guest this node does not have. Field 7 of the record is the data
# path; a record written before this field existed leaves it empty, and the
# node's own layout is then the answer -- which is what such a guest has.
adapter_guest_data_path()
{
    local _d

    pseudo_name_ok "${1:-}" || { pseudo_diag "bad guest name: ${1:-}"; return 2; }

    pseudo_field "$1" 1 > /dev/null || return 1

    _d=$( pseudo_field "$1" 7 ) || _d=""

    case "${_d}" in
        /*) printf '%s\n' "${_d}" ;;
        *)  printf '%s/%s\n' "${PSEUDO_MOUNT}" "$1" ;;
    esac
}

# contract: adapter_config_data_path(rcfile) -> path [promises output]
#
# The `data=` of a guest's own configuration file, in this adapter's spelling
# of one: bare "key=value" lines, parsed and never sourced, the same way
# adapter_guest_register reads the rest of it.
#
# rc 1 when the file states no data path -- a guest that lives where this node
# puts its own -- and rc 2 when it states something a replica cannot be mounted
# at. It is a stand-in for the real adapter's parser, not a second copy of it;
# tests/conformance/vectors.tsv runs the same three cases against both.
adapter_config_data_path()
{
    local _f _v

    _f=${1:-}

    if [ -z "${_f}" ] || [ ! -r "${_f}" ]; then
        pseudo_diag "adapter_config_data_path: no readable configuration file: [${_f}]"
        return 2
    fi

    _v=$( awk -F= '$1 == "data" { v = $2 } END { print v }' "${_f}" ) || _v=""

    case "${_v}" in
        ''|0|-) return 1 ;;
        /|*" "*|*/../*|*/..)
            pseudo_diag "adapter_config_data_path: ${_f} says data=[${_v}]," \
                "which is not a path a replica can be mounted at"
            return 2
            ;;
        /*) ;;
        *)
            pseudo_diag "adapter_config_data_path: ${_f} says data=[${_v}]," \
                "which is not a path a replica can be mounted at"
            return 2
            ;;
    esac

    printf '%s\n' "${_v}"
}

# contract: adapter_guest_datasets(name) -> dataset per line, root first [promises output]
#
# Every ZFS dataset belonging to the guest, THE ROOT FIRST and every other line
# a descendant of it. rc 0 with output, 1 if the guest has no dataset at all.
#
# THE MOUNTED PATH FIRST, exactly as the real adapter does it and for the same
# reason: after a promotion in place the guest's dataset is a replica under
# <standby_root>/<deadkey>/<name>, mounted at the path this node expects, and
# no derivation from this node's own dataset name could ever name it. The
# answer is accepted only when the dataset's own mountpoint is exactly the path
# asked about, because `zfs list <path>` otherwise answers with the dataset
# CONTAINING it (observed: `zfs list -H -o name,mountpoint /data/jails` prints
# the parent dataset and its mountpoint /data).
adapter_guest_datasets()
{
    local _root _ds _mp _cand

    pseudo_name_ok "${1:-}" || { pseudo_diag "bad guest name: ${1:-}"; return 2; }

    _ds=""

    _mp=$( adapter_guest_data_path "$1" 2>/dev/null ) || _mp=""
    [ -n "${_mp}" ] || _mp=$( adapter_guest_mountpoint "$1" jail ) || _mp=""
    if [ -n "${_mp}" ]; then
        _cand=$( zfs list -H -o name "${_mp}" 2>/dev/null ) || _cand=""
        if [ -n "${_cand}" ] &&
           [ "$( zfs get -H -o value mountpoint "${_cand}" 2>/dev/null )" = "${_mp}" ]
        then
            _ds=${_cand}
        fi
    fi

    if [ -z "${_ds}" ]; then
        _root=$( pseudo_root ) || return 1
        _ds="${_root}/$1"

        zfs list -H -o name "${_ds}" > /dev/null 2>&1 || {
            pseudo_diag "guest $1 has no dataset at ${_ds}"
            return 1
        }
    fi

    zfs list -H -o name -t filesystem,volume -r "${_ds}"
}

# contract: adapter_guest_sysdir(name) -> path [promises output]
#
# The directory holding the guest's configuration -- the analogue of CBSD's
# ${jailsysdir}/<name>/. rc 0 with output, 1 if there is none.
adapter_guest_sysdir()
{
    local _d

    pseudo_name_ok "${1:-}" || { pseudo_diag "bad guest name: ${1:-}"; return 2; }

    _d="${PSEUDO_MOUNT}/$1/sys"
    [ -d "${_d}" ] || return 1

    printf '%s\n' "${_d}"
}

# contract: adapter_guest_register(name,rcfile) -> nothing [no output]
#
# Make a replicated guest startable here, from the configuration that travelled
# with it. rc 0 registered, 1 the registration failed, 2 a bad name or an
# unreadable rcfile.
adapter_guest_register()
{
    local _name _rc _type _astart _home _data _nodename

    _name=${1:-}
    _rc=${2:-}

    pseudo_name_ok "${_name}" || { pseudo_diag "bad guest name: ${_name}"; return 2; }
    [ -r "${_rc}" ] || { pseudo_diag "no readable rcfile: ${_rc}"; return 2; }

    if pseudo_field "${_name}" 1 > /dev/null 2>&1; then
        pseudo_diag "${_name} is already registered here"
        return 1
    fi

    # The rcfile is the guest's own description, replicated with its datasets.
    # Parsed, not sourced, for the same reason seance.conf is (handoff §2.2).
    _type=$( awk -F= '$1 == "type" { print $2; exit }' "${_rc}" )
    _astart=$( awk -F= '$1 == "astart" { print $2; exit }' "${_rc}" )
    _home=$( awk -F= '$1 == "home" { print $2; exit }' "${_rc}" )

    [ -n "${_type}" ] || _type=jail
    [ -n "${_astart}" ] || _astart=0
    [ -n "${_home}" ] || _home=$( adapter_node_self )

    # AND WHERE ITS DATA IS, out of the same file. This is the platform half of
    # D-181: a guest is registered from a configuration that names its data
    # path, and everything this node afterwards says about where that guest
    # lives has to come from what it was told, not from what this node would
    # have chosen. A configuration that names none leaves the field empty and
    # the node's own layout answers.
    _data=$( adapter_config_data_path "${_rc}" ) || _data=""

    # AND IT IS REGISTERED AS THIS NODE'S (D-184). The rcfile names the node it
    # came from; a platform that files the guest under that name lists it here
    # as another node's, which is the row adapter_guest_list skips. What the
    # file says about the guest is kept; what it says about WHERE THE GUEST
    # LIVES is now, by the act of registering it, here.
    _nodename=$( adapter_node_self )

    printf '%s\t%s\t%s\t%s\t0\t0\t%s\t%s\n' \
        "${_name}" "${_type}" "${_astart}" "${_home}" "${_data}" "${_nodename}" \
        >> "${PSEUDO_DB}"
}

# contract: adapter_guest_unregister(name) -> nothing [no output]
#
# Forget a guest here; its datasets are untouched. rc 0 done, 1 failed, 2 a
# name that is not one.
adapter_guest_unregister()
{
    local _tmp

    pseudo_name_ok "${1:-}" || { pseudo_diag "bad guest name: ${1:-}"; return 2; }
    [ -r "${PSEUDO_DB}" ] || return 1

    _tmp="${PSEUDO_DB}.new.$$"
    awk -F "${PSEUDO_TAB}" -v g="$1" '$1 != g' "${PSEUDO_DB}" > "${_tmp}" ||
        { rm -f "${_tmp}"; return 1; }
    mv "${_tmp}" "${PSEUDO_DB}"
}

# contract: adapter_guest_hold(name) -> nothing [no output]
#
# Withhold the guest from every start path (CBSD slave mode, D-21). rc 0 held,
# 1 failed, 2 no such guest or a name that is not one.
adapter_guest_hold()
{
    pseudo_name_ok "${1:-}" || { pseudo_diag "bad guest name: ${1:-}"; return 2; }
    pseudo_field "$1" 1 > /dev/null || { pseudo_diag "no such guest: $1"; return 2; }

    pseudo_set_field "$1" 6 1 || return 1
}

# contract: adapter_guest_release(name) -> nothing [no output]
#
# The inverse of adapter_guest_hold. rc 0 released, 1 failed, 2 no such guest
# or a name that is not one.
adapter_guest_release()
{
    pseudo_name_ok "${1:-}" || { pseudo_diag "bad guest name: ${1:-}"; return 2; }
    pseudo_field "$1" 1 > /dev/null || { pseudo_diag "no such guest: $1"; return 2; }

    pseudo_set_field "$1" 6 0 || return 1
}

# contract: adapter_guest_held(name) -> 1|0 [promises output]
#
# rc 0 with output, 1 if there is no such guest, 2 for a name that is not one.
adapter_guest_held()
{
    local _h

    pseudo_name_ok "${1:-}" || { pseudo_diag "bad guest name: ${1:-}"; return 2; }

    _h=$( pseudo_field "$1" 6 ) || return 1

    if [ "${_h}" = "1" ]; then
        printf '1\n'
    else
        printf '0\n'
    fi
}

# contract: adapter_kernel_version() -> uname-style kernel version [promises output]
#
# rc 0 with output, 1 otherwise. Real here, not mocked: kernel homogeneity is a
# precondition for promoting a jail guest (D-5), and a pseudo-cluster whose
# nodes genuinely share one kernel is the true answer rather than a fabricated
# one.
#
# freebsd-version -k first, because that is what the real adapter asks and the
# two must agree on a real host; uname -r when it has nothing to say, which
# inside a jail is always -- freebsd-version -k reads the kernel image under
# /boot, and a jail has no /boot (observed: it printed nothing, and the first
# run of the repl stage reported "kernel unknown" on all three nodes). uname -r
# is the RUNNING kernel's release, which for a jail is the host's, and the
# host's kernel is exactly the one a jail guest would be promoted onto.
adapter_kernel_version()
{
    local _v

    _v=$( freebsd-version -k 2>/dev/null ) || _v=""
    [ -n "${_v}" ] || _v=$( uname -r 2>/dev/null ) || _v=""
    [ -n "${_v}" ] || return 1

    printf '%s\n' "${_v}"
}

# contract: adapter_carp_state(vhid) -> MASTER|BACKUP|INIT|absent [promises output]
#
# rc 0 with output always; 2 if <vhid> is not a CARP vhid. Parsed from
# ifconfig(8), whose carp line reads "carp: MASTER vhid 1 advbase 1 advskew 0"
# (observed in the guest, recorded by the substrate stage's CARP probe, D-27).
#
# THE RANGE IS PART OF THE CONTRACT, not only the digits: ifconfig(8) says
# "Acceptable values for vhid are 1 to 255", which lib/adapter.subr enforces in
# _adapter_vhid_ok and the vectors pin with the 0 and 256 rows. This adapter
# used to accept both and answer "absent" -- a caller asking about a vhid that
# cannot exist got a confident no rather than a refusal, and the two adapters
# disagreed about the same question. Found by running tests/conformance against
# this adapter for the first time (tier 5).
#
# A leading zero is refused rather than normalised for the reason the real
# adapter gives: $(( )) would read it as octal, and a vhid is written by a
# human in a configuration file.
adapter_carp_state()
{
    local _vhid _s

    _vhid=${1:-}
    case "${_vhid}" in
        ''|*[!0123456789]*) pseudo_diag "carp: vhid must be a number: ${_vhid}"; return 2 ;;
        0*) pseudo_diag "carp: vhid must not have a leading zero: ${_vhid}"; return 2 ;;
    esac

    if [ "${_vhid}" -lt 1 ] || [ "${_vhid}" -gt 255 ]; then
        pseudo_diag "carp: vhid must be 1-255 (ifconfig(8)): ${_vhid}"
        return 2
    fi

    _s=$( ifconfig 2>/dev/null |
        awk -v v="${_vhid}" '
            $1 == "carp:" && $4 == v { print $2; found = 1; exit }
            END { if (!found) print "absent" }
        ' )

    [ -n "${_s}" ] || _s=absent

    printf '%s\n' "${_s}"
}

# ---------------------------------------------------------------------------
# Fixture helpers -- NOT part of the adapter contract
#
# Deliberately not named adapter_*: they exist so a tier-6 stage can build a
# world, and lib/adapter.subr has no equivalent because CBSD's own tooling is
# how a real guest is made.
# ---------------------------------------------------------------------------

# pseudo_guest_create <name> <type> <home> [astart] [datapath]
#
# Create a guest: its dataset root with a LOCAL mountpoint (the shadow-mount
# law has nothing to bite on if the source's mountpoint is inherited -- see
# docs/repl-wire.md), its sys child, and its record.
#
# <datapath> is where this guest's data lives when that is NOT this node's own
# ${PSEUDO_MOUNT}/<name> -- the shape the first real fleet is built in, where
# every guest is a VM whose data sits on the jail-shaped path and nothing at
# all lives where the creation convention for its type would have put it
# (D-178). A guest made that way carries `data=` in its own configuration, has
# it recorded in its registration, and gets the same symlink from this
# platform's fixed place that CBSD gives a VM -- so that everything which looks
# a guest up by name still finds it.
pseudo_guest_create()
{
    local _name _type _home _astart _data _dsname _root _ds

    _name=$1
    _type=$2
    _home=$3
    _astart=${4:-1}
    _data=${5:-}
    # The DATASET's basename, when it is not the guest's name. Real platforms
    # name a guest's dataset by their own convention -- CBSD's is
    # `<jname>-<jaildatapref>` -- and a fixture in which the two are always
    # equal is a fixture that cannot express the fleet seance actually runs on
    # (D-183). Defaults to the guest's name, which is the textbook shape.
    _dsname=${6:-$1}

    pseudo_name_ok "${_name}" || { pseudo_diag "bad guest name: ${_name}"; return 2; }

    [ -n "${_data}" ] || _data="${PSEUDO_MOUNT}/${_name}"

    case "${_data}" in
        /*) ;;
        *) pseudo_diag "not an absolute data path: [${_data}]"; return 2 ;;
    esac

    pseudo_name_ok "${_dsname}" || {
        pseudo_diag "bad dataset basename: ${_dsname}"
        return 2
    }

    _root=$( pseudo_root ) || return 1
    _ds="${_root}/${_dsname}"

    zfs create -o "mountpoint=${_data}" "${_ds}" || return 1
    zfs create "${_ds}/sys" || return 1

    # nodename: WHICH NODE HOSTS THIS GUEST, as opposed to `home`, which is
    # where its succession says it belongs. Real platforms write this at
    # creation and believe it at registration (CBSD does), so a configuration
    # that travels to a survivor carries the DEAD node's name in it -- which is
    # the fleet defect D-184 exists for, and which this fixture could not
    # express until it recorded the field at all.
    {
        printf 'name=%s\n' "${_name}"
        printf 'type=%s\n' "${_type}"
        printf 'astart=%s\n' "${_astart}"
        printf 'home=%s\n' "${_home}"
        printf 'nodename=%s\n' "$( adapter_node_self )"
        printf 'data=%s\n' "${_data}"
    } > "${_data}/sys/rc.conf_${_name}" || return 1

    if [ "${_data}" != "${PSEUDO_MOUNT}/${_name}" ]; then
        ln -sf "${_data}" "${PSEUDO_MOUNT}/${_name}" || return 1
    fi

    printf '%s\t%s\t%s\t%s\t1\t0\t%s\t%s\n' \
        "${_name}" "${_type}" "${_astart}" "${_home}" "${_data}" \
        "$( adapter_node_self )" >> "${PSEUDO_DB}"
}
