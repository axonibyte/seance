# seance -- the adapter: the only file that knows CBSD and the host exist.
#
# Sourced, never executed, and sourceable standalone: sourcing this file
# defines functions and initialises variables and does nothing else. The
# dispatcher sources ${SEANCE_ADAPTER:-lib/adapter.subr}, so the mock
# (tests/mock-adapter.subr) and the pseudo-cluster adapter are drop-in
# replacements -- which is only true if none of them acts at source time.
#
# THE CONTRACT (design §2, handoff §2.3), identical for every adapter:
#
#   * stdout is data, stderr is diagnostics, the exit status is the verdict:
#     0 ok, 1 the operation failed or its answer is negative, 2 a usage or
#     contract error (the caller passed something impossible, or CBSD answered
#     in a shape this adapter does not understand).
#   * list-returning functions emit one record per line, fields separated by a
#     single tab, no header, field order fixed by the '# contract:' comment
#     above the function and by tests/conformance/vectors.tsv. No field may
#     contain a tab.
#   * every function carries exactly one '# contract:' line, ending in one of
#     three markers that say what empty stdout means:
#       [promises output]     empty stdout with rc 0 is a CONTRACT VIOLATION
#                             and callers must treat it as one -- the
#                             crashed-verifier lesson (TESTING.md §5).
#       [list: may be empty]  no records is a valid answer; rc 0, no output.
#       [no output]           this function answers with its exit status.
#   * names are validated on the way in, before they reach a command line.
#
# EVIDENCE. Every CBSD behaviour relied on below is read out of the installed
# CBSD 15.0.9 source and cited file:line. Nothing here is remembered.
#
# shellcheck shell=sh
# shellcheck disable=SC3043
#   'local' is not in POSIX sh but is implemented by FreeBSD /bin/sh (sh(1),
#   "local"); seance targets FreeBSD sh and nothing else (handoff §5).

# ---------------------------------------------------------------------------
# State, all of it set by adapter_init and read-only thereafter.
# ---------------------------------------------------------------------------

ADAPTER_READY=0
ADAPTER_DISTDIR=""
ADAPTER_WORKDIR=""
ADAPTER_NODENAME=""
ADAPTER_JAILSYSDIR=""
ADAPTER_JAILDATADIR=""
ADAPTER_JAILRCCONFDIR=""
ADAPTER_DBDIR=""
ADAPTER_ETCDIR=""
ADAPTER_VERB=""

# The tab and newline this file splits on, spelled once.
ADAPTER_TAB=$( printf '\t' )

# ---------------------------------------------------------------------------
# Diagnostics
# ---------------------------------------------------------------------------

# _adapter_diag <message...>  -- one diagnostic line on stderr. Never stdout:
# a diagnostic that lands in a TSV record is a corrupt record.
_adapter_diag()
{
    printf 'adapter: %s\n' "$*" >&2
}

# _adapter_skip_log  -- this PROCESS's memo of skip diagnostics already said.
#
# A path derived from the PID rather than a variable remembered in the shell,
# because the parser that says these lines runs inside a command substitution
# (adapter_guest_list captures its output), and nothing a subshell assigns
# survives it. $$ is the invoking shell's PID in every subshell it makes
# (sh(1), "Special Parameters"), so the memo is one file per seance process
# whichever shell writes to it.
_adapter_skip_log()
{
    printf '%s/seance-adapter-skip.%s\n' "${TMPDIR:-/tmp}" "$$"
}

# _adapter_skip_reset  -- start this process with an empty memo, and clear away
# the memos of processes that are gone.
#
# Both halves matter. A PID is reused eventually, and a memo left behind by a
# previous owner of this one would silence a line THIS process has not said --
# which is the only way this mechanism could ever lose a diagnostic. And a file
# per seance process, on a node whose cron runs one every five minutes, is a
# directory that fills up: the ones whose owner is gone are removed here, where
# a process that is starting can afford the walk.
_adapter_skip_reset()
{
    local _f _pid

    rm -f "$( _adapter_skip_log )" 2>/dev/null

    for _f in "${TMPDIR:-/tmp}"/seance-adapter-skip.*; do
        [ -e "${_f}" ] || continue

        _pid=${_f##*.}
        case "${_pid}" in
            ''|*[!0123456789]*) continue ;;
        esac

        kill -0 "${_pid}" 2>/dev/null && continue
        rm -f "${_f}" 2>/dev/null
    done

    return 0
}

# _adapter_skip_once <message...>
#
# One skip diagnostic per process, per sentence.
#
# WHY THIS EXISTS. The roster is enumerated four times in a single `repl` tick,
# and every enumeration said the same thing about the same skipped guest --
# four identical lines per tick, per guest, under cron, for ever. A diagnostic
# that is always there is a diagnostic nobody reads (the same finding as the
# phantom-guest line D-97 removed). The BEHAVIOUR is unchanged: the row is
# still skipped, and every distinct sentence is still said once, in full, with
# its reasoning.
#
# The key is the whole sentence and not the guest's name: "not local to this
# node" and "emulator xen is not supported" are two different facts about one
# guest, and a guest whose row changes between enumerations has something new
# to say.
#
# IT NEVER SUPPRESSES MORE THAN IT MEANS TO. A memo that cannot be read or
# written -- a read-only ${TMPDIR}, or a path something else has planted a
# symlink at, which /tmp being world-writable makes possible -- degrades to
# saying the line every time, never to silence. The symlink is refused rather
# than followed for the other half of that: appending a diagnostic through a
# planted link would write seance's output into somebody else's file.
_adapter_skip_once()
{
    local _f _msg

    _msg=$*
    _f=$( _adapter_skip_log )

    if [ -h "${_f}" ] || { [ -e "${_f}" ] && [ ! -f "${_f}" ]; }; then
        _adapter_diag "${_msg}"
        return 0
    fi

    if [ -f "${_f}" ] && grep -q -F -x -e "${_msg}" "${_f}" 2>/dev/null; then
        return 0
    fi

    printf '%s\n' "${_msg}" >> "${_f}" 2>/dev/null
    _adapter_diag "${_msg}"
}

# ---------------------------------------------------------------------------
# Validation
# ---------------------------------------------------------------------------

# _adapter_name_ok <name>
#
# rc 0 if the name is a guest name seance is willing to put on a command line,
# in a tab-separated record and in a dataset path: [a-z0-9][a-z0-9._-]*.
#
# CBSD's own rule is wider -- subr/nc.subr:733-737 validate_jname accepts
# ^[a-zA-Z0-9_@%:][-a-zA-Z0-9_@%:]*$ -- so seance is deliberately stricter in
# four places (no upper case, no '_@%:' beyond '_', no leading dash) and wider
# in exactly one ('.', which CBSD rejects and which therefore cannot reach a
# real guest). Decision D-45 records why and what it costs.
#
# Character classes are written out rather than ranged, as everywhere in
# seance: POSIX leaves bracket ranges outside the C locale unspecified.
_adapter_name_ok()
{
    local _n

    _n=${1:-}

    case "${_n}" in
        ''|[!abcdefghijklmnopqrstuvwxyz0123456789]*) return 1 ;;
        *[!abcdefghijklmnopqrstuvwxyz0123456789._-]*) return 1 ;;
    esac

    return 0
}

# _adapter_vhid_ok <vhid>  -- rc 0 for a CARP vhid, 1 to 255 (carp(4); the
# ifconfig(8) manual pins the range: "Acceptable values for vhid are 1 to 255").
_adapter_vhid_ok()
{
    local _v

    _v=${1:-}

    case "${_v}" in
        ''|*[!0123456789]*) return 1 ;;
    esac

    # Leading zeros would make $(( )) read an octal constant; reject rather
    # than normalise, because a vhid is written by a human in a config file.
    case "${_v}" in
        0*) return 1 ;;
    esac

    [ "${_v}" -ge 1 ] && [ "${_v}" -le 255 ]
}

# ---------------------------------------------------------------------------
# Initialisation
# ---------------------------------------------------------------------------

# adapter_init
#
# Learn where CBSD keeps its things, once. Under the cbsdsh wrapper (D-2) the
# facts arrive in the environment as SEANCE_CBSD_*; from cron, from devd and
# from the test tiers there is no wrapper, so they are derived the way CBSD
# itself derives them:
#
#   workdir     $cbsd_workdir from rc.conf. cbsd.conf:28-36 sources
#               /etc/rc.conf and takes $cbsd_workdir; seance asks sysrc(8)
#               for the same variable instead, because seance parses
#               configuration and never sources it.
#   nodename    one line in ${workdir}/nodename (cbsd.conf:52, nodenamefile).
#   the rest    CBSD's fixed layout: jailsysdir ${workdir}/jails-system
#               (cbsd.conf:71), jaildatadir ${workdir}/jails-data
#               (cbsd.conf:65), jailrcconfdir ${workdir}/jails-rcconf
#               (cbsd.conf:67), etcdir ${workdir}/etc (cbsd.conf:73), dbdir
#               ${workdir}/var/db (cbsd.conf:84,92).
#   distdir     /usr/local/cbsd (cbsd.conf:24).
#
# rc 2 when CBSD is not present or its facts cannot be established. Idempotent.
#
# contract: adapter_init() -> nothing [no output]
adapter_init()
{
    local _wd _nn _bin

    [ "${ADAPTER_READY}" -eq 1 ] && return 0

    _bin=$( command -v cbsd 2>/dev/null ) || _bin=""
    if [ -z "${_bin}" ]; then
        _adapter_diag "CBSD is not present (no runnable 'cbsd' in PATH)"
        return 2
    fi

    # How this platform is asked to run one of seance's own verbs, as an
    # absolute command line. devd(8) execs its actions with sh -c and an
    # environment of its own (sbin/devd/devd.cc:262-266), so the rule
    # `verify --render devd` prints cannot rely on PATH or on any variable
    # the module's wrapper would otherwise have set; the platform's verb is
    # what carries this node's facts into the dispatcher (D-2).
    ADAPTER_VERB="${_bin} seance"

    ADAPTER_DISTDIR=${SEANCE_CBSD_DISTDIR:-/usr/local/cbsd}

    # This process has said nothing yet.
    _adapter_skip_reset

    _wd=${SEANCE_CBSD_WORKDIR:-}
    if [ -z "${_wd}" ]; then
        if ! command -v sysrc > /dev/null 2>&1; then
            _adapter_diag "no SEANCE_CBSD_WORKDIR and no sysrc(8) to ask for cbsd_workdir"
            return 2
        fi
        _wd=$( sysrc -n cbsd_workdir 2>/dev/null ) || _wd=""
    fi

    if [ -z "${_wd}" ]; then
        _adapter_diag "cannot determine the CBSD workdir: cbsd_workdir is not set in rc.conf"
        return 2
    fi

    if [ ! -d "${_wd}" ]; then
        _adapter_diag "CBSD workdir is not a directory: ${_wd}"
        return 2
    fi

    _nn=${SEANCE_CBSD_NODENAME:-}
    if [ -z "${_nn}" ]; then
        if [ ! -r "${_wd}/nodename" ]; then
            _adapter_diag "no readable nodename file at ${_wd}/nodename"
            return 2
        fi
        # read(1) returns non-zero on a last line without a newline and still
        # assigns, so emptiness is the verdict here, not read's status.
        _nn=""
        read -r _nn < "${_wd}/nodename"
    fi

    if [ -z "${_nn}" ]; then
        _adapter_diag "the CBSD nodename is empty"
        return 2
    fi

    case "${_nn}" in
        *"${ADAPTER_TAB}"*|*' '*)
            _adapter_diag "the CBSD nodename contains whitespace: [${_nn}]"
            return 2
            ;;
    esac

    ADAPTER_WORKDIR=${_wd}
    ADAPTER_NODENAME=${_nn}
    ADAPTER_JAILSYSDIR=${SEANCE_CBSD_JAILSYSDIR:-${_wd}/jails-system}
    ADAPTER_JAILDATADIR=${SEANCE_CBSD_JAILDATADIR:-${_wd}/jails-data}
    ADAPTER_JAILRCCONFDIR=${SEANCE_CBSD_JAILRCCONFDIR:-${_wd}/jails-rcconf}
    ADAPTER_DBDIR=${SEANCE_CBSD_DBDIR:-${_wd}/var/db}
    ADAPTER_ETCDIR=${SEANCE_CBSD_ETCDIR:-${_wd}/etc}
    ADAPTER_READY=1

    return 0
}

# _adapter_ready  -- initialise on first use; rc 2 if that is not possible.
_adapter_ready()
{
    [ "${ADAPTER_READY}" -eq 1 ] && return 0
    adapter_init
}

# _adapter_cbsd <verb> [args...]
#
# The one place seance runs CBSD. Two things happen here and nowhere else:
#
#   NOCOLOR=1  -- cbsd.conf:159-163 and 177-189: the ANSI colour variables are
#                 only loaded when NOCOLOR is empty, so without this every
#                 field of every listing may arrive wrapped in escapes.
#   cd         -- jstop, jstart, jget and their bhyve twins read a CBSDfile
#                 from the *caller's* working directory and silently change
#                 which environments they act on when they find one
#                 (sudoexec/jstop:38-40, sudoexec/bstop:44-46,
#                 jailctl/jget:51-52). A promotion must not depend on where
#                 cron happened to be standing, so every invocation is made
#                 from a directory chosen for having nothing in it.
_adapter_cbsd()
{
    local _cwd

    _cwd=${SEANCE_ADAPTER_CWD:-/var/empty}

    if [ ! -d "${_cwd}" ]; then
        _adapter_diag "no such directory to run cbsd from: ${_cwd} (set SEANCE_ADAPTER_CWD)"
        return 2
    fi

    (
        cd "${_cwd}" || exit 2
        NOCOLOR=1
        export NOCOLOR
        exec cbsd "$@"
    )
}

# _adapter_cbsd_act <verb> [args...]
#
# _adapter_cbsd for the functions whose contract marker is [no output]: CBSD's
# own stdout becomes THIS process's stderr, and only the exit status is kept.
#
# WHY IT EXISTS, measured rather than reasoned. CBSD's scripts talk on stdout,
# including when they refuse: `cbsd jstart` on a jail in slave mode prints
# "Jail in slave mode. Please cbsd jswmode mode=master first" through err()
# (sudoexec/jstart:367), and a start, a stop and a register each print progress
# lines there too. Observed in the guest (tests/tier5/t_lifecycle_real.sh):
# before this, `adapter_guest_start <held>` exited 1 having printed CBSD's
# refusal on STDOUT -- a function that promises no output, putting a sentence
# on the channel this project reserves for data. Any caller that captured it
# got CBSD's chatter as its answer (docs/cbsd-module-notes.md §8.9).
#
# The output is not discarded. A refusal an operator cannot read is worse than
# one on the wrong descriptor, and stderr is where diagnostics belong.
_adapter_cbsd_act()
{
    _adapter_cbsd "$@" 1>&2
}

# ---------------------------------------------------------------------------
# Node identity
# ---------------------------------------------------------------------------

# contract: adapter_node_self() -> nodename [promises output]
adapter_node_self()
{
    _adapter_ready || return 2

    printf '%s\n' "${ADAPTER_NODENAME}"
}

# contract: adapter_fact(key) -> value [promises output]
#
# The node facts adapter_init established, one at a time, by key:
# workdir, nodename, jailsysdir, jaildatadir, dbdir, etcdir, distdir, verb.
#
# `verb` is the command line that runs a seance verb on this platform. It is a
# fact of the platform in exactly the way the paths are -- only the adapter
# knows how this host is asked to run the module's own entry point -- and
# `verify --render devd` needs it, because a devd(8) action is executed by
# sh -c with none of the module wrapper's environment.
#
# This exists so that the seam holds for paths as well as for commands. seance
# keeps its state under ${workdir}/var/db/seance and its config at
# ${workdir}/etc/seance.conf (decision D-3, confirmed by observation in D-17);
# without an accessor every verb that wants those would have to work out where
# CBSD's workdir is, and there would be six places that know instead of one.
#
# rc 2 for an unknown key: a typo'd fact must not read as an empty one.
adapter_fact()
{
    _adapter_ready || return 2

    case "${1:-}" in
        workdir)     printf '%s\n' "${ADAPTER_WORKDIR}" ;;
        nodename)    printf '%s\n' "${ADAPTER_NODENAME}" ;;
        jailsysdir)  printf '%s\n' "${ADAPTER_JAILSYSDIR}" ;;
        jaildatadir) printf '%s\n' "${ADAPTER_JAILDATADIR}" ;;
        dbdir)       printf '%s\n' "${ADAPTER_DBDIR}" ;;
        etcdir)      printf '%s\n' "${ADAPTER_ETCDIR}" ;;
        distdir)     printf '%s\n' "${ADAPTER_DISTDIR}" ;;
        verb)        printf '%s\n' "${ADAPTER_VERB}" ;;
        *)
            _adapter_diag "adapter_fact: no such fact: [${1:-}]"
            return 2
            ;;
    esac

    return 0
}

# contract: adapter_kernel_version() -> uname-style kernel version [promises output]
#
# freebsd-version(1) -k is the *installed* kernel's version, which is the
# homogeneity precondition jails care about (design §3): a jail promoted onto
# a node runs that node's kernel.
adapter_kernel_version()
{
    local _v

    _v=$( freebsd-version -k 2>/dev/null ) || _v=""

    if [ -z "${_v}" ]; then
        _adapter_diag "freebsd-version -k produced nothing"
        return 1
    fi

    printf '%s\n' "${_v}"
}

# ---------------------------------------------------------------------------
# Guests: enumeration
# ---------------------------------------------------------------------------

# _adapter_status_int <status-word>
#
# CBSD prints the jails.status column as a word, not as the integer it stores:
# conv_status (subr/strings.subr:27-46) maps 0 Off, 1 On, 2 Slave,
# 3 Maintenance, anything else Unknown, and both jls and bls call it before
# printing a row (jailctl/jls:267, bhyvectl/bls:401). The listing's unregistered
# area prints the literal "Unregister" instead (jailctl/jls:287-295, populated
# with -u 1). This maps the word back to the integer the contract promises.
#
# rc 1 for "Unregister" (a guest CBSD's database does not know), rc 2 for
# "Unknown" (a status integer CBSD itself cannot name).
_adapter_status_int()
{
    case "${1:-}" in
        Off)         printf '0\n' ;;
        On)          printf '1\n' ;;
        Slave)       printf '2\n' ;;
        Maintenance) printf '3\n' ;;
        Unregister)  return 1 ;;
        *)           return 2 ;;
    esac

    return 0
}

# _adapter_list_rows
#
# Read a `cbsd jls`/`cbsd bls` listing produced with
# `header=0 display=jname,emulator,astart,status` on stdin and print
# "name<TAB>type<TAB>astart<TAB>status" per guest.
#
# The listing is whitespace-aligned, not tab-separated: both scripts end in
# `show_jails | ${COLUMN_CMD} -t` (jailctl/jls:353, bhyvectl/bls:508), and each
# field is printed with a trailing space (jailctl/jls:226, bhyvectl/bls:221).
# None of the four fields can contain whitespace, so splitting on it is exact.
#
# Rows that are understood but out of scope are skipped with a diagnostic:
#   * an emulator other than jail or bhyve (seance supports two, design §1);
#   * a row whose emulator field is CBSD's "I could not fill this in" marker,
#     which on a clustered node is every other node's guest (D-171);
#   * an unregistered guest, which cannot be started or held until it has been
#     through adapter_guest_register.
# A row that is NOT understood -- too few fields, or a status word CBSD itself
# calls Unknown -- fails the whole call with rc 2. A listing this function
# quietly shortened is an estate with a guest missing from it, and that is the
# shape of a promotion that leaves a guest behind.
_adapter_list_rows()
{
    local _name _emu _astart _status _rest _int _rc

    _rc=0

    while read -r _name _emu _astart _status _rest; do
        [ -n "${_name}" ] || continue

        if [ -z "${_emu}" ] || [ -z "${_astart}" ] || [ -z "${_status}" ]; then
            _adapter_diag "unreadable listing row: [${_name} ${_emu} ${_astart} ${_status}]"
            _rc=2
            continue
        fi

        case "${_emu}" in
            jail|bhyve) ;;
            0|-)
                # NOT AN UNSUPPORTED EMULATOR: A GUEST THAT IS NOT THIS NODE'S.
                #
                # CBSD prints a display field it could not fill as "0"
                # (bhyvectl/bls:220-222) or as "-" (jailctl/jls:169-171), and on
                # a CLUSTERED node that is what every other node's guest looks
                # like here: cluster mode turns the foreign listing on by itself
                # -- `is_cluster_mode` true means alljails=1 and shownode=1
                # unless the caller says otherwise (jailctl/jls:70-77) -- and
                # the remote rows are filled from the peer's replicated SQL,
                # which does not carry the emulator (bhyvectl/bls:390-393, and
                # its own "todo: remote sql fetch via retrinv" at 224).
                #
                # Skipping it is right and is unchanged: seance replicates and
                # promotes what THIS node hosts, and the peer is doing the same
                # for its own. What was wrong was the sentence -- "emulator 0 is
                # not supported by seance" reads as a product that cannot
                # handle the fleet's guests, on a node whose every peer's guest
                # produces one, which is how an operator comes to believe the
                # module is broken. Found on a real three-node cluster (D-171).
                #
                # The second reading is stated too, because this parser cannot
                # tell the two apart from one row and must not pretend to: a
                # LOCAL guest whose registration never set an emulator prints
                # the same field.
                _adapter_skip_once "skipping ${_name}: it is not local to this node." \
                    "CBSD prints a listing field it could not fill as \"${_emu}\"," \
                    "and on a clustered node that is how another node's guest appears" \
                    "in this listing -- seance replicates and promotes what THIS node" \
                    "hosts. (If ${_name} really does live here, its registration has no" \
                    "emulator and \"cbsd jls jname=${_name}\" will show the same gap.)"
                continue
                ;;
            *)
                _adapter_skip_once "skipping ${_name}: emulator ${_emu} is not supported by seance"
                continue
                ;;
        esac

        if ! _adapter_name_ok "${_name}"; then
            _adapter_diag "unusable guest name in listing: [${_name}]"
            _rc=2
            continue
        fi

        case "${_astart}" in
            0|1) ;;
            *)
                _adapter_diag "unreadable astart for ${_name}: [${_astart}]"
                _rc=2
                continue
                ;;
        esac

        _int=$( _adapter_status_int "${_status}" )
        case $? in
            0) ;;
            1)
                _adapter_skip_once "skipping ${_name}: CBSD's database does not know it (status ${_status})"
                continue
                ;;
            *)
                _adapter_diag "unreadable status for ${_name}: [${_status}]"
                _rc=2
                continue
                ;;
        esac

        printf '%s\t%s\t%s\t%s\n' "${_name}" "${_emu}" "${_astart}" "${_int}"
    done

    return "${_rc}"
}

# contract: adapter_guest_list() -> name<TAB>type<TAB>astart<TAB>status<TAB>running [list: may be empty]
#
# Every guest this node has, jails and bhyve VMs together. A node with no
# guests prints nothing and exits 0: this is a list, and an empty list is an
# answer, not a crash (which is why the contract marker above says so).
#
# TWO listings, not one. `cbsd jls` shows only jail-shaped emulators -- its
# query is `WHERE ( emulator='jail' OR emulator='qemu-*-static' )`
# (jailctl/jls:244) and it `continue`s over bhyve and virtualbox rows
# (jailctl/jls:264-265) -- while `cbsd bls` shows only `WHERE emulator='bhyve'`
# (bhyvectl/bls:367). Listing guests with jls alone is how a fleet of VMs comes
# to look empty.
#
# `running` is asked per guest through adapter_guest_running rather than
# inferred from `status`, because a guest held in slave mode reports status 2
# whether it is running or not (subr/rcconf.subr:195-203 corrects the stored
# status against reality only when it is 0 or 1). A guest whose running state
# cannot be determined fails the whole listing: an estate in which one guest is
# reported stopped because the question could not be answered is the estate a
# split brain is built on.
adapter_guest_list()
{
    local _cmd _out _rc _rows _row _name _running _prc _oifs

    _adapter_ready || return 2

    _rows=""
    _rc=0

    for _cmd in jls bls; do
        _out=$( _adapter_cbsd "${_cmd}" header=0 \
            display=jname,emulator,astart,status )
        _prc=$?

        if [ "${_prc}" -ne 0 ]; then
            _adapter_diag "cbsd ${_cmd} failed (exit ${_prc})"
            return 1
        fi

        [ -n "${_out}" ] || continue

        _out=$( printf '%s\n' "${_out}" | _adapter_list_rows ) || _rc=2
        [ -n "${_out}" ] || continue

        if [ -z "${_rows}" ]; then
            _rows=${_out}
        else
            _rows="${_rows}
${_out}"
        fi
    done

    [ "${_rc}" -eq 0 ] || return "${_rc}"
    [ -n "${_rows}" ] || return 0

    # A 'for' over newline-split records rather than a 'while read' pipeline:
    # the running probe's verdict has to reach this shell, and the left-hand
    # side of a pipeline runs in a subshell that cannot report anything but its
    # own output. No field can contain a space or a newline -- every one of them
    # was validated by _adapter_list_rows -- so the split is exact.
    _oifs=$IFS
    IFS='
'
    # shellcheck disable=SC2086
    #   Deliberate word splitting on newline: ${_rows} is a list of records.
    for _row in ${_rows}; do
        IFS=$_oifs
        _name=${_row%%"${ADAPTER_TAB}"*}

        _running=$( adapter_guest_running "${_name}" )
        _prc=$?
        if [ "${_prc}" -ne 0 ]; then
            _adapter_diag "cannot determine whether ${_name} is running (exit ${_prc})"
            IFS=$_oifs
            return "${_prc}"
        fi

        printf '%s\t%s\n' "${_row}" "${_running}"
        IFS='
'
    done
    IFS=$_oifs

    return 0
}

# _adapter_guest_row <name>
#
# CBSD's own listing row for ONE guest -- "name<TAB>type<TAB>astart<TAB>status"
# -- or nothing. rc 0 with the row, 1 this node has no such usable guest, 2 the
# listing could not be read.
#
# `cbsd jls` and `cbsd bls` are asked in turn for the same reason
# adapter_guest_list asks both: each shows only its own emulators
# (jailctl/jls:244, bhyvectl/bls:367), so a VM is invisible to the first and a
# jail to the second.
#
# THE ANSWER IS FILTERED BY NAME HERE, not only by `jname=`, and that is not
# belt and braces. jls's `jname=` predicate reaches its SQL area only: the
# unregistered area (jailctl/jls:281-296) walks every readable file in
# ${jailrcconfdir} and prints a row for each, whatever was asked for. Observed
# live on CBSD 15.0.9 (tests/tier5, docs/cbsd-module-notes.md §8.8): with a
# jails-rcconf/rc.conf_web01 left behind by an earlier junregister,
# `cbsd jls jname=nosuchguest` prints web01's row. Filtering the raw listing
# before it is parsed also means _adapter_list_rows' contract errors are about
# the guest that was asked about and not about some other guest's leftovers.
_adapter_guest_row()
{
    local _name _cmd _out _row _n

    _name=$1

    for _cmd in jls bls; do
        _out=$( _adapter_cbsd "${_cmd}" header=0 \
            display=jname,emulator,astart,status jname="${_name}" ) || _out=""

        [ -n "${_out}" ] || continue

        # The listing is whitespace-aligned, so the first field is the jname.
        _out=$( printf '%s\n' "${_out}" | awk -v n="${_name}" '$1 == n' )
        [ -n "${_out}" ] || continue

        _row=$( printf '%s\n' "${_out}" | _adapter_list_rows ) || return 2
        [ -n "${_row}" ] || continue

        _n=$( printf '%s\n' "${_row}" | wc -l | tr -d ' ' )
        if [ "${_n}" -ne 1 ]; then
            _adapter_diag "cbsd ${_cmd} listed ${_n} usable rows for ${_name}"
            return 2
        fi

        printf '%s\n' "${_row}"
        return 0
    done

    return 1
}

# contract: adapter_guest_type(name) -> bhyve|jail [promises output]
#
# The emulator column of the guest's own listing row. rc 1 both for a guest
# this node does not have and for a guest running under an emulator seance does
# not support -- in either case there is nothing here for seance to promote,
# and _adapter_list_rows has already named the unsupported one on stderr.
#
# NOT `cbsd emulator <name>`, which cannot answer at all on a modern SQLite.
# tools/emulator:13 asks `SELECT emulator FROM jails WHERE jname=\"${jname}\"`,
# and SQLite has rejected double-quoted string literals since the DQS default
# changed: FreeBSD 15.1 ships sqlite 3.53.3, where that query is "no such
# column: web01". Through CBSD's own cbsdsqlro builtin the parse error is
# swallowed and the result is EMPTY WITH rc 0, so `cbsd emulator web01` prints
# "No such instance" and exits 1 for a jail that exists. Measured in the guest
# (docs/cbsd-module-notes.md §8.7, tests/tier5). Every listing seance uses --
# jls, bls, jstatus, jswmode -- quotes its literals with single quotes and is
# unaffected, which is why the row is read from the listing instead.
adapter_guest_type()
{
    local _name _row _rc

    _adapter_ready || return 2

    _name=${1:-}
    if ! _adapter_name_ok "${_name}"; then
        _adapter_diag "adapter_guest_type: not a usable guest name: [${_name}]"
        return 2
    fi

    _row=$( _adapter_guest_row "${_name}" )
    _rc=$?

    if [ "${_rc}" -eq 1 ]; then
        _adapter_diag "no such guest on this node: ${_name}"
        return 1
    fi

    [ "${_rc}" -eq 0 ] || return 2

    # Field 2 of the parsed row, which _adapter_list_rows has already limited
    # to jail or bhyve.
    _row=${_row#*"${ADAPTER_TAB}"}

    printf '%s\n' "${_row%%"${ADAPTER_TAB}"*}"
}

# contract: adapter_guest_running(name) -> 1|0 [promises output]
#
# CBSD's own view of liveness, for both types, from one command.
# `cbsd jstatus jname=<n>` sources rcconf.subr and prints ${myjid}
# (jailctl/jstatus:41-47). rcconf.subr computes that jid against reality
# rather than against the database: for a jail from cbsdjls
# (subr/nc.subr:19-45, get_jid), for a bhyve VM from the existence of
# /dev/vmm/<name> (subr/rcconf.subr:117-127). A non-zero jid is a running
# guest.
#
# THE EXIT CODE IS INVERTED. jstatus documents "0: no jail, 1: jail exist"
# (jailctl/jstatus:5) -- so `invert=1`, which swaps them (jailctl/jstatus:27-33),
# is used here to get the ordinary meaning back: 0 the guest exists, 1 it does
# not. Relying on the inverted form is how a caller comes to read "absent" as
# success.
#
# rc 1 when this node has no such guest; rc 2 when jstatus claims the guest
# exists and prints nothing -- empty output with a success status, which is a
# contract violation and never a "no".
adapter_guest_running()
{
    local _name _out _rc

    _adapter_ready || return 2

    _name=${1:-}
    if ! _adapter_name_ok "${_name}"; then
        _adapter_diag "adapter_guest_running: not a usable guest name: [${_name}]"
        return 2
    fi

    _out=$( _adapter_cbsd jstatus jname="${_name}" invert=1 )
    _rc=$?

    if [ "${_rc}" -eq 1 ]; then
        _adapter_diag "no such guest on this node: ${_name}"
        return 1
    fi

    if [ "${_rc}" -ne 0 ]; then
        _adapter_diag "cbsd jstatus failed for ${_name} (exit ${_rc})"
        return 2
    fi

    case "${_out}" in
        ''|*[!0123456789]*)
            _adapter_diag "cbsd jstatus said ${_name} exists and printed [${_out}] instead of a jid"
            return 2
            ;;
    esac

    if [ "${_out}" = "0" ]; then
        printf '0\n'
    else
        printf '1\n'
    fi

    return 0
}

# ---------------------------------------------------------------------------
# Guests: lifecycle
# ---------------------------------------------------------------------------

# _adapter_lifecycle <jail-verb> <bhyve-verb> <name>
#
# Dispatch a lifecycle verb by guest type. inter=0 everywhere: CBSD's start and
# stop scripts open an interactive selector when they are given no target
# (sudoexec/jstop:38-40, sudoexec/bstop:44-46), and a promotion that stops to
# ask a question is a promotion that never finishes.
_adapter_lifecycle()
{
    local _jverb _bverb _name _type _verb _rc

    _jverb=$1
    _bverb=$2
    _name=${3:-}

    if ! _adapter_name_ok "${_name}"; then
        _adapter_diag "${_jverb}: not a usable guest name: [${_name}]"
        return 2
    fi

    _type=$( adapter_guest_type "${_name}" ) || return 1

    case "${_type}" in
        jail)  _verb=${_jverb} ;;
        bhyve) _verb=${_bverb} ;;
        *)
            _adapter_diag "${_name}: unsupported type ${_type}"
            return 1
            ;;
    esac

    _adapter_cbsd_act "${_verb}" jname="${_name}" inter=0
    _rc=$?

    if [ "${_rc}" -ne 0 ]; then
        _adapter_diag "cbsd ${_verb} ${_name} failed (exit ${_rc})"
        return 1
    fi

    return 0
}

# contract: adapter_guest_start(name) -> nothing [no output]
adapter_guest_start()
{
    _adapter_ready || return 2

    _adapter_lifecycle jstart bstart "${1:-}"
}

# contract: adapter_guest_stop(name) -> nothing [no output]
#
# Graceful by construction on both paths: `cbsd bstop` sends the ACPI signal
# and waits hard_timeout seconds (30 by default) before killing the bhyve
# process -- `noacpi=0` is the default (sudoexec/bstop:11-14,49-50) -- and
# `cbsd jstop` runs the jail's shutdown sequence unless it is asked for
# `fast=1` (sudoexec/jstop:16). seance asks for neither escape hatch.
adapter_guest_stop()
{
    _adapter_ready || return 2

    _adapter_lifecycle jstop bstop "${1:-}"
}

# _adapter_rehome_rcconf <src> <dst> <nodename>
#
# Copy a guest's registration file with its `nodename` set to THIS node.
#
# WHY A PROMOTED GUEST MUST BE RE-HOMED (D-184, found by drill-guest on the
# fleet). The configuration a promotion registers from is the DEAD node's copy
# -- that is the whole point of replicating it (D-82) -- and one of the fields
# in it says which node hosts the guest. CBSD believes that field: registering
# 2c's rc.conf on 2b files the guest as 2c's, and a clustered node lists
# another node's guests with an empty emulator, which is exactly the row
# `adapter_guest_list` skips as "not local to this node" (D-177). The estate
# arrives, mounts and registers, and then seance's own hardening hides the
# guest from seance. `adapter_guest_start` says "no such guest on this node"
# about a guest whose datasets are mounted under it.
#
# So the inherited configuration is REHOMED before it is handed to the
# platform: everything else in it is the guest's own description and is left
# exactly as it was. This is the read-don't-derive family's sibling -- the
# configuration travelled, and one field in it describes where it used to
# live.
#
# The rewrite is a line rewrite and not a source-and-re-emit: seance parses
# this file, it never executes it (handoff §2.2), and a re-emitted file would
# be seance's opinion of the guest rather than the platform's record of it.
_adapter_rehome_rcconf()
{
    local _src _dst _nn

    _src=$1
    _dst=$2
    _nn=$3

    [ -r "${_src}" ] || return 1
    [ -n "${_nn}" ] || return 1

    # A nodename with a double quote or a newline in it cannot be written back
    # safely, and a platform that produced one is not one seance guesses about.
    case "${_nn}" in
        *'"'*)     return 1 ;;
        *"\\"*)  return 1 ;;
    esac

    awk -v nn="${_nn}" '
        BEGIN { done = 0 }
        {
            line = $0
            sub(/^[ \t]*/, "", line)
            if (index(line, "nodename=") == 1) {
                if (done) next
                printf "nodename=\"%s\";\n", nn
                done = 1
                next
            }
            print $0
        }
        END { if (!done) printf "nodename=\"%s\";\n", nn }
    ' "${_src}" > "${_dst}" || return 1

    [ -s "${_dst}" ] || return 1

    return 0
}

# contract: adapter_guest_register(name,rcfile) -> nothing [no output]
#
# `cbsd jregister jname=<n> rcfile=<f>` inserts the environment's settings into
# the node's database from a plain-text rc.conf (sudoexec/jregister:5,20-31) --
# which is exactly what a replicated jails-system directory carries. It is used
# for bhyve guests too: `cbsd bregister` is a stub that execs a sudoexec script
# the distribution does not ship (docs/cbsd-module-notes.md §8.1), so it cannot
# be part of any path seance takes.
adapter_guest_register()
{
    local _name _rcfile _rc _self _tmp _dir _own _mode

    _adapter_ready || return 2

    _name=${1:-}
    _rcfile=${2:-}

    if ! _adapter_name_ok "${_name}"; then
        _adapter_diag "adapter_guest_register: not a usable guest name: [${_name}]"
        return 2
    fi

    if [ -z "${_rcfile}" ]; then
        _adapter_diag "adapter_guest_register: no rcfile given for ${_name}"
        return 2
    fi

    if [ ! -r "${_rcfile}" ]; then
        _adapter_diag "adapter_guest_register: no readable rcfile at ${_rcfile}"
        return 1
    fi

    # REGISTERED AS THIS NODE'S, whatever the file says (D-184). An inherited
    # configuration names the node it came from, and the platform believes it.
    _self=$( adapter_fact nodename ) || _self=""
    if [ -z "${_self}" ]; then
        _adapter_diag "adapter_guest_register: this node cannot say its own CBSD" \
            "nodename, so it cannot register ${_name} as its own"
        return 1
    fi

    # THE COPY IS SHAPED LIKE THE FILE CBSD EXPECTS. The canonical argument is
    # ${jailsysdir}/<n>/rc.conf_<n> (module notes §5); `jregister` runs
    # `replacewdir` OVER the file before it reads anything
    # (sudoexec/jregister:151), rewriting the CBSDROOT token in place, and then
    # MOVES the file into ${jailsysdir}/<n>/ (jregister:215). So the copy gets a
    # private directory, the platform's own file name inside it, and the
    # source's ownership and mode -- as readable as the file it copies, no more,
    # and writable by the same hands.
    #
    # This is faithfulness to a documented interface rather than a fix for an
    # observed failure: a plain scratch file was not measured to break anything,
    # and the tier-5 failure that first looked like evidence for it was a broken
    # fixture copying from a path jregister had already moved.
    _dir=$( mktemp -d -t seance-rehome 2>/dev/null ) || {
        _adapter_diag "adapter_guest_register: cannot make a scratch directory to" \
            "re-home ${_name}'s registration"
        return 1
    }
    _tmp="${_dir}/rc.conf_${_name}"

    if ! _adapter_rehome_rcconf "${_rcfile}" "${_tmp}" "${_self}"; then
        rm -rf "${_dir}"
        _adapter_diag "adapter_guest_register: cannot re-home ${_rcfile} onto" \
            "${_self}; nothing was registered"
        return 1
    fi

    # Traversable, and then the file made to match its original exactly.
    chmod 0755 "${_dir}" 2>/dev/null
    _own=$( stat -L -f '%u:%g' "${_rcfile}" 2>/dev/null ) || _own=""
    _mode=$( stat -L -f '%Lp' "${_rcfile}" 2>/dev/null ) || _mode=""
    [ -n "${_own}" ] && chown "${_own}" "${_tmp}" 2>/dev/null
    [ -n "${_mode}" ] && chmod "${_mode}" "${_tmp}" 2>/dev/null

    _adapter_cbsd_act jregister jname="${_name}" rcfile="${_tmp}"
    _rc=$?
    rm -rf "${_dir}"

    if [ "${_rc}" -ne 0 ]; then
        _adapter_diag "cbsd jregister ${_name} failed (exit ${_rc})"
        return 1
    fi

    return 0
}

# contract: adapter_guest_unregister(name) -> nothing [no output]
#
# AND IT TIDIES UP AFTER THE PLATFORM, which is not optional.
# `cbsd junregister` dumps the database row it is about to delete into
# ${jailrcconfdir}/rc.conf_<name> as it goes (sudoexec/junregister:128-146:
# `jmkrcconf jname=<n> > ${jailrcconfdir}/rc.conf_<n>`, then replacewdir to
# tokenise the workdir), and nothing ever removes it: `cbsd jregister` MOVES
# the file it reads into ${jailsysdir}/<name>/ (sudoexec/jregister:215), so a
# guest registered from a replica the way promote registers one
# (`rcfile=<replica>/rc.conf_<n>`) never consumes the leftover.
#
# What the leftover costs, measured in the guest (docs/cbsd-module-notes.md
# §8.8, and D-97 already leans on it): jls's unregistered area walks every file
# in ${jailrcconfdir} and prints a row for each, outside every predicate
# (jailctl/jls:281-296). So one failback leaves this node printing a phantom
# row for that guest in every listing for ever -- and adapter_guest_list, doing
# exactly what it should with a status word of "Unregister", says
# "skipping <g>: CBSD's database does not know it" on stderr on every tick,
# every status, every gate. A diagnostic that is always there is a diagnostic
# nobody reads.
#
# Nothing that predated the call is destroyed by the removal: a *registered*
# guest cannot have a file there (jregister moved it away when it registered
# the guest), and a guest that is not registered cannot be unregistered
# (sudoexec/junregister:105-114 refuses with "Already unregistered"). The file
# removed is therefore always one this very call caused to be written.
#
# NOT `junregister jname=<n> destroy=1`, which skips the dump entirely
# (sudoexec/junregister:134) and would look like the tidier fix. That option is
# undocumented in junregister's own ADDHELP, it is the flag CBSD's *destroy*
# paths pass (sudoexec/jdestroy:201, sudoexec/bdestroy:275), and its name says
# what a future release might make it mean. seance does not put a word like
# that on a command line in the middle of a failback to save an rm.
adapter_guest_unregister()
{
    local _name _rc _rcconf

    _adapter_ready || return 2

    _name=${1:-}
    if ! _adapter_name_ok "${_name}"; then
        _adapter_diag "adapter_guest_unregister: not a usable guest name: [${_name}]"
        return 2
    fi

    _adapter_cbsd_act junregister jname="${_name}"
    _rc=$?

    if [ "${_rc}" -ne 0 ]; then
        _adapter_diag "cbsd junregister ${_name} failed (exit ${_rc})"
        return 1
    fi

    _rcconf="${ADAPTER_JAILRCCONFDIR}/rc.conf_${_name}"
    if [ -e "${_rcconf}" ]; then
        if ! rm -f "${_rcconf}"; then
            _adapter_diag "${_name} was unregistered but its leftover export ${_rcconf} could not be removed; every listing on this node will carry a phantom row for it"
            return 1
        fi
        _adapter_diag "removed ${_rcconf}, the export junregister wrote as it ran"
    fi

    return 0
}

# ---------------------------------------------------------------------------
# Guests: the boot gate (decision D-21)
# ---------------------------------------------------------------------------

# _adapter_swmode <name> <master|slave>
#
# `cbsd jswmode jname=<n> mode=slave` is UPDATE jails SET status=2, and
# mode=master is status=0 (jailctl/jswmode:87-102). A guest at status 2 cannot
# be started -- sudoexec/jstart:367 and sudoexec/bstart:1321 refuse it with
# "Jail in slave mode" -- and CBSD's own autostart ordering selects only
# status<2 (jailctl/jorder:35, bhyvectl/border:35). That is the lever, and it
# survives a reboot because it is in the database.
_adapter_swmode()
{
    local _name _mode _rc

    _name=${1:-}
    _mode=${2:-}

    if ! _adapter_name_ok "${_name}"; then
        _adapter_diag "jswmode: not a usable guest name: [${_name}]"
        return 2
    fi

    _adapter_cbsd_act jswmode jname="${_name}" mode="${_mode}" inter=0
    _rc=$?

    if [ "${_rc}" -ne 0 ]; then
        _adapter_diag "cbsd jswmode ${_name} mode=${_mode} failed (exit ${_rc})"
        return 1
    fi

    return 0
}

# contract: adapter_guest_hold(name) -> nothing [no output]
adapter_guest_hold()
{
    _adapter_ready || return 2

    _adapter_swmode "${1:-}" slave
}

# contract: adapter_guest_release(name) -> nothing [no output]
adapter_guest_release()
{
    _adapter_ready || return 2

    _adapter_swmode "${1:-}" master
}

# contract: adapter_guest_held(name) -> 1|0 [promises output]
#
# Held means status 2, which is what mode=slave writes. The status is read back
# through `cbsd jls`/`cbsd bls` rather than from the database directly, so that
# there is exactly one place in seance that knows how CBSD spells a status --
# _adapter_guest_row, which is also the one place that knows a per-guest
# listing has to be filtered by name.
adapter_guest_held()
{
    local _name _row _rc _status

    _adapter_ready || return 2

    _name=${1:-}
    if ! _adapter_name_ok "${_name}"; then
        _adapter_diag "adapter_guest_held: not a usable guest name: [${_name}]"
        return 2
    fi

    _row=$( _adapter_guest_row "${_name}" )
    _rc=$?

    if [ "${_rc}" -eq 1 ]; then
        _adapter_diag "no such guest on this node: ${_name}"
        return 1
    fi

    [ "${_rc}" -eq 0 ] || return 2

    _status=${_row##*"${ADAPTER_TAB}"}

    if [ "${_status}" = "2" ]; then
        printf '1\n'
    else
        printf '0\n'
    fi

    return 0
}

# ---------------------------------------------------------------------------
# Guests: storage
# ---------------------------------------------------------------------------

# contract: adapter_guest_sysdir(name) -> path [promises output]
#
# ${jailsysdir}/<name>: the per-guest system directory CBSD creates at
# jcreate time and fills with rc.conf_<name>, the hook directories and
# local.sqlite (sudoexec/jcreate:710-729). It is the directory that has to
# travel with a guest for a survivor to be able to register it, so seance
# replicates it and promote reads it back from here.
#
# The path is derived, not probed: this function answers "where would it be",
# and the caller that needs it to exist says so itself.
adapter_guest_sysdir()
{
    local _name

    _adapter_ready || return 2

    _name=${1:-}
    if ! _adapter_name_ok "${_name}"; then
        _adapter_diag "adapter_guest_sysdir: not a usable guest name: [${_name}]"
        return 2
    fi

    printf '%s/%s\n' "${ADAPTER_JAILSYSDIR}" "${_name}"
}

# contract: adapter_guest_mountpoint(name,type) -> path [promises output]
#
# Where this platform's creation scripts put a guest of this TYPE -- the
# convention, not the layout, and the difference is D-178's whole subject.
#
# IT IS THE LAST RESORT AND NO LONGER THE ANSWER (D-181). The promotion
# ceremony asks the guest's own configuration where its data belongs
# (adapter_config_data_path, read out of the replicated rc.conf before
# anything is mounted) and mounts the replica THERE; a fleet whose VMs live on
# the jail-shaped path is a fleet this convention would send a replica to a
# directory the platform never looks in. What is left for this function is the
# guest whose configuration states no data path at all -- the schema's default
# is "0" (share/local-jails.schema:39) -- and the promote note says so when it
# is used.
#
# EVIDENCE, both cited to the scripts that create the datasets in the first
# place, so that seance and CBSD cannot disagree about where a guest lives:
#
#   jail    ${jaildatadir}/<name>-data
#           `zfs create ... -o mountpoint=${jaildatadir}/${jname}-data
#            ${ZPOOL}/${jname}` -- sudoexec/mkdatadir:20-21, with the "-data"
#           suffix being ${jaildatapref}, cbsd.conf:70 jaildatapref="data".
#   bhyve   ${workdir}/vm/<name>
#           `zfs create -o mountpoint=${workdir}/vm/${jname} ${DATA}/${jname}`
#           -- sudoexec/bcreate:579, and :595-597 makes that path the guest's
#           own `data=` field.
#
# rc 2 for a type this adapter does not support: a guess here would mount a
# replica over something else's directory.
adapter_guest_mountpoint()
{
    local _name _type

    _adapter_ready || return 2

    _name=${1:-}
    _type=${2:-}

    if ! _adapter_name_ok "${_name}"; then
        _adapter_diag "adapter_guest_mountpoint: not a usable guest name: [${_name}]"
        return 2
    fi

    case "${_type}" in
        jail)  printf '%s/%s-data\n' "${ADAPTER_JAILDATADIR}" "${_name}" ;;
        bhyve) printf '%s/vm/%s\n' "${ADAPTER_WORKDIR}" "${_name}" ;;
        *)
            _adapter_diag "adapter_guest_mountpoint: unsupported guest type: [${_type}]"
            return 2
            ;;
    esac

    return 0
}

# contract: adapter_guest_links(name,type,datapath) -> link<TAB>target per line [list: may be empty]
#
# The symlinks this platform needs in place before a guest whose data arrived
# by replication can be registered and started here. One record per link, the
# link first and what it must point at second; an empty list is a valid answer
# and is what a jail produces.
#
# <datapath> is where the guest's data IS -- what the ceremony mounted the
# replica at, which is the guest's own `data=` (D-181) and not a path this
# function may work out for itself. It is an argument for the reason the whole
# of D-178 exists: CBSD's own links are made to ${data}, whatever ${data} is,
# and computing it here from the type's creation convention is how a link ends
# up pointing at a directory nothing is mounted on.
#
# EVIDENCE. CBSD makes two symlinks to a VM's data directory at creation time
# -- sudoexec/bcreate:598-599,
#
#     ln -sf ${data} ${olddata}                 # jails-data/<name>-data
#     ln -sf ${data} ${jailsysdir}/${jname}     # jails-system/<name>
#
# with data=${workdir}/vm/${jname} (:595) and olddata=${jaildatadir}/${jname}-data
# (:593). CBSD's own receive path restores the second of them after a transfer
# (sudoexec/zfs-recv:66-69), which is the same ceremony this list describes.
# A jail needs neither: its dataset is mounted where CBSD looks for it.
#
# A LINK WHOSE PATH IS ITS OWN TARGET IS NOT A LINK, and it is exactly what a
# VM on the jail-shaped layout would produce here: ${jaildatadir}/<name>-data
# is then the data directory itself. CBSD only makes that link in the branch
# where the two differ (bcreate:594-598, olddata is captured BEFORE data is
# moved to ${workdir}/vm/<name>), and `ln -sf X X` where X is a mounted
# directory does not fail -- it puts a link INSIDE it. Such a record is left
# out.
#
# The per-disk /dev/zvol symlinks are NOT here: they are computed from the
# replica's own volume list by whoever is doing the promoting, because their
# names come from the datasets rather than from the platform
# (sudoexec/zfs-recv:82-93).
adapter_guest_links()
{
    local _name _type _mp _link

    _adapter_ready || return 2

    _name=${1:-}
    _type=${2:-}
    _mp=${3:-}

    if ! _adapter_name_ok "${_name}"; then
        _adapter_diag "adapter_guest_links: not a usable guest name: [${_name}]"
        return 2
    fi

    case "${_mp}" in
        /*) ;;
        *)
            _adapter_diag "adapter_guest_links: not an absolute data path: [${_mp}]"
            return 2
            ;;
    esac

    case "${_type}" in
        jail)
            return 0
            ;;
        bhyve)
            printf '%s/%s\t%s\n' "${ADAPTER_JAILSYSDIR}" "${_name}" "${_mp}"

            _link="${ADAPTER_JAILDATADIR}/${_name}-data"
            [ "${_link}" = "${_mp}" ] && return 0
            printf '%s\t%s\n' "${_link}" "${_mp}"
            return 0
            ;;
        *)
            _adapter_diag "adapter_guest_links: unsupported guest type: [${_type}]"
            return 2
            ;;
    esac
}

# _adapter_data_field <name>
#
# Read a `header=0 display=jname,data` listing on stdin and print the DATA path
# of <name>'s own row -- CBSD's answer to "where does this guest's data live",
# recorded per guest at creation and carried in its rc.conf ever since:
#
#   jail   data="${jaildatadir}/${jname}-${jaildatapref}"
#          (etc/defaults/jail-freebsd-default.conf:102, written into the
#          guest's rcconf by sudoexec/jcreate:806-814)
#   bhyve  data="${workdir}/vm/${jname}"  (sudoexec/bcreate:595)
#
# THE DEFAULTS ARE NOT THE CONTRACT, WHICH IS THE WHOLE POINT (D-171(b)). On a
# real fleet every guest is a bhyve VM whose data lives at
# ${jaildatadir}/<jname>-data -- the jail-shaped path -- and any code that
# computed the VM path from the creation script's convention looked in the
# wrong place. The field is READ instead.
#
# Only a row whose data field is an ABSOLUTE PATH answers. A clustered node's
# listing carries a row per node and the remote ones cannot fill this field
# (D-177): they print "0" or "-", and are passed over here rather than mistaken
# for a path.
_adapter_data_field()
{
    awk -v n="${1:?}" '$1 == n && $2 ~ /^\// { print $2; exit }'
}

# contract: adapter_guest_data_path(name) -> path [promises output]
#
# CBSD's own answer to where this guest's data is: the `data` field of its
# registration, read through both listings for adapter_guest_list's reason --
# each shows only its own emulators, so a VM is invisible to the first and a
# jail to the second.
#
# rc 1 and nothing when the platform does not say: a guest this node does not
# have, a guest whose registration carries no data field (the schema default
# "0"), or a clustered node's remote row, whose unfillable fields print as "0"
# or "-" and are passed over rather than mistaken for a path (D-177).
#
# It is READ AFTER A PROMOTION as well as before one, and that is the point of
# it being public: the ceremony mounts a replica where the guest's own
# configuration says its data lives, and this is how the platform is asked
# afterwards whether it agrees -- an observation, where the comparison used to
# be against a path derived from a type (D-181).
adapter_guest_data_path()
{
    local _name _cmd _out _val

    _adapter_ready || return 2

    _name=${1:-}
    if ! _adapter_name_ok "${_name}"; then
        _adapter_diag "adapter_guest_data_path: not a usable guest name: [${_name}]"
        return 2
    fi

    for _cmd in jls bls; do
        _out=$( _adapter_cbsd "${_cmd}" header=0 display=jname,data \
            jname="${_name}" ) || _out=""
        [ -n "${_out}" ] || continue

        _val=$( printf '%s\n' "${_out}" | _adapter_data_field "${_name}" )
        [ -n "${_val}" ] || continue

        printf '%s\n' "${_val}"
        return 0
    done

    return 1
}

# _adapter_rcconf_value <file> <key>
#
# The value of <key> in one of CBSD's per-guest configuration files, PARSED
# and never sourced (handoff §2.2 applies to every file seance reads).
#
# THE SHAPE, from the generator rather than from memory. `cbsd jmkrcconf`
# writes one assignment per line, quoted and semicolon-terminated --
# jailctl/jmkrcconf:27-35 prints `relative_path="1";` and then
# `echo "${i}=\"${VAL}\";"` per column -- and the file is later SOURCED by the
# platform (sudoexec/jregister:154). A sourced file's LAST assignment is the
# one that takes effect, so the last is what is read here; taking the first
# would answer with a value the platform does not use.
#
# Empty output for a key that is absent, and rc is awk's.
_adapter_rcconf_value()
{
    awk -v k="${2:?}" -v q="'" '
        {
            line = $0
            sub(/^[ \t]*/, "", line)
            if (index(line, k "=") != 1) next

            v = substr(line, length(k) + 2)
            sub(/;[ \t]*$/, "", v)
            sub(/[ \t]*$/, "", v)

            if (length(v) > 1) {
                f = substr(v, 1, 1)
                l = substr(v, length(v), 1)
                if ((f == "\"" && l == "\"") || (f == q && l == q))
                    v = substr(v, 2, length(v) - 2)
            }

            last = v
            found = 1
        }
        END { if (found) print last }
    ' "${1:?}"
}

# _adapter_path_usable <path>
#
# rc 0 for a value seance is willing to mount a replica at: an absolute path,
# not the root filesystem itself, with no whitespace and no ".." component.
#
# Each refusal is a mount that would go somewhere nobody meant. A relative path
# resolves against whatever directory the promotion happens to run in; "/" is
# the running system; whitespace cannot survive a `zfs set mountpoint=` written
# in this repository's style, nor a tab-separated record (handoff §2.3); and
# ".." is a traversal, which is not a place CBSD ever put a guest.
_adapter_path_usable()
{
    local _p

    _p=${1:-}

    case "${_p}" in
        /) return 1 ;;
        /*) ;;
        *) return 1 ;;
    esac

    case "${_p}" in
        *" "*|*"${ADAPTER_TAB}"*) return 1 ;;
        */../*|*/..) return 1 ;;
    esac

    return 0
}

# contract: adapter_config_data_path(rcfile) -> path [promises output]
#
# Where a guest's OWN configuration says its data lives, read out of the file
# this platform registers it from -- before anything has been mounted, which is
# the whole reason the promotion ceremony can ask it (D-181). The answer is the
# path the replica must be mounted at: mount it anywhere else and the platform
# starts a guest over an empty directory with its data sitting beside it.
#
#   rc 0  an absolute path, on stdout.
#   rc 1  the file states no data path at all -- the schema's default is "0"
#         (share/local-jails.schema:39) -- so the caller must fall back to this
#         platform's convention for the type (adapter_guest_mountpoint) and say
#         that it did.
#   rc 2  the file cannot be read, or it states something that is not a usable
#         absolute path. NOT a fallback: a configuration that names a place
#         seance will not mount a replica at is a refusal, because the two
#         readings of "data=usr/jails/..." differ by a directory tree.
#
# CBSDROOT IS THE PLATFORM'S OWN TOKEN AND IS RESOLVED THE PLATFORM'S WAY.
# `cbsd junregister` tokenises the workdir out of the file it dumps
# (sudoexec/junregister:140-141, `replacewdir ... old=${workdir} new="CBSDROOT"`)
# and `cbsd jregister` puts THIS node's workdir back before it registers
# anything (sudoexec/jregister:151, `replacewdir file0=... old="CBSDROOT"`,
# tools/replacewdir:22 `sed s:${old}:${workdir}:`). A ceremony that mounted the
# literal token's path would mount somewhere the registration is not about.
adapter_config_data_path()
{
    local _f _v

    _adapter_ready || return 2

    _f=${1:-}

    if [ -z "${_f}" ] || [ ! -r "${_f}" ]; then
        _adapter_diag "adapter_config_data_path: no readable configuration file: [${_f}]"
        return 2
    fi

    _v=$( _adapter_rcconf_value "${_f}" data ) || _v=""

    # "0" is the schema's default for a guest whose data path was never
    # recorded, and an empty value is a key that is not there at all. Neither
    # is a place; both are "this file does not say".
    case "${_v}" in
        ''|0|-) return 1 ;;
    esac

    case "${_v}" in
        CBSDROOT|CBSDROOT/*) _v="${ADAPTER_WORKDIR}${_v#CBSDROOT}" ;;
    esac

    if ! _adapter_path_usable "${_v}"; then
        _adapter_diag "adapter_config_data_path: ${_f} says data=[${_v}]," \
            "which is not a path a replica can be mounted at"
        return 2
    fi

    printf '%s\n' "${_v}"
    return 0
}

# _adapter_dataset_at <path>
#
# The dataset mounted EXACTLY at <path>, or rc 1 and a diagnostic naming both
# the path and the question that was asked.
#
# THE GUARD IS LOAD-BEARING: `zfs list <path>` answers with the dataset
# CONTAINING the path, not only with one mounted exactly there. Observed on the
# workstation: `zfs list -H -o name,mountpoint /data/jails` prints `zdata
# /data`, which is precisely why CBSD itself uses that form to find the POOL
# from ${jaildatadir} (sudoexec/mkdatadir:20). Without the guard a guest whose
# dataset is not mounted would resolve to the whole workdir dataset, and seance
# would snapshot, send and -- at promotion -- remount CBSD's entire estate.
_adapter_dataset_at()
{
    local _path _cand _mp

    _path=${1:?}

    _cand=$( zfs list -H -o name "${_path}" 2>/dev/null ) || _cand=""
    if [ -z "${_cand}" ]; then
        _adapter_diag "no ZFS dataset at ${_path}:" \
            "\"zfs list -H -o name ${_path}\" answered nothing"
        return 1
    fi

    _mp=$( zfs get -H -o value mountpoint "${_cand}" 2>/dev/null ) || _mp=""
    if [ "${_mp}" != "${_path}" ]; then
        _adapter_diag "${_path} is inside ${_cand}, which is mounted at" \
            "${_mp:-<unreadable>} -- it is not a dataset of its own." \
            "seance replicates datasets and will not guess one from a path"
        return 1
    fi

    printf '%s\n' "${_cand}"
    return 0
}

# contract: adapter_guest_datasets(name) -> dataset per line, root first [promises output]
#
# Every ZFS dataset belonging to the guest -- filesystems and volumes, the
# root of the tree first, then its children in ZFS's own order.
#
# OBSERVED, NEVER DERIVED, and D-171(b) is what that sentence cost. The old
# resolution fell back to a COMPUTED DATASET NAME -- <parent>/<name>, where
# <parent> is the dataset holding CBSD's jails-data directory, which is exactly
# how CBSD derives it when it CREATES a guest (sudoexec/mkdatadir:14-23). On
# the first real fleet every guest is a bhyve VM whose dataset is
# <parent>/jails-data/<name>-data -- the "-data" is part of the DATASET name,
# not only of the mountpoint -- and every discovery failed with "no dataset
# <parent>/<name>", for a guest sitting right there on disk. A creation
# convention is not a layout: seance may read where a guest lives, and may not
# work it out.
#
# So, in this order, and every step is something the platform or the mount
# table SAID:
#
#   1. CBSD's own `data` field for this guest (adapter_guest_data_path).
#      It is recorded per guest at creation and travels in its rc.conf, so it
#      is right for a guest CBSD made whatever convention it used, and right
#      after a promotion in place -- where the dataset is the REPLICA under
#      <standby_root>/<deadkey>/<name>, mounted at the path the guest's own
#      configuration names (D-44 item 4), which no derivation could ever reach.
#   2. Failing that, the path this platform's creation scripts put that TYPE's
#      data at (adapter_guest_mountpoint, built from CBSD's own jaildatadir and
#      workdir facts). This is a fallback for a guest whose `data` field is
#      blank -- the schema's default is "0" (share/local-jails.schema:39) --
#      and it is a PATH, which step 3 then checks against the mount table. It
#      can therefore fail to find a dataset; it cannot name the wrong one.
#   3. The dataset mounted exactly at whichever path answered
#      (_adapter_dataset_at). Anything else is a refusal naming the path.
#
# No pool name is written down anywhere here, which is what the tenant guard
# requires (D-6).
#
# rc 1 when the guest has no dataset at all -- a zfsfeat=0 node (mkdatadir:15-18
# makes a plain directory instead), a guest this node does not have, or a guest
# whose data path has no dataset of its own. seance requires ZFS-backed guests,
# and saying so loudly is the entire response.
adapter_guest_datasets()
{
    local _name _root _out _type _mp

    _adapter_ready || return 2

    _name=${1:-}
    if ! _adapter_name_ok "${_name}"; then
        _adapter_diag "adapter_guest_datasets: not a usable guest name: [${_name}]"
        return 2
    fi

    # 1. what CBSD says, and 2. what this platform's creation scripts would
    #    have used for this type. Both are paths; neither is a dataset name.
    _mp=$( adapter_guest_data_path "${_name}" ) || _mp=""

    if [ -z "${_mp}" ]; then
        _type=$( adapter_guest_type "${_name}" 2>/dev/null ) || _type=""
        if [ -n "${_type}" ]; then
            _mp=$( adapter_guest_mountpoint "${_name}" "${_type}" 2>/dev/null ) ||
                _mp=""
        fi
    fi

    if [ -z "${_mp}" ]; then
        _adapter_diag "adapter_guest_datasets: ${_name}: CBSD does not say where" \
            "its data lives (display=jname,data answered no path) and this node" \
            "cannot say what type it is, so there is nothing to look up." \
            "Nothing will be guessed"
        return 1
    fi

    # 3. the dataset mounted exactly there, or a refusal naming the path.
    _root=$( _adapter_dataset_at "${_mp}" ) || {
        _adapter_diag "adapter_guest_datasets: ${_name}: its data path ${_mp}" \
            "has no dataset of its own; seance replicates datasets"
        return 1
    }

    _out=$( zfs list -H -r -o name -t filesystem,volume "${_root}" 2>/dev/null ) ||
        _out=""

    if [ -z "${_out}" ]; then
        _adapter_diag "no dataset ${_root} for guest ${_name}"
        return 1
    fi

    printf '%s\n' "${_out}"
}

# ---------------------------------------------------------------------------
# CARP
# ---------------------------------------------------------------------------

# _adapter_carp_scan <vhid>
#
# Read ifconfig(8) output on stdin; print one line per carp block naming that
# vhid, "<STATE>", and one line "vrrp" per VRRPv3 block naming it.
#
# The format is pinned by ifconfig's source, not by memory:
# /usr/src/sbin/ifconfig/carp.c:86-90 prints
#     "\tcarp: %s vhid %d advbase %d advskew %d"
# and :102-105 prints "\tvrrp: %s vrid %d prio %d interval %d" for a vhid
# running VRRPv3 instead. The state word is carp_states[], defined in
# /usr/src/sys/netinet/ip_carp.h:171 as exactly "INIT", "BACKUP", "MASTER".
# What follows the advskew field has changed between releases (older ifconfig
# put the peer address at the end of the same line, newer prints a "peer" line
# of its own), so the match is anchored on the front of the line and reads no
# further than the vhid.
_adapter_carp_scan()
{
    awk -v vhid="$1" '
        $1 == "carp:" && $3 == "vhid" && $4 == vhid { print $2 }
        $1 == "vrrp:" && $3 == "vrid" && $4 == vhid { print "vrrp" }
    '
}

# contract: adapter_carp_state(vhid) -> MASTER|BACKUP|INIT|absent [promises output]
#
# What this node currently thinks it is for a CARP virtual host. `status` and
# `verify` read it; M1 ships no CARP *actions* of any kind.
#
# "absent" is a real answer -- the vhid is not configured on this node -- and
# is not an error. rc 1 is reserved for a vhid this node reports in two
# different states at once, which is a fault worth stopping for rather than
# averaging away.
adapter_carp_state()
{
    local _vhid _out _states _n

    _vhid=${1:-}

    if ! _adapter_vhid_ok "${_vhid}"; then
        _adapter_diag "adapter_carp_state: not a CARP vhid (1-255): [${_vhid}]"
        return 2
    fi

    _out=$( ifconfig -a 2>/dev/null ) || _out=""

    if [ -z "${_out}" ]; then
        _adapter_diag "ifconfig -a produced nothing"
        return 1
    fi

    _states=$( printf '%s\n' "${_out}" | _adapter_carp_scan "${_vhid}" |
        LC_ALL=C sort -u )

    case "${_states}" in
        *vrrp*)
            _adapter_diag "vhid ${_vhid} is running VRRPv3 on this node, not CARP"
            _states=$( printf '%s\n' "${_states}" | grep -v '^vrrp$' ) ||
                _states=""
            ;;
    esac

    if [ -z "${_states}" ]; then
        printf 'absent\n'
        return 0
    fi

    _n=$( printf '%s\n' "${_states}" | wc -l | tr -d ' ' )
    if [ "${_n}" -ne 1 ]; then
        _adapter_diag "vhid ${_vhid} is in more than one state on this node: $( printf '%s' "${_states}" | tr '\n' ' ' )"
        return 1
    fi

    case "${_states}" in
        MASTER|BACKUP|INIT)
            printf '%s\n' "${_states}"
            return 0
            ;;
    esac

    _adapter_diag "ifconfig reported an unknown CARP state for vhid ${_vhid}: [${_states}]"
    return 2
}
