# seance -- common helpers.
#
# Sourced, never executed. Nothing here knows anything about CBSD, ZFS or the
# host: this file is logging, exit discipline, temporary directories and the
# RC-capture pattern, and it stays that small.
#
# shellcheck shell=sh
# shellcheck disable=SC3043
#   'local' is not in POSIX sh but is implemented by FreeBSD /bin/sh (sh(1),
#   "local"); seance targets FreeBSD sh and nothing else (handoff §5).

# ---------------------------------------------------------------------------
# Logging and exit discipline
#
# stdout is data, stderr is diagnostics, the exit code is the verdict:
#   0 ok, 1 operation failed, 2 usage or contract error.
# ---------------------------------------------------------------------------

# seance_log <level> <message...>
#
# Level is a syslog level word (debug info notice warning err crit alert emerg).
# Always goes to stderr; additionally to syslog when logger(1) is present, so
# that an unattended promotion leaves a trail on a node nobody is watching.
seance_log()
{
    local _level _msg

    _level=${1:-info}
    [ $# -gt 0 ] && shift
    _msg=$*

    printf '%s: %s\n' "${_level}" "${_msg}" >&2

    if command -v logger >/dev/null 2>&1; then
        # Diagnostics only, never a verdict: a node with a wedged syslog must
        # still be able to promote a guest.
        logger -t seance -p "daemon.${_level}" -- "${_msg}" 2>/dev/null
    fi

    return 0
}

# seance_die <rc> <message...>
#
# Diagnose and stop. rc 1 = operation failed, rc 2 = usage or contract error.
seance_die()
{
    local _rc

    _rc=${1:-1}
    [ $# -gt 0 ] && shift

    seance_log err "$*"
    exit "${_rc}"
}

# seance_require_cmd <command> [command...]
#
# Fail with the contract-error code if a required external command is missing,
# naming every one that is absent rather than only the first.
seance_require_cmd()
{
    local _cmd _missing

    _missing=""
    for _cmd in "$@"; do
        command -v "${_cmd}" >/dev/null 2>&1 || _missing="${_missing} ${_cmd}"
    done

    [ -z "${_missing}" ] && return 0

    seance_die 2 "required command(s) not found:${_missing}"
}

# ---------------------------------------------------------------------------
# The RC-capture pattern
#
# FreeBSD /bin/sh has no 'pipefail': a pipeline's exit status is the *last*
# command's, so
#
#     zfs list -H | grep -q seance          # WRONG when zfs's verdict matters
#
# reports grep's opinion of a crashed zfs. Wherever the producer's verdict
# matters, run the producer through seance_rc_capture, which writes its status
# to a file the enclosing shell can read after the pipeline has finished:
#
#     _rcf="${SEANCE_TMPDIR}/rc.zfs"
#     seance_rc_capture "${_rcf}" zfs list -H -o name | while read -r _ds; do
#         ...
#     done
#     if [ "$( seance_rc_read "${_rcf}" )" -ne 0 ]; then
#         seance_die 1 "zfs list failed"
#     fi
#
# A file rather than a variable because the left-hand side of a pipeline runs
# in a subshell, whose variable assignments the parent never sees.
# ---------------------------------------------------------------------------

# seance_rc_capture <rcfile> <command> [args...]
#
# Run the command, write its exit status to <rcfile>, and return it too (which
# is useful outside a pipeline and discarded inside one).
seance_rc_capture()
{
    local _rcf _rc

    _rcf=$1
    shift

    "$@"
    _rc=$?

    printf '%s\n' "${_rc}" > "${_rcf}"
    return "${_rc}"
}

# seance_rc_read <rcfile>
#
# Print the captured status. A missing or unparsable file is itself a failure
# and prints a non-zero status rather than a reassuring zero -- a verdict that
# was never written must never read as success.
seance_rc_read()
{
    local _rcf _rc

    _rcf=$1
    _rc=""

    [ -r "${_rcf}" ] && read -r _rc < "${_rcf}"

    case "${_rc}" in
        ''|*[!0-9]*)
            printf '%s\n' 125
            return 0
            ;;
    esac

    printf '%s\n' "${_rc}"
}

# ---------------------------------------------------------------------------
# Temporary directories
#
# Registered in a file rather than in a shell variable so that a directory made
# inside a subshell -- a command substitution, the left half of a pipeline --
# is still cleaned up by the parent's EXIT trap.
# ---------------------------------------------------------------------------

# seance_tmp_init
#
# Call once, in the shell that owns the process, before any seance_tmpdir.
seance_tmp_init()
{
    SEANCE_TMP_REGISTRY=$( mktemp "${TMPDIR:-/tmp}/seance-reg.XXXXXX" ) ||
        seance_die 1 "cannot create temporary-directory registry"
    export SEANCE_TMP_REGISTRY

    trap 'seance_tmp_cleanup' EXIT
    trap 'seance_tmp_cleanup; exit 1' HUP INT TERM
}

# seance_tmpdir
#
# Print a fresh temporary directory, cleaned up by seance_tmp_cleanup.
seance_tmpdir()
{
    local _d

    [ -n "${SEANCE_TMP_REGISTRY:-}" ] ||
        seance_die 1 "seance_tmpdir called before seance_tmp_init"

    _d=$( mktemp -d "${TMPDIR:-/tmp}/seance.XXXXXX" ) ||
        seance_die 1 "cannot create temporary directory"

    printf '%s\n' "${_d}" >> "${SEANCE_TMP_REGISTRY}"
    printf '%s\n' "${_d}"
}

# seance_tmp_cleanup
#
# Remove every registered directory and the registry itself. Idempotent.
seance_tmp_cleanup()
{
    local _d

    [ -n "${SEANCE_TMP_REGISTRY:-}" ] || return 0
    [ -r "${SEANCE_TMP_REGISTRY}" ] || return 0

    while read -r _d; do
        case "${_d}" in
            /*/seance.*) rm -rf "${_d}" ;;
        esac
    done < "${SEANCE_TMP_REGISTRY}"

    rm -f "${SEANCE_TMP_REGISTRY}"
    return 0
}
