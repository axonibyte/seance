# seance -- the promotion ladder (design §7, decision D-44).
#
# Sourced, never executed. `seance promote <deadkey>` walks seven rungs. Every
# rung prints one line
#
#     rung <n> <name>: <verdict> — <reason>
#
# every rung can stop the whole thing, every mutating step prints its undo, and
# the verb ends in exactly one verdict line. Exit 0 promoted, 1 stopped
# (whether by an abort or by a notify), 2 a usage or configuration error.
#
#   0 arming      --auto only: the fleet key `auto` is 1 AND this node's own
#                 auto_promote names the corpse. Either alone is disarmed.
#   1 debounce    manual: n/a, because a human is the trigger. --auto: wait
#                 `debounce` seconds and then re-read CARP -- this node must
#                 still be MASTER for the dead node's vhid, or the link
#                 flapped and nothing died.
#   2 quorum      1 + reachable_others > N/2, or freeze and notify.
#   3 probes      ping and ssh the "dead" node. ANY answer aborts, and no
#                 --force can reach this rung.
#   4 fence       the configured driver, off <target>, bounded. Verified off
#                 proceeds; cannot-determine notifies; REFUSED aborts and pages
#                 and is never forceable.
#   5 lineage     per guest: whose it is, whether anybody else already claims
#                 it, whether the replica is fresh enough, and -- for jails --
#                 whether this fleet is kernel-homogeneous.
#                 On the AUTOMATIC path a guest whose actor is another node is
#                 `deferred` rather than `stand-down`, and the run pages with
#                 the command that node must run (D-130).
#   6 promotion   per guest, alphabetically: mount the replica in place at the
#                 paths the platform expects, relink, register, start, verify,
#                 record, report the RPO.
#   7 post        what the next replication tick will do, stated rather than
#                 configured.
#
# WHAT --force MAY NAME, and what it may never name (D-44 item 1). --force with
# no value means every forceable rung; --force=<rung>[,<rung>...] names them.
# The forceable rungs are quorum, fence, lineage and kernel. Naming `probes` is
# a usage error, not a refusal: there is no circumstance in which a host that
# answers should be fenced.
#
# --force=fence is the subtle one and it does NOT skip the fencing. A
# configured driver is run every time; what the force overrides is CANNOT
# DETERMINE -- no driver, no driver installed, an unreachable endpoint, a
# timeout, a success with nothing to say. A driver that answers REFUSED /
# STILL ON (rc 1) aborts regardless. A host that answers and a fence that
# failed are the two situations in which a forced promotion is precisely the
# split brain this product exists to prevent, and neither is expressible.
#
# Everything a force overrides says `forced` on its own rung line, so "force
# skips exactly the rungs it names" is readable in the log and is asserted row
# by row in tests/tier4/ladder.tsv.
#
# AND --force IS NOT EXPRESSIBLE WITH --auto. A force is a human accepting a
# rung that could not answer; --auto is a run with no human anywhere in it.
# Combining them is a usage error (exit 2), which is what makes "rungs 1-4 must
# all be green on the automatic path" (design §7) true by construction rather
# than by inspection.
#
# WHAT THIS FILE TOUCHES. Local ZFS only through lib/zfs.subr's wrappers, the
# platform only through the adapter, peers only through lib/transport.subr, and
# the clock only through pol_now. That is what lets tests/tier4/t_ladder.sh
# drive the whole ladder on a workstation with no disk, no peers and no CBSD:
# it stands in for the wrappers in its own shell rather than for the ladder.
#
# THE DEAD NODE IS NEVER ASKED ANYTHING except by the death probes, whose whole
# purpose is that it does not answer. Everything else comes from local disk,
# from this node's configuration, or from LIVING peers -- which the state model
# permits and the resurrection gate depends on (design §5).
#
# WHERE A REPLICA IS MOUNTED IS READ, NEVER DERIVED (D-178, D-181). Rung 6
# needs two things out of a guest's own configuration and takes both from the
# same file -- the one the platform is about to be handed to register it:
#
#   * WHERE ITS DATA BELONGS. `data=` in rc.conf_<guest>, read BEFORE anything
#     is mounted, out of a read-only scratch mount of whichever replica carries
#     the file (promote_mount_path). The platform's convention for the guest's
#     type is the LAST RESORT and says so in the note when it is used: on the
#     first real fleet every guest is a bhyve VM living on the jail-shaped
#     path, so a convention would have mounted every replica where nothing
#     looks for it.
#   * HOW TO REGISTER IT. `$( adapter_guest_sysdir <guest> )/rc.conf_<guest>`,
#     read AFTER the ceremony so that the path resolves into the replica for
#     anything whose configuration travels inside its own datasets -- a VM on
#     CBSD whose ${jailsysdir}/<name> is a symlink to its data directory
#     (sudoexec/bcreate:599), and every guest in the pseudo-cluster -- and out
#     of the dead node's configuration mirror for everything else, which is
#     what that mirror exists for (D-82): a jail's ${jailsysdir}/<name> is a
#     plain directory on CBSD's workdir dataset, outside the guest's own
#     dataset, and so is a VM's when it was created with mnt_start
#     (sudoexec/bcreate:549-566).
#
# The two reads are in that order and from the same source, which is the point:
# a path read from one file and a registration read from another are two
# opinions about where a guest lives, and the platform only ever acts on one.
#
# shellcheck shell=sh
# shellcheck disable=SC3043
#   'local' is not in POSIX sh but is implemented by FreeBSD /bin/sh (sh(1),
#   "local"); seance targets FreeBSD sh and nothing else (handoff §5).

# The rungs a --force may name. `probes` is deliberately absent (D-44 item 1).
PROMOTE_FORCEABLE="quorum fence lineage kernel"

# The separator in a rung line. Spelled once so that the log's grammar is one
# constant rather than a habit repeated eleven times.
PROMOTE_SEP=" — "

PROMOTE_TAB=$( printf '\t.' )
PROMOTE_TAB=${PROMOTE_TAB%.}

# A literal newline, for the one thing here that accumulates lines rather than
# printing them as it goes (PROMOTE_DEFERRED, read by promote_auto_report long
# after the guest that produced it was decided).
PROMOTE_NL='
'

# Set by promote_run and read by it, by the dispatcher and -- in tier 4 -- by
# the table driver, which is why they are named rather than passed: the ladder
# is one long decision and its outcome has several parts.
PROMOTE_DEAD=""             # the node key being succeeded
PROMOTE_FORCE=""            # the rungs an operator forced, space separated
PROMOTE_OPERATOR=""         # who said so
PROMOTE_EVIDENCE=""         # fence:<driver> | force:<operator>
PROMOTE_DISPOSITION=""      # proceed | abort | notify | force-only | deferred
                            #   | stand-down
PROMOTE_STOPPED_RUNG=""     # "<n> <name>" when the ladder stopped
PROMOTE_REACHABLE=""        # living peer keys, space separated
PROMOTE_UNREPORTED=""       # living peers that could NOT state their placement
PROMOTE_KERNEL=""           # same | differs | unknown
PROMOTE_KERNEL_DETAIL=""
PROMOTE_GUESTS_PROMOTED=0
PROMOTE_GUESTS_SEEN=0
PROMOTE_GUEST_DISPOSITIONS=""   # "<guest>=<disposition>" per guest, space sep
PROMOTE_DEFERRED=""             # one line per deferred guest: the command, and
                                # the node that has to run it (D-130)
PROMOTE_TMPDIR=""               # scratch for one run
PROMOTE_CONFIG_SOURCE=""        # the dataset a guest's rc.conf was read out of
PROMOTE_MOUNT_PATH=""           # where the guest being promoted is to be mounted
PROMOTE_AUTO=0                  # 1 when devd, not a human, is the trigger
PROMOTE_AUTO_VHID=""            # the vhid whose MASTER transition must still hold

# How long `promote-event` gives daemon(8) to detach the promotion. devd(8)
# runs an action with sh -c and WAITS for it (sbin/devd/devd.cc, my_system +
# do_action), so every path out of that verb is bounded; this is the last one.
#
# The bound is taken with seance_run_timeout_DETACH, not seance_run_timeout:
# timeout(1) reaps its command's descendants unless --foreground is given, so
# the ordinary wrapper would wait for the whole promotion and then kill it.
# Measured in the guest; lib/transport.subr carries the citation.
PROMOTE_EVENT_DETACH_TIMEOUT=10

# lockf(1) exits EX_TEMPFAIL when -t 0 could not take the lock (sysexits(3):
# EX_TEMPFAIL is 75; lockf(1) EXIT STATUS names it, and it was observed to be
# exactly this on FreeBSD 15). It is what "another one owns this" already means
# in this codebase -- lib/repl.subr says the same thing with the same number
# for a pair another tick is replicating -- and the promotion ladder speaks it
# for a corpse another ladder is already succeeding.
PROMOTE_RC_LOCKED=75

# status_age_human (lib/status.subr) is used to print the RPO. It is a
# formatting helper rather than a status concept -- an age read at three in the
# morning by somebody who has just been paged -- and duplicating it here to
# avoid the dependency would give the two verbs two ways of spelling the same
# number. bin/seance sources status.subr first.

# Set from --auto by promote_run. A promotion a human typed has already been
# debounced by the typing, so the manual path leaves this 0 and rung 1 reports
# n/a; tier 4 sets it directly to drive the wait without an --auto.
PROMOTE_DEBOUNCE_REQUIRED=0

# ---------------------------------------------------------------------------
# Reporting
# ---------------------------------------------------------------------------

# promote_rung <n> <name> <verdict> <reason...>
promote_rung()
{
    local _n _name _verdict

    _n=$1
    _name=$2
    _verdict=$3
    shift 3

    printf 'rung %s %s: %s%s%s\n' "${_n}" "${_name}" "${_verdict}" \
        "${PROMOTE_SEP}" "$*"
}

# promote_undo <command...>
#
# Printed BEFORE the step it undoes runs, so that a step which then wedges the
# terminal has already told the operator how to get back.
promote_undo()
{
    printf '  undo: %s\n' "$*"
}

# promote_one_line  -- stdin, rendered as ONE line fit to put in a rung line.
#
# What a fence driver prints is advisory: its EXIT STATUS is the verdict
# (D-44 item 2), and the text is interpolated into the rung line so that an
# operator can see what the endpoint said. A driver that answers with two
# hundred lines of chatter -- a web server's error page, a BMC's banner, a
# stack trace -- would otherwise print two hundred lines of rung, into a
# scrollback somebody is reading at 03:00 and into a log the tier-7 oracle
# parses a verdict out of.
#
# The first line is kept because that is where a driver puts its answer; the
# rest are COUNTED rather than dropped, so nothing disappears silently, and a
# single very long line is cut at 200 characters with the cut marked. Empty
# input stays empty: that is the contract violation the fence rung tests for,
# and it must not be turned into a sentence here.
promote_one_line()
{
    awk '
        NR == 1 { _first = $0 }
        END {
            if (NR == 0) { exit }
            _s = _first
            if (length(_s) > 200) { _s = substr(_s, 1, 200) "[cut]" }
            if (NR > 1) { _s = _s " (+" NR - 1 " more line(s) from the driver)" }
            print _s
        }
    '
}

# promote_note <message...>  -- a per-guest line that is not a rung verdict.
promote_note()
{
    printf '  %s\n' "$*"
}

# promote_forced <rung>  -- rc 0 if the operator forced this rung by name.
promote_forced()
{
    case " ${PROMOTE_FORCE} " in
        *" $1 "*) return 0 ;;
    esac

    return 1
}

# promote_operator  -- who is accountable for a --force.
#
# SUDO_USER first, because a promotion run under sudo was authorised by the
# human sudo names and not by root; then USER; then id -un, which is the only
# one of the three that cannot be set by whoever is running the command.
promote_operator()
{
    local _o

    _o=${SUDO_USER:-}
    [ -n "${_o}" ] || _o=${USER:-}
    [ -n "${_o}" ] || _o=$( id -un 2>/dev/null ) || _o=""
    [ -n "${_o}" ] || _o="unknown"

    printf '%s\n' "${_o}"
}

# promote_lock_path <deadnode>
#
# The ONE lock that says "one ladder per corpse, on this node" -- taken by the
# devd path (promote_event, below) and by the manual verb (bin/seance,
# seance_promote), which is why the name is built here and nowhere else: two
# paths that spelled the lock's name in two places would serialise against
# nothing the day one of them was edited, and the failure would be silent.
#
# rc 1 when this node cannot say where its locks live (seance_run_dir: D-3),
# or cannot create the directory. Both callers refuse to promote in that case:
# an automatic promotion made without the promise this lock exists to keep is
# exactly the one it would have prevented.
promote_lock_path()
{
    local _dead _rundir

    _dead=${1:?}

    _rundir=$( seance_run_dir ) || return 1
    mkdir -p "${_rundir}/lock" 2>/dev/null || return 1

    printf '%s/lock/promote.%s\n' "${_rundir}" "${_dead}"
}

# promote_lock_holder <lockfile>
#
# What is known about the process that holds <lockfile>, as one line, or
# nothing at all. Called ONLY after an acquisition has just failed: lockf(1)
# locks with flock(2), so the refusal -- and not the file's existence -- is the
# evidence that a holder is alive (D-105's reasoning, and lockf(1): "the mere
# existence of the file is not considered to constitute a lock").
#
# Both paths take the lock with `lockf -p`, which writes the pid of the command
# it is holding the lock for into the file; a holder that has not got that far
# yet leaves it empty, and this says nothing rather than guessing.
promote_lock_holder()
{
    local _lock _pid _cmd

    _lock=${1:?}

    [ -r "${_lock}" ] || return 1

    _pid=""
    read -r _pid < "${_lock}" 2>/dev/null || _pid=""

    case "${_pid}" in
        ''|*[!0123456789]*) return 1 ;;
    esac

    _cmd=$( ps -p "${_pid}" -o command= 2>/dev/null ) || _cmd=""

    if [ -n "${_cmd}" ]; then
        printf 'pid %s: %s\n' "${_pid}" "${_cmd}"
    else
        printf 'pid %s (no longer in the process table; the lock is held by its wrapper)\n' \
            "${_pid}"
    fi
}

# promote_lock_run <deadnode> <lockfile> <command> [args...]
#
# Run <command> while holding <lockfile>, or -- if something else holds it --
# say so and return PROMOTE_RC_LOCKED, having run nothing.
#
# `-t 0` because a promotion that would have to WAIT for another promotion of
# the same corpse has nothing left to do by the time it gets there: the estate
# it was going to move has been moved. `-p` writes the pid of the command into
# the lock file, which is what lets the loser name the winner.
#
# The refusal is the evidence, and the file is not: lockf(1) locks with
# flock(2) and says so itself -- "the mere existence of the file is not
# considered to constitute a lock" -- so a lock file left behind by a killed
# promotion is taken, not honoured, and what is reported below is a holder that
# was alive a moment ago rather than a file that exists.
promote_lock_run()
{
    local _dead _lock _rc _holder

    _dead=$1
    _lock=$2
    shift 2

    lockf -s -t 0 -p "${_lock}" "$@"
    _rc=$?

    [ "${_rc}" -eq "${PROMOTE_RC_LOCKED}" ] || return "${_rc}"

    printf 'promote: another promotion of %s is running on this node and holds %s.\n' \
        "${_dead}" "${_lock}"
    promote_note "This is not a stale lock file: lockf(1) locks with flock(2) -- \"the mere existence of the file is not considered to constitute a lock\" -- and the lock dies with whoever holds it. The refusal is evidence of a LIVE holder."

    if _holder=$( promote_lock_holder "${_lock}" ); then
        promote_note "The holder is ${_holder}"
    else
        promote_note "The holder has not recorded its pid yet: lockf(1) -p writes it a moment after taking the lock, so this one had only just started."
    fi

    promote_note "Wait for it and read its verdict. If it is devd's own ladder, its output is in syslog under the tag seance."
    promote_note "This lock is per node and per dead node: another NODE promoting the same corpse is not visible from here, and never was -- that is what rung 2 and rung 4 are for (D-155)."

    printf 'promote: NOTHING WAS PROMOTED: this node already has a ladder running for %s\n' \
        "${_dead}"

    return "${PROMOTE_RC_LOCKED}"
}

# promote_parse_force <value>
#
# Fill PROMOTE_FORCE from a --force value: empty means every forceable rung, a
# comma-separated list means exactly those. rc 2 -- a usage error, not a
# refusal -- for a rung that does not exist or that may not be forced.
promote_parse_force()
{
    local _v _r _k _ok

    _v=${1:-}

    if [ -z "${_v}" ]; then
        PROMOTE_FORCE=${PROMOTE_FORCEABLE}
        return 0
    fi

    PROMOTE_FORCE=""

    for _r in $( printf '%s\n' "${_v}" | tr ',' ' ' ); do
        [ -n "${_r}" ] || continue

        if [ "${_r}" = "probes" ]; then
            seance_log err "promote: --force may not name \"probes\":" \
                "a host that answers is never fenced by force (D-44 item 1)"
            return 2
        fi

        _ok=0
        for _k in ${PROMOTE_FORCEABLE}; do
            [ "${_k}" = "${_r}" ] && _ok=1
        done

        if [ "${_ok}" -eq 0 ]; then
            seance_log err "promote: --force: no such forceable rung: \"${_r}\"" \
                "(known: ${PROMOTE_FORCEABLE})"
            return 2
        fi

        PROMOTE_FORCE="${PROMOTE_FORCE} ${_r}"
    done

    PROMOTE_FORCE=${PROMOTE_FORCE# }

    if [ -z "${PROMOTE_FORCE}" ]; then
        seance_log err "promote: --force= named no rungs"
        return 2
    fi

    return 0
}

# ---------------------------------------------------------------------------
# Rung 1 -- debounce
# ---------------------------------------------------------------------------

# promote_debounce_wait <seconds>
#
# The wait itself, through an injectable command so that a test can prove the
# path runs without spending the time. M3 calls this from an --auto invocation
# and then re-reads CARP; M2 has no CARP and no --auto, so nothing in the
# shipped code calls it with PROMOTE_DEBOUNCE_REQUIRED unset.
promote_debounce_wait()
{
    local _s _cmd

    _s=${1:-0}
    _cmd=${SEANCE_DEBOUNCE_SLEEP_CMD:-sleep}

    case "${_s}" in
        ''|*[!0123456789]*) return 2 ;;
    esac

    [ "${_s}" -eq 0 ] && return 0

    # shellcheck disable=SC2086
    #   Deliberate word splitting: SEANCE_DEBOUNCE_SLEEP_CMD is a command and
    #   its arguments, and the number of seconds is appended to them.
    ${_cmd} "${_s}"
}

promote_rung_debounce()
{
    local _s _state

    if [ "${PROMOTE_DEBOUNCE_REQUIRED}" -ne 1 ]; then
        promote_rung 1 debounce "n/a (manual)" \
            "a human is the trigger, so there is no CARP transition to re-check;" \
            "a promotion somebody typed has already been debounced by the typing"
        return 0
    fi

    _s=$( conf_effective debounce ) || _s=45

    if ! promote_debounce_wait "${_s}"; then
        promote_rung 1 debounce abort \
            "the debounce wait could not be taken (debounce=${_s})"
        PROMOTE_DISPOSITION=abort
        return 1
    fi

    # The re-check, which is the whole reason the wait exists (design §7 rung
    # 1). A flapping link makes this node MASTER for a moment and then hands
    # the vhid back; the transition that woke devd was true and is not true any
    # more, and promoting on it would be promoting a node that never died.
    if [ -z "${PROMOTE_AUTO_VHID}" ]; then
        promote_rung 1 debounce abort \
            "waited ${_s}s, and there is no vhid to re-check:" \
            "node_${PROMOTE_DEAD}_vhid is not configured, so nothing on this node" \
            "can say whether the transition that woke it still holds"
        PROMOTE_DISPOSITION=abort
        return 1
    fi

    _state=$( adapter_carp_state "${PROMOTE_AUTO_VHID}" 2>/dev/null ) || _state=""

    if [ "${_state}" != "MASTER" ]; then
        promote_rung 1 debounce abort \
            "TRANSIENT MASTER: ${_s}s later this node is [${_state:-unreadable}] for vhid" \
            "${PROMOTE_AUTO_VHID}, which is ${PROMOTE_DEAD}'s. ${PROMOTE_DEAD} is advertising" \
            "again -- the link flapped, the node did not die, and nothing has been touched."
        PROMOTE_DISPOSITION=abort
        return 1
    fi

    promote_rung 1 debounce pass \
        "waited ${_s}s and this node is still MASTER for vhid ${PROMOTE_AUTO_VHID}," \
        "which is ${PROMOTE_DEAD}'s: the transition that woke this run still holds"
    return 0
}

# ---------------------------------------------------------------------------
# Rung 0 -- arming. Only the automatic path has one.
# ---------------------------------------------------------------------------

# promote_rung_arming <selfkey>
#
# TWO SWITCHES, AND BOTH OF THEM. `--auto` acts only when the fleet key `auto`
# is 1 AND this node's own auto_promote names the dead node. Either alone
# leaves automation disarmed.
#
# This is defence in depth against a misrouted devd event, not a second copy of
# `promote-event`'s check. devd rules are a file on a host; a file gets copied
# to the wrong node, a vhid gets reused, an operator tests a rule by hand. The
# question "may this node act by itself for THIS corpse" therefore gets asked
# again by the thing that would do the acting, before it waits for anything and
# long before it fences anything.
#
# It runs before rung 1 so that a disarmed node does not spend `debounce`
# seconds discovering it was never going to act.
promote_rung_arming()
{
    local _self _auto _armed

    _self=$1

    _auto=$( conf_effective auto ) || _auto=0

    if [ "${_auto}" != "1" ]; then
        promote_rung 0 arming abort \
            "--auto, but the fleet key auto is ${_auto}: automation is off for this" \
            "whole fleet and nothing here may act by itself." \
            "A human who has established that ${PROMOTE_DEAD} is dead runs:" \
            "seance promote ${PROMOTE_DEAD}"
        PROMOTE_DISPOSITION=abort
        return 1
    fi

    _armed=$( conf_get "node_${_self}_auto_promote" "" )

    if ! _conf_in_list "${PROMOTE_DEAD}" "${_armed}"; then
        promote_rung 0 arming abort \
            "--auto, but node_${_self}_auto_promote is \"${_armed:-}\" and does not name" \
            "${PROMOTE_DEAD}: this node is not armed to succeed it without a human." \
            "If a devd rule sent this, the rule and the configuration disagree." \
            "A human runs: seance promote ${PROMOTE_DEAD}"
        PROMOTE_DISPOSITION=abort
        return 1
    fi

    promote_rung 0 arming pass \
        "auto=1 and node_${_self}_auto_promote names ${PROMOTE_DEAD}"
    return 0
}

# promote_auto_report
#
# The one thing an automatic run has that a manual one does not: nobody is
# reading the terminal. Rungs 2, 3 and 4 already page when they stop -- quorum
# freezes, a host that answers, a fence that could not confirm -- so this sends
# ONE notification for the cases that otherwise reach nobody: a ladder that got
# past fencing and still promoted nothing.
#
# Rung 1's transient master is deliberately silent. It is the debounce working:
# a link flapped and seance did nothing, which is the outcome the rung exists
# to produce, and paging for it would teach an operator to filter these.
#
# A DEFERRED GUEST ALWAYS PAGES (D-130). CARP hands a dead node's vhid to one
# node, and that node is this one -- rung 1 has just re-read it. So a guest
# whose per-guest succession names some OTHER node as its actor is a guest
# nobody was woken for: this node correctly stands down and the actor never
# hears about the death. Before D-130 that was recorded as a stand-down, which
# this function does not page for, and the guest stayed down in silence. The
# body carries the exact command the responsible node has to run, because the
# operator reading the page at 03:00 is not the person who wrote the
# per-guest override.
promote_auto_report()
{
    [ "${PROMOTE_AUTO}" -eq 1 ] || return 0

    case "${PROMOTE_DISPOSITION}" in
        proceed|stand-down) [ -n "${PROMOTE_DEFERRED}" ] || return 0 ;;
    esac

    case "${PROMOTE_STOPPED_RUNG}" in
        1\ *|2\ *|3\ *|4\ *) return 0 ;;
    esac

    {
        printf 'An automatic promotion of %s stopped: disposition %s, %d of %d guest(s) promoted.\nPer-guest:%s\n' \
            "${PROMOTE_DEAD}" "${PROMOTE_DISPOSITION}" \
            "${PROMOTE_GUESTS_PROMOTED}" "${PROMOTE_GUESTS_SEEN}" \
            "${PROMOTE_GUEST_DISPOSITIONS:- (none)}"

        if [ -n "${PROMOTE_DEFERRED}" ]; then
            printf 'DEFERRED -- no automation will promote these; a human must run the command shown, on the node shown:\n%s\n' \
                "${PROMOTE_DEFERRED}"
        fi

        printf 'Nothing further will happen without a human.\n'
    } |
        seance_notify crit "seance: automatic promotion of ${PROMOTE_DEAD} stopped (${PROMOTE_DISPOSITION})"

    return 0
}

# ---------------------------------------------------------------------------
# The devd target
# ---------------------------------------------------------------------------

# promote_event_notify <level> <subject>   -- the body on stdin
#
# THE NOTIFICATION A DEVD ACTION SENDS IS DETACHED, for the reason every other
# path out of promote_event is bounded: devd(8) forks `sh -c` and wait4s it
# (sbin/devd/devd.cc, my_system), so whatever this verb waits for, devd's whole
# event loop waits for -- and the events queued behind it are the ones about
# the second death.
#
# `notify_cmd` is a site's own script. lib/notify.subr bounds it at
# NOTIFY_TIMEOUT (30 s, D-75), which is the right bound for a promotion that
# takes minutes and the wrong one here: measured, a hanging notify_cmd held
# `promote-event` for the whole thirty seconds. So the notification is sent by
# a child this verb does not wait for. Nothing about the notification itself
# changes -- same level, same subject, same body, same NOTIFY_TIMEOUT around
# the site's script, and seance_log still puts it in syslog.
#
# NARROWED TO THIS VERB DELIBERATELY. Every other notifier in seance is inside
# something that already takes minutes (the ladder) or already blocks a boot it
# is ordered before (the gate); there the caller's willingness to wait 30 s for
# a page is exactly right, and detaching would only make the page racier.
#
# The body travels in a file rather than a pipe because the child outlives this
# process, and the child removes it. Its output goes nowhere: stdout is data
# and the verdict line must stay last (D-110), and stderr would interleave into
# whatever captured this run long after it returned -- what the notification
# has to say, it says through syslog, which is where a detached process's
# diagnostics belong (the same argument daemon(8) -S makes for the ladder).
promote_event_notify()
{
    local _level _subject _body

    _level=$1
    _subject=$2

    _body=$( mktemp "${TMPDIR:-/tmp}/seance-event-notify.XXXXXX" ) || {
        seance_log err "promote-event: cannot create a temporary file for a" \
            "notification body; the subject is: ${_subject}"
        cat > /dev/null
        return 0
    }

    cat > "${_body}"

    (
        seance_notify "${_level}" "${_subject}" < "${_body}"
        rm -f "${_body}"
    ) > /dev/null 2>&1 &

    return 0
}

# promote_event <vhid@ifname>
#
# What a devd(8) rule runs. It maps the vhid to a node, decides whether this
# node is armed to succeed it, and then EITHER detaches `seance promote <dead>
# --auto` with daemon(8) OR notifies -- and returns, promptly, either way.
#
# WHY PROMPTLY IS A REQUIREMENT AND NOT A PREFERENCE. devd(8) executes an
# action by forking sh -c and calling wait4 on it (sbin/devd/devd.cc,
# my_system, called from action::do_action), so its entire event loop is
# blocked until this verb returns. A promotion takes minutes; running one
# inside a devd action would mean every other CARP transition on the node --
# including the ones telling it about the SECOND death -- queued behind it.
#
# Every path out of here is bounded: the configuration parse and the adapter
# are local reads, the mapping is arithmetic on the loaded configuration, the
# detach is wrapped in a timeout, and the notification is bounded by
# NOTIFY_TIMEOUT. The one path that can take tens of seconds is a notify_cmd
# that hangs, and 30 s of a blocked devd is the price of that being the site's
# own script; it is stated here rather than discovered.
#
# ALWAYS EXITS 0 for an event it understood, whatever it decided. A devd action
# that exits non-zero produces a log line nobody reads and changes nothing;
# what this verb has to say, it says on stdout and through seance_notify. rc 2
# is reserved for an argument that is not a CARP subsystem at all.
promote_event()
{
    local _arg _vhid _if _dead _self _auto _armed _verb _want_if _rc _rundir _lock

    _arg=${1:-}

    case "${_arg}" in
        *@*) ;;
        *)
            seance_log err "promote-event: expected <vhid>@<ifname> --" \
                "the devd(8) subsystem for a CARP event (carp(4)) -- got [${_arg}]"
            return 2
            ;;
    esac

    _vhid=${_arg%%@*}
    _if=${_arg#*@}

    case "${_vhid}" in
        ''|*[!0123456789]*)
            seance_log err "promote-event: [${_arg}] does not start with a vhid"
            return 2
            ;;
        0?*)
            # devd writes the vhid with %u (sbin/devd/devd.cc, and carp(4)'s
            # own snprintf "%u@%s"), which never has a leading zero. Read as a
            # vhid it would be one this fleet does claim, and compared as the
            # string it is it matches no node at all -- so the branch below
            # would call a real death "somebody else's cluster" and do nothing.
            # Refused, because the two wrong answers a silent no-op sits
            # between are both worse than a message.
            seance_log err "promote-event: [${_arg}] spells its vhid with a leading" \
                "zero; devd(8) writes it with %u and this fleet's node blocks carry it" \
                "without one, so this could not be matched to a node either way"
            return 2
            ;;
    esac

    # AN IMPOSSIBLE VHID IS A CONTRACT ERROR, not a foreign cluster. carp(4)
    # and ifconfig(8) put a vhid in 1..255 and lib/conf.subr enforces exactly
    # that on every node block (CONF_VHID_MIN..CONF_VHID_MAX), so 0, 256 and
    # 999 cannot have come from the kernel: a rule was mistyped, or copied from
    # a fleet that numbers its nodes differently. Answering them with "no node
    # claims this vhid; nothing to do" is the same answer a real foreign vhid
    # gets, which is how a misrouted rule comes to look like a working one.
    # D-99 settled this asymmetry inside the adapter; this is the entry point.
    if ! _conf_uint_le "${_vhid}" "${CONF_VHID_MAX}" ||
       [ "${_vhid}" -lt "${CONF_VHID_MIN}" ]; then
        seance_log err "promote-event: [${_arg}] is not a CARP vhid" \
            "(${CONF_VHID_MIN}..${CONF_VHID_MAX}): no kernel emits it, so the rule that" \
            "ran this and the fleet it is installed on do not agree"
        return 2
    fi

    if [ -z "${_if}" ]; then
        seance_log err "promote-event: [${_arg}] names no interface"
        return 2
    fi

    # AN IFNAME IS A NAME. What follows the '@' is devd's own if_name() of the
    # CARP device, at most IFNAMSIZ-1 = 15 characters (net/if.h, IF_NAMESIZE
    # 16), and it arrives here as a string this verb interpolates into log
    # lines and notifications and compares against the configuration. A
    # "subsystem" carrying whitespace, a shell separator, a second '@' or a
    # path is not a CARP event, and this verb runs as root out of a devd
    # action: the answer to an argument nobody could have meant is a refusal,
    # not the rest of it acted on.
    case "${_if}" in
        *[!A-Za-z0-9._:-]*)
            seance_log err "promote-event: [${_arg}] does not name an interface --" \
                "an ifname is [A-Za-z0-9._:-] and nothing else"
            return 2
            ;;
    esac

    if [ "${#_if}" -gt 15 ]; then
        seance_log err "promote-event: [${_arg}] names no interface:" \
            "an interface name is at most 15 characters (net/if.h, IF_NAMESIZE)"
        return 2
    fi

    _self=$( seance_self_key ) || {
        seance_log err "promote-event: this node is not in its own configuration;" \
            "no node_*_nodename matches it"
        return 2
    }

    # A vhid this configuration does not claim is not an error. CARP is a
    # broadcast protocol on a shared segment and somebody else's cluster may be
    # on it; refusing loudly would make every one of their transitions a line
    # in this fleet's log.
    if ! _dead=$( carp_node_for_vhid "${_vhid}" ); then
        printf 'promote-event: vhid %s on %s belongs to no node in this configuration; nothing to do\n' \
            "${_vhid}" "${_if}"
        return 0
    fi

    if [ "${_dead}" = "${_self}" ]; then
        printf 'promote-event: vhid %s is %s'"'"'s own identity, and becoming MASTER for it is what a boot looks like; nothing to do\n' \
            "${_vhid}" "${_self}"
        return 0
    fi

    # Not a refusal: the event happened on an interface, and which one it was
    # is information rather than permission. Said because a fleet whose vhids
    # have moved to another interface has a rendering that is out of date.
    _want_if=$( carp_interface "${_self}" ) || _want_if=""
    if [ -n "${_want_if}" ] && [ "${_want_if}" != "${_if}" ]; then
        seance_log warning "promote-event: vhid ${_vhid} went MASTER on ${_if}," \
            "but carp_interface is ${_want_if}"
    fi

    _auto=$( conf_effective auto ) || _auto=0
    _armed=$( conf_get "node_${_self}_auto_promote" "" )

    if [ "${_auto}" = "1" ] && _conf_in_list "${_dead}" "${_armed}"; then
        if ! _verb=$( adapter_fact verb ) || [ -z "${_verb}" ]; then
            printf 'promote-event: %s is armed here, but the adapter cannot say how to run a seance verb on this platform; NOTHING WAS PROMOTED\n' \
                "${_dead}"
            printf 'CARP MASTER for %s observed on %s. This node is armed to succeed it and could not work out how to invoke itself; nothing was promoted.\n' \
                "${_dead}" "${_if}" |
                promote_event_notify crit "seance: cannot start the automatic promotion of ${_dead}"
            return 0
        fi

        # ONE LADDER PER CORPSE, and the lock is what says so. devd delivers
        # what the kernel emits: a link that flaps takes this node MASTER,
        # BACKUP and MASTER again, and every MASTER is another action, another
        # detach, another `promote <dead> --auto` -- all of them inside the
        # debounce the first one is still serving. Two ladders on one node
        # fence the same host twice, walk the same estate twice and write the
        # same succession twice, and nothing in the ladder itself notices: each
        # run is correct on its own.
        #
        # lockf(1) rather than a marker file, for D-62's and D-105's reason: it
        # is released when the process holding it dies, and a stale marker
        # either wedges automation for ever or gets stolen on a liveness guess.
        # `-t 0` because a promotion that has to wait for another promotion of
        # the same corpse has nothing left to do. The loser exits EX_TEMPFAIL
        # (75) inside the detached child, which is the same "another one owns
        # this" repl(1) already speaks (repl.subr).
        #
        # `-p` writes the pid of the command lockf is holding the lock for into
        # the lock file, so that the OTHER path -- a human typing `seance
        # promote` while this ladder runs -- can name what is holding it rather
        # than only refusing (bin/seance, seance_promote).
        #
        # `--locked` is how the detached child is told that its own wrapper
        # already holds this lock. Without it the child would take the same
        # lock again, against a different open file description of the same
        # file, and flock(2) would refuse it: the automatic promotion would
        # exit 75 having done nothing, every time. The flag is the same one
        # `repl` uses for the same reason (D-62).
        #
        # PER CORPSE and not per node: two deaths are two estates, and the
        # second one must not be held by the first one's ladder.
        #
        # A node that cannot say where its locks live cannot make that
        # promise, and an automatic promotion made without it is the one this
        # would have prevented -- so it pages instead, exactly as it does when
        # the adapter cannot say how to invoke a verb.
        if ! _lock=$( promote_lock_path "${_dead}" ); then
            _rundir=$( seance_run_dir 2>/dev/null ) || _rundir=""
            printf 'promote-event: %s is armed here, but there is no run directory to serialise promotions in (%s); NOTHING WAS PROMOTED\n' \
                "${_dead}" "${_rundir:-unset}"
            printf 'CARP MASTER for %s observed on %s. This node is armed to succeed it and has nowhere to take the lock that keeps two devd events from running two ladders; nothing was promoted.\n' \
                "${_dead}" "${_if}" |
                promote_event_notify crit "seance: cannot start the automatic promotion of ${_dead}"
            return 0
        fi

        # Detached, so that devd's event loop is released now rather than in
        # several minutes, and logged to syslog because a detached process has
        # no terminal to print to. daemon(8): -f redirects the standard
        # descriptors to /dev/null first, then -S sends the child's output to
        # syslog under the -T tag at the -s priority.
        #
        # shellcheck disable=SC2086
        #   Deliberate word splitting: ${_verb} is a command and its arguments
        #   ("<path to the platform's verb> seance"), which must reach exec as
        #   separate words.
        seance_run_timeout_detach "${PROMOTE_EVENT_DETACH_TIMEOUT}" \
            daemon -f -S -T seance -l daemon -s notice \
            lockf -s -t 0 -p "${_lock}" \
            ${_verb} promote "${_dead}" --auto --locked < /dev/null > /dev/null 2>&1
        _rc=$?

        if [ "${_rc}" -ne 0 ]; then
            printf 'promote-event: could not detach the promotion of %s (daemon(8) exited %s); NOTHING WAS PROMOTED\n' \
                "${_dead}" "${_rc}"
            printf 'CARP MASTER for %s observed on %s. This node is armed to succeed it and daemon(8) exited %s; nothing was promoted.\n' \
                "${_dead}" "${_if}" "${_rc}" |
                promote_event_notify crit "seance: cannot start the automatic promotion of ${_dead}"
            return 0
        fi

        printf 'promote-event: CARP MASTER for %s (vhid %s on %s); this node is armed, and "seance promote %s --auto" is running detached -- its output is in syslog under the tag seance\n' \
            "${_dead}" "${_vhid}" "${_if}" "${_dead}"
        return 0
    fi

    printf 'CARP MASTER for %s observed on %s (vhid %s). Automation is not armed here: the fleet key auto is %s and node_%s_auto_promote is "%s". Nothing has been promoted. A human who has established that %s is dead runs:\n    seance promote %s\n' \
        "${_dead}" "${_if}" "${_vhid}" "${_auto}" "${_self}" "${_armed:-}" \
        "${_dead}" "${_dead}" |
        promote_event_notify crit "CARP MASTER for ${_dead} observed, automation not armed"

    printf 'promote-event: CARP MASTER for %s (vhid %s on %s); automation is not armed here, so this notified and did nothing\n' \
        "${_dead}" "${_vhid}" "${_if}"
    return 0
}

# ---------------------------------------------------------------------------
# Rung 2 -- quorum
# ---------------------------------------------------------------------------

# promote_reachable_peers <selfkey> <deadkey>
#
# The configured nodes, other than this one and other than the corpse, that
# answer ssh. One key per line. Asking the LIVING is permitted and is how the
# claim check and the kernel check are made (design §5).
promote_reachable_peers()
{
    local _self _dead _n _addr

    _self=$1
    _dead=$2

    for _n in $( conf_nodes ); do
        [ "${_n}" = "${_self}" ] && continue
        [ "${_n}" = "${_dead}" ] && continue

        _addr=$( seance_peer_addr "${_n}" ) || continue
        seance_ssh_probe "${_addr}" || continue

        printf '%s\n' "${_n}"
    done
}

promote_rung_quorum()
{
    local _self _n _r _verdict _rc

    _self=$1

    if promote_forced quorum; then
        PROMOTE_REACHABLE=$( promote_reachable_peers "${_self}" "${PROMOTE_DEAD}" |
            tr '\n' ' ' )
        PROMOTE_REACHABLE=${PROMOTE_REACHABLE% }
        promote_rung 2 quorum forced \
            "skipped by --force=quorum (operator ${PROMOTE_OPERATOR});" \
            "reachable peers: ${PROMOTE_REACHABLE:-none}"
        return 0
    fi

    PROMOTE_REACHABLE=$( promote_reachable_peers "${_self}" "${PROMOTE_DEAD}" |
        tr '\n' ' ' )
    PROMOTE_REACHABLE=${PROMOTE_REACHABLE% }

    _n=$( conf_node_count )
    _r=$( printf '%s\n' "${PROMOTE_REACHABLE}" | wc -w | tr -d ' ' )

    _verdict=$( pol_quorum "${_n}" "${_r}" )
    _rc=$?

    if [ "${_rc}" -eq 2 ]; then
        promote_rung 2 quorum abort \
            "the configuration cannot form a quorum: N=${_n}, reachable others=${_r}"
        PROMOTE_DISPOSITION=abort
        return 2
    fi

    if [ "${_verdict}" = "act" ]; then
        promote_rung 2 quorum pass \
            "1 + ${_r} reachable of N=${_n} is a majority (reachable: ${PROMOTE_REACHABLE:-none})"
        return 0
    fi

    promote_rung 2 quorum notify \
        "FROZEN: 1 + ${_r} reachable of N=${_n} is not a majority." \
        "Availability is sacrificed here, never consistency." \
        "A human who has established that ${PROMOTE_DEAD} is really dead runs:" \
        "seance promote ${PROMOTE_DEAD} --force=quorum"

    printf 'seance promote %s --force=quorum\n' "${PROMOTE_DEAD}" |
        seance_notify crit "seance: quorum frozen promoting ${PROMOTE_DEAD} on $( adapter_node_self 2>/dev/null || echo this node )"

    PROMOTE_DISPOSITION=notify
    return 1
}

# ---------------------------------------------------------------------------
# Rung 3 -- the death probes
# ---------------------------------------------------------------------------

# promote_probe_alive <address>  -- rc 0 if anything answers at all.
#
# One ping packet with a two-second budget, then ssh. Either is enough: the
# question is not "is it healthy" but "is it there", and a host that answers
# either is a host that must not be fenced on a promotion's say-so.
promote_probe_alive()
{
    local _addr

    _addr=$1

    if ping -c 1 -t 2 "${_addr}" > /dev/null 2>&1; then
        printf 'ping\n'
        return 0
    fi

    if seance_ssh_probe "${_addr}"; then
        printf 'ssh\n'
        return 0
    fi

    return 1
}

promote_rung_probes()
{
    local _addr _how

    if ! _addr=$( seance_peer_addr "${PROMOTE_DEAD}" ); then
        promote_rung 3 probes abort \
            "node_${PROMOTE_DEAD}_mgmt is not configured: there is no address to probe," \
            "and a node seance cannot probe is a node it must not fence"
        PROMOTE_DISPOSITION=abort
        return 2
    fi

    if _how=$( promote_probe_alive "${_addr}" ); then
        promote_rung 3 probes abort \
            "CARP said dead, host says alive -- ${PROMOTE_DEAD} (${_addr}) answered ${_how}." \
            "INVESTIGATE; do not promote. This rung is not forceable."

        printf '%s answered %s at %s. Nothing was fenced and nothing was promoted.\n' \
            "${PROMOTE_DEAD}" "${_how}" "${_addr}" |
            seance_notify crit "seance: ${PROMOTE_DEAD} is alive; promotion aborted"

        PROMOTE_DISPOSITION=abort
        return 1
    fi

    promote_rung 3 probes pass \
        "${PROMOTE_DEAD} (${_addr}) answered neither ping nor ssh"
    return 0
}

# ---------------------------------------------------------------------------
# Rung 4 -- fencing
# ---------------------------------------------------------------------------

# promote_fence_exe <driver>
#
# Where a fence driver lives: the module's own drivers/ directory first, so
# that a shipped driver cannot be shadowed by something on PATH, then PATH, so
# that a site's own driver needs no checkout. rc 1 and no output when there is
# neither.
promote_fence_exe()
{
    local _d _p

    _d=$1
    _p="${SEANCE_ROOT}/drivers/fence_${_d}"

    if [ -x "${_p}" ]; then
        printf '%s\n' "${_p}"
        return 0
    fi

    _p=$( command -v "fence_${_d}" 2>/dev/null ) || _p=""
    [ -n "${_p}" ] || return 1

    printf '%s\n' "${_p}"
}

# promote_fence_env
#
# The environment every driver is invoked with. Generic on purpose: a driver
# that does not need a variable is not harmed by its presence, and the
# alternative -- seance knowing which driver wants what -- would put the
# drivers back inside seance.
#
#   SEANCE_FENCE_TIMEOUT     the fleet's fence_timeout, so the driver's own
#                            budget and seance's are the same number.
#   SEANCE_FENCE_IPMI_CONF   the site's credentials file, at the D-3 path
#                            ${etcdir}/seance-fence-ipmi.conf. The shipped ipmi
#                            driver has no compiled-in default and refuses to
#                            guess one (D-53), because only CBSD knows workdir
#                            and a driver that asked CBSD would stop being
#                            standalone. seance knows, so seance tells it.
promote_fence_env()
{
    local _etc

    SEANCE_FENCE_TIMEOUT=$( conf_effective fence_timeout ) || SEANCE_FENCE_TIMEOUT=60
    export SEANCE_FENCE_TIMEOUT

    if _etc=$( adapter_fact etcdir 2>/dev/null ) && [ -n "${_etc}" ]; then
        SEANCE_FENCE_IPMI_CONF="${_etc}/seance-fence-ipmi.conf"
        export SEANCE_FENCE_IPMI_CONF
    fi

    return 0
}

# promote_rung_fence
#
# WHAT --force=fence MEANS HERE, and it is not what it first looks like: it
# does NOT skip the fencing. If a driver is configured it is run, every time,
# force or no force -- and a driver that answers REFUSED / STILL ON (rc 1)
# aborts the promotion whatever the operator typed (D-44 item 1). What the
# force overrides is CANNOT DETERMINE: no driver configured, no driver
# installed, an unreachable endpoint, a timeout, a success with nothing to say.
# Those are the cases where a human who has looked at the facility knows
# something this node cannot, and the flag records that they said so.
#
# Skipping an available fence on the strength of a flag would be the exact
# shape of the accident this rung exists to prevent, so the flag cannot ask
# for it.
promote_rung_fence()
{
    local _driver _target _exe _to _out _rc _errf _outf

    _driver=$( conf_get "node_${PROMOTE_DEAD}_fence_driver" "" )
    _target=$( conf_get "node_${PROMOTE_DEAD}_fence_target" "" )

    if [ -z "${_driver}" ]; then
        if promote_forced fence; then
            PROMOTE_EVIDENCE="force:${PROMOTE_OPERATOR}"
            promote_rung 4 fence forced \
                "no node_${PROMOTE_DEAD}_fence_driver is configured, and the operator" \
                "${PROMOTE_OPERATOR} accepted that with --force=fence;" \
                "evidence recorded as ${PROMOTE_EVIDENCE}"
            return 0
        fi

        promote_rung 4 fence notify \
            "no node_${PROMOTE_DEAD}_fence_driver is configured, so this node cannot" \
            "confirm ${PROMOTE_DEAD} is off. Fencing that is missing is fencing that" \
            "cannot confirm. Run: seance promote ${PROMOTE_DEAD} --force=fence"

        printf 'No fence driver is configured for %s. Nothing was promoted.\n' \
            "${PROMOTE_DEAD}" |
            seance_notify crit "seance: no fence driver for ${PROMOTE_DEAD}"

        PROMOTE_DISPOSITION=notify
        return 1
    fi

    if [ -z "${_target}" ]; then
        promote_rung 4 fence abort \
            "node_${PROMOTE_DEAD}_fence_driver is ${_driver} but node_${PROMOTE_DEAD}_fence_target" \
            "is unset: there is nothing to name to the driver"
        PROMOTE_DISPOSITION=abort
        return 2
    fi

    if ! _exe=$( promote_fence_exe "${_driver}" ); then
        if promote_forced fence; then
            PROMOTE_EVIDENCE="force:${PROMOTE_OPERATOR}"
            promote_rung 4 fence forced \
                "THE FENCE DRIVER IS MISSING: no ${SEANCE_ROOT}/drivers/fence_${_driver}" \
                "and no fence_${_driver} on PATH; the operator ${PROMOTE_OPERATOR}" \
                "accepted that with --force=fence; evidence ${PROMOTE_EVIDENCE}"
            return 0
        fi

        promote_rung 4 fence notify \
            "THE FENCE DRIVER IS MISSING: no ${SEANCE_ROOT}/drivers/fence_${_driver}" \
            "and no fence_${_driver} on PATH. ${PROMOTE_DEAD} cannot be confirmed off." \
            "Install the driver, or run: seance promote ${PROMOTE_DEAD} --force=fence"

        printf 'fence driver fence_%s is not installed on this node.\n' "${_driver}" |
            seance_notify crit "seance: fence driver fence_${_driver} is missing"

        PROMOTE_DISPOSITION=notify
        return 1
    fi

    promote_fence_env

    _to=$( conf_effective fence_timeout ) || _to=60
    _errf="${PROMOTE_TMPDIR}/fence.err"
    _outf="${PROMOTE_TMPDIR}/fence.out"

    # Captured to FILES, not through a command substitution. timeout(1) kills
    # the driver at the deadline, but a grandchild the driver started inherits
    # the pipe a $( ) capture reads from and can hold it open long after the
    # driver is dead -- which would make the fence rung wait for exactly the
    # thing it just stopped waiting for. Same defect class as D-51.
    # stdin is /dev/null so a driver cannot consume the caller's input either.
    seance_run_timeout "${_to}" "${_exe}" off "${_target}" \
        > "${_outf}" 2> "${_errf}" < /dev/null
    _rc=$?

    _out=$( promote_one_line < "${_outf}" )

    [ -s "${_errf}" ] && sed -e 's/^/  fence: /' "${_errf}" >&2

    # rc 0 with nothing to say is a contract violation, never a verified off:
    # the crashed-verifier lesson, applied to the one command whose success is
    # the licence to start a guest somewhere else (TESTING.md §5).
    if [ "${_rc}" -eq 0 ] && [ -z "${_out}" ]; then
        if promote_forced fence; then
            PROMOTE_EVIDENCE="force:${PROMOTE_OPERATOR}"
            promote_rung 4 fence forced \
                "fence_${_driver} exited 0 and printed nothing -- a contract violation," \
                "read as CANNOT DETERMINE and never as a verified off; the operator" \
                "${PROMOTE_OPERATOR} accepted that with --force=fence;" \
                "evidence ${PROMOTE_EVIDENCE}"
            return 0
        fi

        promote_rung 4 fence notify \
            "fence_${_driver} exited 0 and printed nothing. Empty output with a" \
            "success status is a contract violation, and it is read as CANNOT" \
            "DETERMINE, never as a verified off." \
            "Run: seance promote ${PROMOTE_DEAD} --force=fence"

        printf 'fence_%s off %s exited 0 with no output: contract violation.\n' \
            "${_driver}" "${_target}" |
            seance_notify crit "seance: fence_${_driver} broke its contract fencing ${PROMOTE_DEAD}"

        PROMOTE_DISPOSITION=notify
        return 1
    fi

    case "${_rc}" in
        0)
            PROMOTE_EVIDENCE="fence:${_driver}"
            promote_rung 4 fence pass \
                "fence_${_driver} off ${_target} verified ${PROMOTE_DEAD} is off:" \
                "[${_out}]. Split brain is now impossible, not merely unlikely."
            return 0
            ;;
        1)
            promote_rung 4 fence abort \
                "FENCE REFUSED: fence_${_driver} off ${_target} reports ${PROMOTE_DEAD}" \
                "still on, or refused the command: [${_out}]." \
                "This is a hard abort and is NOT forceable. Something is deeply wrong;" \
                "find out what before anything starts that guest anywhere."

            printf 'fence_%s off %s exited 1 (refused / still on): %s\nNothing was promoted.\n' \
                "${_driver}" "${_target}" "${_out}" |
                seance_notify crit "seance: FENCE REFUSED for ${PROMOTE_DEAD} -- promotion aborted"

            PROMOTE_DISPOSITION=abort
            return 1
            ;;
        *)
            if promote_forced fence; then
                PROMOTE_EVIDENCE="force:${PROMOTE_OPERATOR}"
                promote_rung 4 fence forced \
                    "cannot determine whether ${PROMOTE_DEAD} is off: fence_${_driver}" \
                    "off ${_target} exited ${_rc} [${_out}]; the operator" \
                    "${PROMOTE_OPERATOR} accepted that with --force=fence;" \
                    "evidence ${PROMOTE_EVIDENCE}"
                return 0
            fi

            promote_rung 4 fence notify \
                "cannot determine whether ${PROMOTE_DEAD} is off: fence_${_driver} off" \
                "${_target} exited ${_rc} [${_out}]. Consistent with total power loss," \
                "but that is not proof. Look at the facility, then run:" \
                "seance promote ${PROMOTE_DEAD} --force=fence"

            printf 'fence_%s off %s exited %s: %s\nNothing was promoted.\n' \
                "${_driver}" "${_target}" "${_rc}" "${_out}" |
                seance_notify crit "seance: cannot confirm ${PROMOTE_DEAD} is fenced"

            PROMOTE_DISPOSITION=notify
            return 1
            ;;
    esac
}

# ---------------------------------------------------------------------------
# Rung 5 -- lineage, per guest
# ---------------------------------------------------------------------------

# promote_standby_root <selfkey>
#
# Where THIS node keeps other nodes' replicas. It is this node's own standby
# root because this node is the one that received them (D-67, D-59).
promote_standby_root()
{
    local _self _sroot _tmp _root _g _names

    _self=$1

    repl_standby_root "${_self}" && return 0

    # Unset: derive from a guest of this node's own, which is the only layout a
    # derivation can honestly speak for.
    _tmp=$( seance_tmpdir ) || return 1
    adapter_guest_list > "${_tmp}/g" < /dev/null || return 1
    _names=$( awk -F "${PROMOTE_TAB}" 'NF > 0 { print $1 }' "${_tmp}/g" )

    for _g in ${_names}; do
        adapter_guest_datasets "${_g}" > "${_tmp}/ds" < /dev/null || continue
        [ -s "${_tmp}/ds" ] || continue
        _root=""
        read -r _root < "${_tmp}/ds"
        [ -n "${_root}" ] || continue
        repl_standby_root_derived "${_root}" && return 0
    done

    return 1
}

# promote_estate <standby-root> <deadkey>
#
# The dead node's estate as this node holds it: one record per guest,
# "<guest><TAB><replica-root-dataset><TAB><newest replica timestamp>",
# alphabetically by guest.
#
# A guest is in the estate when it has a dataset under <standby_root>/<dead>/
# AND that dataset tree carries at least one @seance-<dead>-* snapshot
# (D-44 item 3). Both halves matter: a directory somebody made by hand is not
# an estate, and a replica with no lineage is not promotable -- the disposition
# rung would abort on it anyway, and discovering it here keeps that abort
# attached to a named guest rather than to an empty list.
promote_estate()
{
    local _sroot _dead _base _kids _ds _guest _ts

    _sroot=$1
    _dead=$2
    _base="${_sroot}/${_dead}"

    _kids=$( zfs_children "${_base}" ) || return 1

    for _ds in ${_kids}; do
        _guest=${_ds##*/}

        # The configuration mirror lives beside the guests and is not one
        # (D-82). It is what rung 6 reads a jail's rc.conf out of; promoting it
        # would be promoting seance's own bookkeeping.
        [ "${_guest}" = "${REPL_SYS_GUEST}" ] && continue

        # MEMBERSHIP is "carries at least one @seance-<dead>-* anywhere"
        # (D-44 item 3). THE PROMOTION POINT is the newest instant every
        # dataset of the tree shares (D-85), and the two are different
        # questions: a guest whose tree has lineage but no shared instant is
        # part of the estate and must be REFUSED BY NAME, not quietly left out
        # of a listing where an operator would read its absence as "seance
        # holds nothing for it".
        lineage_probe "${_dead}" "${_ds}" > /dev/null 2>&1 || continue

        _ts=$( lineage_probe_common "${_dead}" "${_ds}" 2>/dev/null ) || _ts=""

        printf '%s\t%s\t%s\n' "${_guest}" "${_ds}" "${_ts}"
    done | LC_ALL=C sort
}

# promote_ahead_of <dataset> <deadkey> <point>
#
# The snapshots of <dataset> that a rollback to <point> would destroy: every
# snapshot after it, whoever wrote it. Printed so that the operator sees what
# went, not only that something did.
#
# Ordering is by our own parser where a name parses, and lexical where it does
# not -- a foreign name has no timestamp seance can compare, so what is listed
# for it is simply "it is in the listing after the point", which is what
# `zfs rollback -r` will act on.
promote_ahead_of()
{
    local _ds _dead _point _out _line _short _parsed _ts

    _ds=$1
    _dead=$2
    _point=$3

    _out=$( lineage_listing "${_ds}" 2>/dev/null ) || return 0

    printf '%s\n' "${_out}" |
    while IFS= read -r _line || [ -n "${_line}" ]; do
        case "${_line}" in
            "${_ds}@"*) ;;
            *) continue ;;
        esac

        _short=${_line#*@}

        if _parsed=$( pol_snap_parse "${_short}" ); then
            _ts=${_parsed#*	}
            if [ "${_parsed%	*}" = "${_dead}" ]; then
                [ "$( pol_ts_cmp "${_ts}" "${_point}" )" = "1" ] || continue
            fi
        fi

        # Anything at or before the point of OUR lineage was skipped above;
        # everything else here is destroyed by the rollback, foreign names
        # included, and saying so is the whole reason this function exists.
        [ "${_short}" = "$( pol_snap_format "${_dead}" "${_point}" 2>/dev/null )" ] &&
            continue

        printf '%s\n' "${_short}"
    done

    return 0
}

# promote_align_tree <guest> <replica-root> <deadkey> <point>
#
# Put every dataset of the tree at the promotion point (D-85). A dataset
# holding snapshots of OUR lineage after the point is rolled back to it; a
# dataset that only has foreign snapshots after the point is left alone,
# because its DATA is already at the point -- a replica's data only advances by
# receive, and a receive lands one of ours.
#
# rc 0 when the whole tree sits at the point.
promote_align_tree()
{
    local _guest _root _dead _point _fs _vols _ds _newest _all _rc _short

    _guest=$1
    _root=$2
    _dead=$3
    _point=$4

    _short=$( pol_snap_format "${_dead}" "${_point}" ) || return 1

    _fs=$( zfs_filesystems_r "${_root}" 2>/dev/null ) || _fs=""
    _vols=$( zfs_volumes_r "${_root}" 2>/dev/null ) || _vols=""
    _all="${_fs}
${_vols}"

    _rc=0

    for _ds in ${_all}; do
        [ -n "${_ds}" ] || continue

        _newest=$( lineage_listing "${_ds}" 2>/dev/null |
            awk -F '@' -v d="${_ds}" 'NF == 2 && $1 == d { print $2 }' |
            pol_newest_for_node "${_dead}" ) || continue

        [ -n "${_newest}" ] || continue
        [ "$( pol_ts_cmp "${_newest}" "${_point}" )" = "1" ] || continue

        promote_note "${_ds} is AHEAD of the promotion point: an interrupted tick" \
            "left it at ${_newest} while the tree as a whole is only complete at" \
            "${_point}. Rolling it back. These snapshots are destroyed and there is" \
            "NO UNDO:"
        promote_ahead_of "${_ds}" "${_dead}" "${_point}" |
            while IFS= read -r _newest || [ -n "${_newest}" ]; do
                [ -n "${_newest}" ] || continue
                printf '    destroying %s@%s\n' "${_ds}" "${_newest}"
            done

        promote_undo "none -- zfs rollback -r destroys the snapshots after ${_short}"

        if ! zfs_rollback_r "${_ds}" "${_short}"; then
            seance_log err "promote ${_guest}: cannot roll ${_ds} back to @${_short}"
            _rc=1
        fi
    done

    return "${_rc}"
}

# promote_borrow_ro <dataset> <scratch-path>
#
# Mount a replica READ-ONLY at a scratch path, so that something inside it can
# be read before the ceremony that will mount it properly has begun.
#
# Read-only because everything read this way is another node's record of its
# own estate: there is nothing in it seance should be able to write. `zfs mount
# -o ro` is a property of THE MOUNT (zfs-mount(8) -o), so it lasts exactly as
# long as the mount and there is nothing on disk to put back afterwards but the
# mountpoint, which promote_return_ro does.
#
# ONE MOUNTER, TWO READERS. The configuration mirror (D-82) and the guest's own
# replica are both read this way, and writing a second mounter for the second
# reader is how two paths that must behave identically stop doing so -- the
# undo line, the read-only property and the restoration of the mountpoint are
# one implementation or they are two half-implementations.
#
# rc 0 mounted, 1 not (and the mountpoint has been put back).
promote_borrow_ro()
{
    local _ds _at

    _ds=$1
    _at=$2

    mkdir -p "${_at}" || return 1

    promote_undo "zfs unmount ${_ds}; zfs inherit mountpoint ${_ds}"

    if ! zfs_set "mountpoint=${_at}" "${_ds}"; then
        seance_log err "promote: cannot point ${_ds} at ${_at}"
        return 1
    fi

    if ! zfs_mount_ro "${_ds}"; then
        seance_log err "promote: cannot mount ${_ds} read-only at ${_at}"
        zfs_inherit mountpoint "${_ds}"
        return 1
    fi

    return 0
}

# promote_return_ro <dataset>  -- give back what promote_borrow_ro took.
promote_return_ro()
{
    local _ds _rc

    _ds=$1
    _rc=0

    zfs_unmount "${_ds}" || _rc=1
    zfs_inherit mountpoint "${_ds}" || _rc=1

    return "${_rc}"
}

# promote_sys_restore <guest> <sys-replica-dataset> <destination-directory>
#                     <scratch-directory>
#
# Put a guest's configuration back where the platform looks for it, out of the
# replica of the dead node's configuration mirror (D-82).
#
# rc 0 the configuration is in place, 1 it could not be.
promote_sys_restore()
{
    local _guest _sds _dst _scratch _rc

    _guest=$1
    _sds=$2
    _dst=$3
    _scratch="${4:?}/sysmirror"

    if ! zfs_exists "${_sds}"; then
        seance_log err "promote ${_guest}: no configuration mirror at ${_sds}." \
            "The guest's data is here and its configuration is not, so nothing" \
            "here can register it."
        return 1
    fi

    promote_borrow_ro "${_sds}" "${_scratch}" || return 1

    _rc=0

    if [ ! -d "${_scratch}/${_guest}" ]; then
        seance_log err "promote ${_guest}: the configuration mirror carries no" \
            "${_guest}/ directory; the dead node never mirrored this guest"
        _rc=1
    else
        promote_undo "rm -rf ${_dst}"
        if mkdir -p "${_dst}" && cp -a "${_scratch}/${_guest}/." "${_dst}/"; then
            promote_note "restored ${_guest}'s configuration into ${_dst} from ${_sds}"
        else
            seance_log err "promote ${_guest}: could not copy its configuration into ${_dst}"
            _rc=1
        fi
    fi

    promote_return_ro "${_sds}" || _rc=1

    return "${_rc}"
}

# promote_kernel_check <selfkey>
#
# Is this fleet kernel-homogeneous, as far as the living can say?
#
# WHAT THIS CAN AND CANNOT PROVE, stated because the difference is the whole
# reason the rung is forceable. D-5 asks whether the promoting node's kernel
# matches the guest's HOME node's. The home node is dead and may not be asked
# (design §5), and seance keeps no record of its kernel. What can be measured
# is whether every LIVING node agrees with this one -- and under the fleet
# doctrine that a jail-hosting cluster is kernel-homogeneous (design §3), a
# living fleet that agrees is the available evidence that the dead one did too.
# A living fleet that DISAGREES is proof that the doctrine does not hold here,
# and a jail must then not be promoted without a human saying so.
#
# Sets PROMOTE_KERNEL to same, differs or unknown.
promote_kernel_check()
{
    local _self _local _peer _addr _k _bad

    _self=$1

    _local=$( adapter_kernel_version 2>/dev/null ) || _local=""

    if [ -z "${_local}" ]; then
        PROMOTE_KERNEL=unknown
        PROMOTE_KERNEL_DETAIL="this node could not report its own kernel version"
        return 0
    fi

    if [ -z "${PROMOTE_REACHABLE}" ]; then
        PROMOTE_KERNEL=unknown
        PROMOTE_KERNEL_DETAIL="no living peer answered, so homogeneity cannot be measured"
        return 0
    fi

    _bad=""
    for _peer in ${PROMOTE_REACHABLE}; do
        _addr=$( seance_peer_addr "${_peer}" ) || continue
        # shellcheck disable=SC2016
        #   The single quotes are the point: this is source text for the PEER's
        #   shell, not an expansion for this one. Expanding it here would ask
        #   this node for its own kernel three times.
        _k=$( seance_ssh "${_addr}" \
            'k=$( freebsd-version -k 2>/dev/null ); [ -n "$k" ] || k=$( uname -r ); printf "%s\n" "$k"' \
            2>/dev/null ) || _k=""

        if [ -z "${_k}" ]; then
            _bad="${_bad} ${_peer}=?"
        elif [ "${_k}" != "${_local}" ]; then
            _bad="${_bad} ${_peer}=${_k}"
        fi
    done

    if [ -z "${_bad}" ]; then
        PROMOTE_KERNEL=same
        PROMOTE_KERNEL_DETAIL="every living peer runs ${_local}"
        return 0
    fi

    PROMOTE_KERNEL=differs
    PROMOTE_KERNEL_DETAIL="this node runs ${_local}; the living fleet disagrees:${_bad}"
    return 0
}

# promote_claimed <guest>
#
# Print the peer that already claims this guest, or nothing. The claim check
# asks the LIVING, which the state model permits, and it is what makes
# "exactly one survivor acts" true from the resource rather than from a race
# (D-44 item 3).
promote_claimed()
{
    local _guest _row

    _guest=$1

    placement_claims "${PROMOTE_TMPDIR}/claims" "${_guest}"
}

# promote_claims_gather
#
# Ask every reachable peer what it is hosting, ONCE per run, into
# ${PROMOTE_TMPDIR}/claims. Sets PROMOTE_UNREPORTED to the living peers that
# could not answer.
#
# Once rather than per guest because the answer is a property of the fleet at
# this instant, not of the guest being considered -- and because the list of
# peers that could NOT answer has to be the same list for every guest, or the
# ladder would refuse one guest and promote the next on the strength of the
# same silence.
promote_claims_gather()
{
    : > "${PROMOTE_TMPDIR}/claims"

    # shellcheck disable=SC2086
    #   Deliberate word splitting: PROMOTE_REACHABLE is a list of node keys.
    placement_remote ${PROMOTE_REACHABLE} > "${PROMOTE_TMPDIR}/claims"

    PROMOTE_UNREPORTED=$( placement_silent "${PROMOTE_TMPDIR}/claims" )
    PROMOTE_UNREPORTED=${PROMOTE_UNREPORTED% }
}

# promote_actor <heir1> <heir2> <heir1-reachable>
#
# Which node acts for a guest with that succession -- the first heir when it is
# reachable, otherwise the second, otherwise the first anyway (there is nobody
# else, and naming an unreachable node is more use to an operator than naming
# none). rc 1 when the succession is empty.
#
# The mirror image of pol_am_i_actor, which answers only about the node asking.
# A deferral has to NAME the node, and a caller that worked the name out for
# itself would be a second implementation of the succession rule.
promote_actor()
{
    if [ -n "${1:-}" ] && [ "${3:-0}" -eq 1 ]; then
        printf '%s\n' "$1"
        return 0
    fi

    if [ -n "${2:-}" ]; then
        printf '%s\n' "$2"
        return 0
    fi

    if [ -n "${1:-}" ]; then
        printf '%s\n' "$1"
        return 0
    fi

    return 1
}

# promote_guest_disposition <guest> <replica-root> <newest-ts> <selfkey> <now>
#
# The whole of rung 5 for one guest. Prints its own lines and returns:
#   0  proceed
#   1  do not promote this guest (the reason has been printed)
promote_guest_disposition()
{
    local _guest _ds _ts _self _now _peers _h1 _h2 _reach _actor _claim
    local _max _skew _force _disp _rc _type _arc _order _who

    _guest=$1
    _ds=$2
    _ts=$3
    _self=$4
    _now=$5

    # --- whose is it -------------------------------------------------------
    if ! _peers=$( repl_peers "${_guest}" "${PROMOTE_DEAD}" ); then
        promote_note "${_guest}: stand-down -- no heir is configured for ${PROMOTE_DEAD}," \
            "so nothing here may inherit it"
        PROMOTE_GUEST_DISPOSITIONS="${PROMOTE_GUEST_DISPOSITIONS} ${_guest}=stand-down"
        return 1
    fi

    _h1=$( printf '%s\n' "${_peers}" | sed -n '1p' )
    _h2=$( printf '%s\n' "${_peers}" | sed -n '2p' )

    if [ "${_h1}" = "${_self}" ]; then
        _reach=1
    else
        case " ${PROMOTE_REACHABLE} " in
            *" ${_h1} "*) _reach=1 ;;
            *) _reach=0 ;;
        esac
    fi

    # pol_am_i_actor's rc IS its answer (0 act, 1 stand-down), so it is read
    # from stdout; rc 2 is a malformed call and must not be mistaken for a
    # stand-down, which is why it is separated out rather than swallowed.
    _actor=$( pol_am_i_actor "${_self}" "${_h1}" "${_h2}" "${_reach}" )
    _arc=$?
    _order=$( printf '%s' "${_peers}" | tr '\n' ' ' )

    if [ "${_arc}" -eq 2 ]; then
        promote_note "${_guest}: abort -- the succession for it could not be evaluated" \
            "(self=${_self} heir=${_h1} heir2=${_h2} heir1-reachable=${_reach})"
        PROMOTE_GUEST_DISPOSITIONS="${PROMOTE_GUEST_DISPOSITIONS} ${_guest}=abort"
        return 1
    fi

    if [ "${_actor}" != "act" ]; then
        # THE AUTOMATIC PATH HAS NOBODY ELSE (D-130). A manual run leaves a
        # stand-down on a terminal a human is reading, and that human can go and
        # run it on the node the line names. An automatic run has no such
        # reader, and no second node was woken: CARP gives the dead node's vhid
        # to exactly one MASTER and rung 1 has just confirmed that this node is
        # it. Every other participant in that vhid is BACKUP and its own --auto
        # run stops at rung 1. So a guest whose actor is elsewhere is a guest
        # nothing will promote, and the difference between the two words is the
        # difference between an outage somebody is paged about and one nobody
        # is.
        if [ "${PROMOTE_AUTO}" -eq 1 ]; then
            _who=$( promote_actor "${_h1}" "${_h2}" "${_reach}" ) || _who=""

            promote_note "${_guest}: deferred -- succession is ${_order}," \
                "and this node is not the actor for it." \
                "CARP woke this node alone, so ${_who:-that node} will not hear about" \
                "${PROMOTE_DEAD}'s death: run \"seance promote ${PROMOTE_DEAD}" \
                "--guest ${_guest}\" on ${_who:-the actor}"
            PROMOTE_DEFERRED="${PROMOTE_DEFERRED}  ${_guest}: seance promote ${PROMOTE_DEAD} --guest ${_guest}   (on ${_who:-the actor})${PROMOTE_NL}"
            PROMOTE_GUEST_DISPOSITIONS="${PROMOTE_GUEST_DISPOSITIONS} ${_guest}=deferred"
            return 1
        fi

        promote_note "${_guest}: stand-down -- succession is ${_order}," \
            "and this node is not the actor for it"
        PROMOTE_GUEST_DISPOSITIONS="${PROMOTE_GUEST_DISPOSITIONS} ${_guest}=stand-down"
        return 1
    fi

    # --- does anybody already have it -------------------------------------
    #
    # A LIVING PEER THAT COULD NOT ANSWER IS NOT A PEER WITH NO CLAIM. It is up
    # -- it answered an ssh probe -- and its seance could not say what it is
    # hosting, so this node cannot establish that the guest is not already
    # running there. Promoting on that silence is the split brain the claim
    # check exists to prevent, arriving by way of a broken install rather than
    # a broken network, and it is not forceable for the same reason a live host
    # is never fenced by force (D-44 item 1).
    if [ -n "${PROMOTE_UNREPORTED}" ]; then
        promote_note "${_guest}: abort -- living peer(s) ${PROMOTE_UNREPORTED} answered" \
            "ssh but could not state their placement, so nothing here can establish that" \
            "${_guest} is not already running on one of them." \
            "Fix seance on those nodes (ssh <peer> ${GATE_REMOTE_CMD}) and run this again."
        PROMOTE_GUEST_DISPOSITIONS="${PROMOTE_GUEST_DISPOSITIONS} ${_guest}=abort"
        return 1
    fi

    _claim=$( promote_claimed "${_guest}" )
    if [ -n "${_claim}" ]; then
        promote_note "${_guest}: stand-down -- ${_claim} already claims it in its placement." \
            "Exactly one survivor acts, and it is not this one."
        PROMOTE_GUEST_DISPOSITIONS="${PROMOTE_GUEST_DISPOSITIONS} ${_guest}=stand-down"
        return 1
    fi

    # --- is there an instant the whole guest exists at (D-85) -------------
    if [ -z "${_ts}" ]; then
        promote_note "${_guest}: abort -- no @seance-${PROMOTE_DEAD}-* snapshot is" \
            "present on EVERY dataset of ${_ds}. A tick died part way and left the" \
            "tree at different instants; there is no complete copy of this guest to" \
            "promote, and no --force makes one. Let the dead node come back, or" \
            "promote from a peer whose copy is coherent."
        PROMOTE_GUEST_DISPOSITIONS="${PROMOTE_GUEST_DISPOSITIONS} ${_guest}=abort"
        return 1
    fi

    # --- is the replica fresh enough --------------------------------------
    _max=$( conf_effective staleness_max "${_guest}" ) || _max=2700
    _skew=$( conf_effective skew_tolerance ) || _skew=120

    if promote_forced lineage; then
        _force=1
    else
        _force=0
    fi

    _disp=$( pol_lineage_disposition "${_ts}" "${_now}" "${_max}" "${_skew}" "${_force}" )
    _rc=$?

    if [ "${_rc}" -eq 2 ]; then
        promote_note "${_guest}: abort -- the replica's newest timestamp [${_ts}] cannot be read"
        PROMOTE_GUEST_DISPOSITIONS="${PROMOTE_GUEST_DISPOSITIONS} ${_guest}=abort"
        return 1
    fi

    case "${_disp}" in
        proceed)
            promote_note "${_guest}: lineage proceed -- newest replica ${_ts}, inside staleness_max ${_max}s"
            ;;
        proceed-forced)
            promote_note "${_guest}: lineage proceed-forced -- newest replica ${_ts} is stale or skewed," \
                "forced by --force=lineage (operator ${PROMOTE_OPERATOR})"
            PROMOTE_EVIDENCE="force:${PROMOTE_OPERATOR}"
            ;;
        force-only)
            promote_note "${_guest}: force-only -- newest replica ${_ts} is stale or skewed past" \
                "staleness_max ${_max}s / skew_tolerance ${_skew}s." \
                "Run: seance promote ${PROMOTE_DEAD} --force=lineage --guest ${_guest}"
            PROMOTE_GUEST_DISPOSITIONS="${PROMOTE_GUEST_DISPOSITIONS} ${_guest}=force-only"
            return 1
            ;;
        *)
            promote_note "${_guest}: abort -- no @seance-${PROMOTE_DEAD}-* lineage on ${_ds};" \
                "there is nothing here to promote, and no --force makes a snapshot exist"
            PROMOTE_GUEST_DISPOSITIONS="${PROMOTE_GUEST_DISPOSITIONS} ${_guest}=abort"
            return 1
            ;;
    esac

    # --- jails run this node's kernel (D-5) --------------------------------
    #
    # Only a MEASURED disagreement stops a jail. "unknown" -- nobody living
    # answered -- is not evidence of a mismatch, and treating it as one would
    # make every N=2 promotion (where the only peer is the corpse) demand a
    # second --force for no new information. Homogeneity is watched
    # continuously and loudly by `status` and `verify`; this rung catches the
    # case where that watch has already found a divergence.
    _type=$( promote_guest_type "${_ds}" )

    if [ "${_type}" = "jail" ] && [ "${PROMOTE_KERNEL}" = "unknown" ]; then
        promote_note "${_guest}: kernel homogeneity could not be measured --" \
            "${PROMOTE_KERNEL_DETAIL}. It is a jail, so it will run this node's kernel;" \
            "seance status names any divergence it can see."
    fi

    if [ "${_type}" = "jail" ] && [ "${PROMOTE_KERNEL}" = "differs" ]; then
        if promote_forced kernel; then
            promote_note "${_guest}: kernel forced -- ${PROMOTE_KERNEL_DETAIL};" \
                "forced by --force=kernel (operator ${PROMOTE_OPERATOR})"
            PROMOTE_EVIDENCE="force:${PROMOTE_OPERATOR}"
        else
            promote_note "${_guest}: force-only -- it is a jail and jails run the host's kernel," \
                "but ${PROMOTE_KERNEL_DETAIL}." \
                "Run: seance promote ${PROMOTE_DEAD} --force=kernel --guest ${_guest}"
            PROMOTE_GUEST_DISPOSITIONS="${PROMOTE_GUEST_DISPOSITIONS} ${_guest}=force-only"
            return 1
        fi
    fi

    PROMOTE_GUEST_DISPOSITIONS="${PROMOTE_GUEST_DISPOSITIONS} ${_guest}=proceed"
    return 0
}

# ---------------------------------------------------------------------------
# Rung 6 -- promotion proper, per guest
# ---------------------------------------------------------------------------

# promote_guest_type <replica-root-dataset>
#
# bhyve if the replica tree carries a ZFS volume, jail otherwise.
#
# EVIDENCE, and the reason it is read from the datasets rather than from a
# config file: a bhyve guest's disks ARE zvols under its own dataset
# (sudoexec/bcreate:573-590, and sudoexec/zfs-recv:82-93 restores their
# /dev/zvol symlinks after a receive), while a jail's dataset is created as a
# plain filesystem with no volumes at all (sudoexec/mkdatadir:14-23). The
# guest's own configuration would be the other answer, but it lives inside the
# replica and cannot be read until the replica is mounted -- and the mountpoint
# is exactly what the type decides. The dataset shape is legible without
# mounting anything, so it is what the ceremony asks.
#
# The guess is not left to stand: promote_guest_promote re-asks the platform
# once the guest is registered, and a disagreement that would have put the
# guest in the wrong place is fatal.
promote_guest_type()
{
    local _vols

    _vols=$( zfs_volumes_r "$1" 2>/dev/null ) || _vols=""

    if [ -n "${_vols}" ]; then
        printf 'bhyve\n'
    else
        printf 'jail\n'
    fi
}

# promote_config_read <guest> <replica-root> <sys-replica-dataset>
#                     <scratch-directory> <destination-file>
#
# The guest's own configuration file, copied out of the replicas this node
# holds WITHOUT mounting anything at its final path -- because what the
# ceremony needs from it is WHERE that final path is (D-181). Prints the
# dataset it was found in.
#
# THE ORDER IS THE REGISTRATION'S ORDER, and that is the whole of why it is
# this way round. Rung 6 registers the guest from the copy that travelled
# inside its own datasets when there is one, and from the dead node's
# configuration mirror when there is not (D-82). The mount path has to be read
# out of the FILE THAT WILL BE REGISTERED: reading a path from the mirror and
# then registering a travelled copy that says something else would mount the
# replica in one place and tell the platform to look in another, which is the
# defect this unit exists to remove, wearing a different hat.
#
#   1. the replica's root dataset -- a VM on CBSD, whose ${jailsysdir}/<n> is a
#      symlink to its own data directory (sudoexec/bcreate:599), so its
#      rc.conf_<n> sits at the top of the replica;
#   2. each immediate FILESYSTEM child of it -- the pseudo-cluster's guests
#      keep their configuration in a `sys` child dataset (D-84 item 3) so that
#      it travels the way a VM's does. One level, because a platform that
#      buries a guest's configuration deeper than its own data directory is not
#      one seance has met, and a recursive search of a replica for a filename
#      would be a guess wearing a find(1);
#   3. the dead node's configuration mirror, which is where `repl` puts the
#      configuration of everything whose sysdir does NOT travel -- a jail on
#      CBSD, and any VM whose ${jailsysdir}/<n> is a real directory rather than
#      a symlink into its dataset (a VM created with mnt_start, which is the
#      shape the first real fleet is built in: sudoexec/bcreate:549-566 makes
#      the sysdir with mkdir and never links it).
#
# rc 0 with the file copied and PROMOTE_CONFIG_SOURCE naming the dataset it
# came out of, 1 when no replica this node holds carries it.
#
# THE ANSWER IS A VARIABLE AND NOT STDOUT, and that is not a style choice: this
# function mounts things, and every mounting step in this file prints its undo
# line on stdout (promote_undo). A caller capturing stdout would capture the
# undo lines with the answer -- which is exactly what the first draft did, and
# what turned a mount path into four lines of log.
promote_config_read()
{
    local _guest _root _sds _scratch _dst _kids _ds _rc

    _guest=$1
    _root=$2
    _sds=$3
    _scratch="${4:?}/config"
    _dst=$5

    PROMOTE_CONFIG_SOURCE=""
    rm -f "${_dst}"

    # 1 and 2: the guest's own replica.
    _kids=$( zfs_filesystems_r "${_root}" 2>/dev/null ) || _kids=""

    for _ds in ${_kids}; do
        [ -n "${_ds}" ] || continue

        # One level: the root itself and its immediate children.
        case "${_ds#"${_root}"}" in
            '')     ;;              # the root
            /*/*)   continue ;;     # deeper than one level
            /*)     ;;              # an immediate child
            *)      continue ;;     # not under this root at all
        esac

        promote_borrow_ro "${_ds}" "${_scratch}" || continue

        _rc=1
        if [ -r "${_scratch}/rc.conf_${_guest}" ] &&
           cp "${_scratch}/rc.conf_${_guest}" "${_dst}"
        then
            _rc=0
        fi

        promote_return_ro "${_ds}"

        if [ "${_rc}" -eq 0 ]; then
            PROMOTE_CONFIG_SOURCE=${_ds}
            return 0
        fi
    done

    # 3: the dead node's configuration mirror.
    zfs_exists "${_sds}" || return 1

    promote_borrow_ro "${_sds}" "${_scratch}" || return 1

    _rc=1
    if [ -r "${_scratch}/${_guest}/rc.conf_${_guest}" ] &&
       cp "${_scratch}/${_guest}/rc.conf_${_guest}" "${_dst}"
    then
        _rc=0
    fi

    promote_return_ro "${_sds}"

    [ "${_rc}" -eq 0 ] || return 1

    PROMOTE_CONFIG_SOURCE=${_sds}
    return 0
}

# promote_mount_path <guest> <type> <replica-root> <sys-replica-dataset>
#                    <scratch-directory>
#
# WHERE THIS GUEST'S REPLICA IS TO BE MOUNTED, observed rather than derived
# (D-178's open paragraph, closed by D-181).
#
# It is the `data=` of the guest's OWN configuration -- the same file the
# platform is about to be handed to register it with -- read before the
# ceremony out of a read-only scratch mount of whichever replica carries it.
# The alternative, which is what this replaced, was to ask the platform where a
# guest of this TYPE is created here: on the first real fleet every guest is a
# VM whose data lives on the jail-shaped path, so that answer would have
# mounted the replica at ${workdir}/vm/<n> and then registered it from an
# rc.conf whose data= names somewhere else. Nothing would have started, and
# what did start would have started over an empty directory.
#
# THE LAST RESORT IS STILL THE PLATFORM'S CONVENTION, and it is announced when
# it is used: a guest whose configuration states no data path at all (the
# schema's default is "0") has nothing to observe, and this platform's own
# convention for the type is the best available answer. A configuration that
# states something that is NOT a usable absolute path is a REFUSAL, not a
# fallback -- it is the one case where seance knows the answer is wrong rather
# than missing.
#
# rc 0 with the path in PROMOTE_MOUNT_PATH -- a variable rather than stdout,
# for promote_config_read's reason -- and 1 when the guest cannot be promoted
# here at all.
promote_mount_path()
{
    local _guest _type _root _sds _scratch _cfg _src _path _rc

    _guest=$1
    _type=$2
    _root=$3
    _sds=$4
    _scratch=$5

    PROMOTE_MOUNT_PATH=""
    _cfg="${_scratch}/rcconf.${_guest}"

    if promote_config_read "${_guest}" "${_root}" "${_sds}" \
            "${_scratch}" "${_cfg}"
    then
        _src=${PROMOTE_CONFIG_SOURCE}
        _path=$( adapter_config_data_path "${_cfg}" )
        _rc=$?

        case "${_rc}" in
            0)
                promote_note "${_guest}: its own configuration in ${_src} says" \
                    "data=${_path}, so that is where its replica is mounted"
                PROMOTE_MOUNT_PATH=${_path}
                return 0
                ;;
            1)
                promote_note "${_guest}: its configuration in ${_src} states no" \
                    "data path (the platform's schema default is \"0\"), so the" \
                    "LAST RESORT is used: where this platform creates a ${_type}"
                ;;
            *)
                seance_log err "promote ${_guest}: its configuration in ${_src} names" \
                    "a data path this node will not mount a replica at (see the" \
                    "diagnostic above). Nothing has been mounted, registered or started."
                return 1
                ;;
        esac
    else
        promote_note "${_guest}: no copy of rc.conf_${_guest} could be read from" \
            "${_root} or from ${_sds}, so the LAST RESORT is used: where this" \
            "platform creates a ${_type}. Registration will fail on the same" \
            "absence if it really is absent"
    fi

    if ! _path=$( adapter_guest_mountpoint "${_guest}" "${_type}" ); then
        seance_log err "promote ${_guest}: the adapter cannot say where a ${_type} belongs here"
        return 1
    fi

    PROMOTE_MOUNT_PATH=${_path}
    return 0
}

# promote_mount_ceremony <guest> <replica-root> <mountpoint>
#
# The replica is promoted IN PLACE (D-44 item 4): it stays under the standby
# tree and is given the mountpoint CBSD expects, dataset by dataset, with
# canmount=noauto left alone and every mount made explicitly. The standby
# PARENTS are not touched and stay mountpoint=none -- they are not this guest's
# and never mount.
#
# rc 0 when every filesystem of the tree is mounted where it belongs.
promote_mount_ceremony()
{
    local _guest _root _mp _fs _ds _tail _target _rc

    _guest=$1
    _root=$2
    _mp=$3

    _fs=$( zfs_filesystems_r "${_root}" ) || {
        seance_log err "promote ${_guest}: cannot list the filesystems of ${_root}"
        return 1
    }

    _rc=0
    for _ds in ${_fs}; do
        _tail=${_ds#"${_root}"}
        _target="${_mp}${_tail}"

        promote_undo "zfs unmount ${_ds}; zfs inherit mountpoint ${_ds}"

        if ! zfs_set "mountpoint=${_target}" "${_ds}"; then
            seance_log err "promote ${_guest}: cannot set mountpoint=${_target} on ${_ds}"
            _rc=1
            continue
        fi

        if zfs_mounted "${_ds}"; then
            promote_note "${_ds} is already mounted at ${_target}"
            continue
        fi

        if ! zfs_mount "${_ds}"; then
            seance_log err "promote ${_guest}: cannot mount ${_ds} at ${_target}"
            _rc=1
            continue
        fi

        # AND IT IS ASKED AGAIN. `zfs mount` exiting 0 is not the same fact as
        # the dataset being mounted, and the difference is the whole of this
        # ceremony: what happens next is a registration and a start, so a
        # dataset that is not there means a guest booted over an empty
        # directory with its data sitting unmounted beside it. The
        # empty-output-with-success class (TESTING.md §5), applied to a mount.
        if ! zfs_mounted "${_ds}"; then
            seance_log err "promote ${_guest}: zfs mount ${_ds} exited 0 and ${_ds} is" \
                "still not mounted at ${_target}. Nothing has been registered or started."
            _rc=1
            continue
        fi

        promote_note "mounted ${_ds} at ${_target}"
    done

    return "${_rc}"
}

# promote_relink <guest> <replica-root> <type> <mountpoint>
#
# The symlinks a replicated guest needs before the platform can find it: the
# per-disk /dev/zvol links, whose names come from the datasets
# (sudoexec/zfs-recv:82-93), and whatever the platform itself asks for
# (adapter_guest_links -- on CBSD, a VM's jails-system and jails-data links,
# sudoexec/bcreate:598-599).
#
# <mountpoint> is where the replica IS -- the guest's own data path (D-181) --
# and it is passed to the adapter rather than worked out there, because CBSD's
# own links point at ${data} whatever ${data} is. A link made to a convention
# instead would point at a directory nothing is mounted on.
promote_relink()
{
    local _guest _root _type _mp _vols _v _name _links _line _link _target _rc

    _guest=$1
    _root=$2
    _type=$3
    _mp=$4
    _rc=0

    _vols=$( zfs_volumes_r "${_root}" 2>/dev/null ) || _vols=""
    for _v in ${_vols}; do
        _name=${_v##*/}

        if [ ! -e "/dev/zvol/${_v}" ]; then
            promote_note "no /dev/zvol/${_v} yet; ${_mp}/${_name} was not linked"
            continue
        fi

        promote_undo "rm -f ${_mp}/${_name}"
        if ln -sf "/dev/zvol/${_v}" "${_mp}/${_name}"; then
            promote_note "linked ${_mp}/${_name} -> /dev/zvol/${_v}"
        else
            seance_log err "promote ${_guest}: cannot link ${_mp}/${_name}"
            _rc=1
        fi
    done

    _links=$( adapter_guest_links "${_guest}" "${_type}" "${_mp}" ) || {
        seance_log err "promote ${_guest}: the adapter could not say which links this platform needs"
        return 1
    }

    printf '%s\n' "${_links}" | while IFS= read -r _line || [ -n "${_line}" ]; do
        [ -n "${_line}" ] || continue
        _link=${_line%%"${PROMOTE_TAB}"*}
        _target=${_line#*"${PROMOTE_TAB}"}

        if [ -e "${_link}" ] && [ ! -h "${_link}" ]; then
            seance_log err "promote ${_guest}: ${_link} exists and is not a symlink;" \
                "refusing to replace it"
            exit 1
        fi

        promote_undo "rm -f ${_link}"
        ln -sf "${_target}" "${_link}" || exit 1
        promote_note "linked ${_link} -> ${_target}"
    done || _rc=1

    return "${_rc}"
}

# promote_guest_promote <guest> <replica-root> <newest-ts> <selfkey> <now>
#                       <standby-root>
#
# Rung 6 for one guest. rc 0 when the guest is registered, running and
# recorded here.
promote_guest_promote()
{
    local _guest _root _ts _self _now _sroot _type _mp _sysdir _rcfile
    local _running _real _where _age _epoch

    _guest=$1
    _root=$2
    _ts=$3
    _self=$4
    _now=$5
    _sroot=$6

    _type=$( promote_guest_type "${_root}" )

    promote_note "${_guest}: ${_type}, replica ${_root}, promotion point ${_ts}"

    # Every dataset at the same instant, BEFORE anything is mounted (D-85).
    # Mounting a tree whose child is ahead of its root would hand the guest a
    # filesystem that no complete copy of it ever had.
    promote_align_tree "${_guest}" "${_root}" "${PROMOTE_DEAD}" "${_ts}" || return 1

    # AND ONLY THEN IS THE CONFIGURATION READ (D-181). It is read after the
    # alignment because the file that decides where this guest's data belongs
    # must be the file at the promotion point, not one an interrupted tick left
    # a child dataset holding; and before the ceremony because the ceremony is
    # what it decides.
    promote_mount_path "${_guest}" "${_type}" "${_root}" \
        "${_sroot}/${PROMOTE_DEAD}/${REPL_SYS_GUEST}" "${PROMOTE_TMPDIR}" || return 1
    _mp=${PROMOTE_MOUNT_PATH}

    promote_mount_ceremony "${_guest}" "${_root}" "${_mp}" || return 1
    promote_relink "${_guest}" "${_root}" "${_type}" "${_mp}" || return 1

    # The guest's own configuration. TWO PLACES, in this order (D-82):
    #
    #   1. where the platform looks. After the ceremony above that path
    #      resolves into the replica for anything whose configuration travels
    #      inside its own dataset -- a VM on CBSD, whose ${jailsysdir}/<n> is a
    #      symlink to the dataset (sudoexec/bcreate:599), and every guest in
    #      the pseudo-cluster.
    #   2. otherwise, out of the dead node's configuration mirror, which is
    #      where `repl` puts a JAIL's ${jailsysdir}/<n>/ precisely because
    #      nothing else replicates it.
    _sysdir=""
    _rcfile=""
    if _sysdir=$( adapter_guest_sysdir "${_guest}" 2>/dev/null ); then
        _rcfile="${_sysdir}/rc.conf_${_guest}"
    fi

    if [ -z "${_rcfile}" ] || [ ! -r "${_rcfile}" ]; then
        promote_note "${_guest}: its configuration did not travel inside its own" \
            "datasets; restoring it from ${PROMOTE_DEAD}'s configuration mirror"

        if [ -z "${_sysdir}" ]; then
            _sysdir="$( adapter_fact jailsysdir )/${_guest}"
        fi

        if ! promote_sys_restore "${_guest}" "${_sroot}/${PROMOTE_DEAD}/${REPL_SYS_GUEST}" \
                "${_sysdir}" "${PROMOTE_TMPDIR}"; then
            seance_log err "promote ${_guest}: its configuration is not here." \
                "Nothing has been started; the mounts above can be undone with the" \
                "lines printed beside them."
            return 1
        fi

        _sysdir=$( adapter_guest_sysdir "${_guest}" 2>/dev/null ) || {
            seance_log err "promote ${_guest}: the adapter still cannot say where this" \
                "guest's configuration directory is"
            return 1
        }
        _rcfile="${_sysdir}/rc.conf_${_guest}"
    fi

    if [ ! -r "${_rcfile}" ]; then
        seance_log err "promote ${_guest}: no readable ${_rcfile}." \
            "The guest's data arrived but its configuration did not, so nothing here" \
            "can register it. Nothing has been started; the mounts above can be undone" \
            "with the lines printed beside them."
        return 1
    fi

    promote_undo "seance failback-assist ${_guest} unregister"
    if ! adapter_guest_register "${_guest}" "${_rcfile}"; then
        seance_log err "promote ${_guest}: registration from ${_rcfile} failed"
        return 1
    fi
    promote_note "registered ${_guest} from ${_rcfile}"

    # THE PLATFORM'S OWN ANSWER, NOW THAT IT HAS ONE, and it is asked about the
    # PATH rather than about the type (D-181).
    #
    # What matters at this instant is one thing: does the platform, having read
    # the registration, look for this guest's data where the replica is
    # mounted? That is a question the platform answers directly -- the `data`
    # field of the guest it has just registered -- and a disagreement means the
    # next step would start a guest over a directory with nothing in it.
    #
    # WHAT THIS REPLACED, AND WHY IT HAD TO GO. The comparison used to be
    # against `adapter_guest_mountpoint <guest> <platform's type>`: where this
    # platform would CREATE a guest of that type. On the first real fleet the
    # replica's datasets look like a jail (no zvols -- the disks are files
    # inside the data directory) while the platform registers a bhyve, and the
    # bhyve convention is ${workdir}/vm/<n>, which is not where any of those
    # guests live. The check would have failed every promotion on that fleet
    # AFTER registering the guest -- a false alarm about a correctly mounted
    # replica, which is worse than no check at all because it stops a promotion
    # that was going right.
    #
    # THE TYPE DISAGREEMENT IS STILL REPORTED, and is no longer fatal by
    # itself. What promote_guest_type answers is what the replica's DISK LAYOUT
    # says (zvols or not), which is the right predictor of the symlinks
    # promote_relink has to make and not a claim about the emulator; the
    # platform's word for the guest and the shape of its disks are two
    # different facts and only their effect on the path can be checked here.
    _real=$( adapter_guest_type "${_guest}" 2>/dev/null ) || _real=""
    if [ -n "${_real}" ] && [ "${_real}" != "${_type}" ]; then
        promote_note "${_guest}: the platform calls this a ${_real}; its replica's" \
            "datasets have the shape of a ${_type}, which is what the relinking was" \
            "done for. The mounted path is checked against the platform next"
    fi

    _where=$( adapter_guest_data_path "${_guest}" 2>/dev/null ) || _where=""
    if [ -z "${_where}" ]; then
        promote_note "${_guest}: the platform records no data path for it, so there is" \
            "nothing to check the mount against; it was mounted at ${_mp}"
    elif [ "${_where}" != "${_mp}" ]; then
        seance_log err "promote ${_guest}: it is registered here and the platform looks" \
            "for its data at ${_where}, while its replica is mounted at ${_mp}." \
            "The guest has NOT been started -- it would have started over a directory" \
            "that is not its own. Undo with the lines printed above."
        return 1
    else
        promote_note "${_guest}: the platform looks for its data at ${_where}," \
            "which is where its replica is mounted"
    fi

    promote_undo "seance failback-assist ${_guest} stop"
    if ! adapter_guest_start "${_guest}"; then
        seance_log err "promote ${_guest}: start failed"
        return 1
    fi

    _running=$( adapter_guest_running "${_guest}" ) || _running=""
    if [ "${_running}" != "1" ]; then
        seance_log err "promote ${_guest}: started, but the platform does not report it running" \
            "[${_running}]"
        return 1
    fi
    promote_note "started ${_guest}, and the platform reports it running"

    # --- the records ------------------------------------------------------
    promote_note "succession.log is append-only and is not undone; failback appends" \
        "its own record rather than deleting this one"
    if ! promote_record "${_guest}" "${PROMOTE_DEAD}" "${_self}" "${_now}" \
            "${PROMOTE_EVIDENCE}"; then
        seance_log err "promote ${_guest}: could not append the succession record"
        return 1
    fi

    promote_undo "seance failback-assist ${_guest} release"
    if ! placement_set "${_guest}" "${PROMOTE_DEAD}"; then
        seance_log err "promote ${_guest}: could not record the placement"
        return 1
    fi

    # --- what it cost -----------------------------------------------------
    _epoch=$( pol_ts_to_epoch "${_ts}" ) || _epoch=""
    if [ -n "${_epoch}" ]; then
        _age=$(( _now - _epoch ))
        [ "${_age}" -lt 0 ] && _age=0
        promote_note "${_guest}: RPO $( status_age_human "${_age}" ) -- everything written" \
            "after ${_ts} is gone"
    fi

    return 0
}

# promote_record <guest> <old_home> <new_home> <now-epoch> <evidence>
#
# One append-only TSV record per guest (handoff §2.7, D-44 item 6):
# guest, old home, new home, UTC timestamp, evidence.
promote_record()
{
    local _dir _f _ts

    _dir=$( seance_state_dir ) || return 1
    _f="${_dir}/succession.log"

    _ts=$( pol_epoch_to_ts "$4" ) || return 1

    mkdir -p "${_dir}" || return 1
    printf '%s\t%s\t%s\t%s\t%s\n' "$1" "$2" "$3" "${_ts}" "${5:-unknown}" >> "${_f}"
}

# ---------------------------------------------------------------------------
# The ladder
# ---------------------------------------------------------------------------

# promote_run <deadkey> [<guest-filter>]
#
# PROMOTE_FORCE must already be set (promote_parse_force). Returns 0 when at
# least one guest was promoted and nothing was left in a state needing a human,
# 1 when the ladder stopped, 2 on a usage or configuration error.
promote_run()
{
    local _dead _gf _self _now _rc _sroot _estate _row _guest _ds _ts
    local _left _peers

    _dead=$1
    _gf=${2:-}

    PROMOTE_DEAD=${_dead}
    PROMOTE_OPERATOR=$( promote_operator )
    PROMOTE_EVIDENCE=""
    PROMOTE_DISPOSITION=""
    PROMOTE_STOPPED_RUNG=""
    PROMOTE_REACHABLE=""
    PROMOTE_UNREPORTED=""
    PROMOTE_KERNEL=""
    PROMOTE_KERNEL_DETAIL=""
    PROMOTE_GUESTS_PROMOTED=0
    PROMOTE_GUESTS_SEEN=0
    PROMOTE_GUEST_DISPOSITIONS=""
    PROMOTE_DEFERRED=""
    PROMOTE_AUTO_VHID=""

    PROMOTE_TMPDIR=$( seance_tmpdir ) || {
        printf 'promote: FAIL — no temporary directory\n'
        return 2
    }

    _self=$( seance_self_key ) || {
        seance_log err "promote: this node is not in the configuration;" \
            "no node_*_nodename matches it"
        printf 'promote: FAIL — this node is not in its own configuration\n'
        return 2
    }

    if [ "${_dead}" = "${_self}" ]; then
        seance_log err "promote: ${_dead} is this node"
        printf 'promote: FAIL — a node cannot succeed itself\n'
        return 2
    fi

    if ! conf_has "node_${_dead}_nodename"; then
        seance_log err "promote: no node called \"${_dead}\" in the configuration"
        printf 'promote: FAIL — no such node: %s\n' "${_dead}"
        return 2
    fi

    # --- the automatic path's own preconditions ---------------------------
    #
    # A force and an --auto are contradictory instructions: --force is a human
    # taking responsibility for a rung that could not answer, and --auto is
    # devd acting with no human anywhere. Accepting both would mean a
    # configuration file could arrange for an unattended forced promotion,
    # which is the one thing --force must never be able to be.
    if [ "${PROMOTE_AUTO}" -eq 1 ]; then
        if [ -n "${PROMOTE_FORCE}" ]; then
            seance_log err "promote: --auto and --force are contradictory:" \
                "a force is a human accepting a rung that could not answer, and" \
                "--auto is a run with no human in it. Rungs 1-4 must all be green."
            printf 'promote: FAIL — --force may not be combined with --auto\n'
            return 2
        fi

        PROMOTE_DEBOUNCE_REQUIRED=1
        PROMOTE_AUTO_VHID=$( carp_vhid "${_dead}" ) || PROMOTE_AUTO_VHID=""

        # --- rung 0 -------------------------------------------------------
        if ! promote_rung_arming "${_self}"; then
            PROMOTE_STOPPED_RUNG="0 arming"
            printf 'promote: stopped at rung %s%s%s\n' \
                "${PROMOTE_STOPPED_RUNG}" "${PROMOTE_SEP}" "${PROMOTE_DISPOSITION}"
            promote_auto_report
            return 1
        fi
    fi

    _now=$( pol_now ) || {
        printf 'promote: FAIL — this node cannot read its own clock\n'
        return 2
    }

    # --- rung 1 -----------------------------------------------------------
    if ! promote_rung_debounce; then
        PROMOTE_STOPPED_RUNG="1 debounce"
        PROMOTE_DISPOSITION=${PROMOTE_DISPOSITION:-abort}
        printf 'promote: stopped at rung %s%s%s\n' \
            "${PROMOTE_STOPPED_RUNG}" "${PROMOTE_SEP}" "${PROMOTE_DISPOSITION}"
        promote_auto_report
        return 1
    fi

    # --- rung 2 -----------------------------------------------------------
    promote_rung_quorum "${_self}"
    _rc=$?
    if [ "${_rc}" -ne 0 ]; then
        PROMOTE_STOPPED_RUNG="2 quorum"
        printf 'promote: stopped at rung %s%s%s\n' \
            "${PROMOTE_STOPPED_RUNG}" "${PROMOTE_SEP}" "${PROMOTE_DISPOSITION}"
        promote_auto_report
        [ "${_rc}" -eq 2 ] && return 2
        return 1
    fi

    # --- rung 3 -----------------------------------------------------------
    promote_rung_probes
    _rc=$?
    if [ "${_rc}" -ne 0 ]; then
        PROMOTE_STOPPED_RUNG="3 probes"
        printf 'promote: stopped at rung %s%s%s\n' \
            "${PROMOTE_STOPPED_RUNG}" "${PROMOTE_SEP}" "${PROMOTE_DISPOSITION}"
        promote_auto_report
        [ "${_rc}" -eq 2 ] && return 2
        return 1
    fi

    # --- rung 4 -----------------------------------------------------------
    promote_rung_fence
    _rc=$?
    if [ "${_rc}" -ne 0 ]; then
        PROMOTE_STOPPED_RUNG="4 fence"
        printf 'promote: stopped at rung %s%s%s\n' \
            "${PROMOTE_STOPPED_RUNG}" "${PROMOTE_SEP}" "${PROMOTE_DISPOSITION}"
        promote_auto_report
        [ "${_rc}" -eq 2 ] && return 2
        return 1
    fi

    [ -n "${PROMOTE_EVIDENCE}" ] || PROMOTE_EVIDENCE="force:${PROMOTE_OPERATOR}"

    # --- rung 5 -----------------------------------------------------------
    if ! _sroot=$( promote_standby_root "${_self}" ); then
        promote_rung 5 lineage abort \
            "cannot tell where this node keeps replicas: standby_root is unset and" \
            "no guest of this node's own could be used to derive it"
        PROMOTE_DISPOSITION=abort
        PROMOTE_STOPPED_RUNG="5 lineage"
        printf 'promote: stopped at rung %s%s%s\n' \
            "${PROMOTE_STOPPED_RUNG}" "${PROMOTE_SEP}" abort
        promote_auto_report
        return 2
    fi

    _estate=$( promote_estate "${_sroot}" "${_dead}" ) || _estate=""

    if [ -z "${_estate}" ]; then
        promote_rung 5 lineage abort \
            "no guest under ${_sroot}/${_dead} carries a @seance-${_dead}-* snapshot:" \
            "this node holds no estate for ${_dead}, and empty is never read as ready"
        PROMOTE_DISPOSITION=abort
        PROMOTE_STOPPED_RUNG="5 lineage"
        printf 'promote: stopped at rung %s%s%s\n' \
            "${PROMOTE_STOPPED_RUNG}" "${PROMOTE_SEP}" abort
        promote_auto_report
        return 1
    fi

    promote_claims_gather
    promote_kernel_check "${_self}"

    promote_rung 5 lineage pass \
        "estate of ${_dead} under ${_sroot}/${_dead}:" \
        "$( printf '%s\n' "${_estate}" | cut -f 1 | tr '\n' ' ' )" \
        "(kernel homogeneity: ${PROMOTE_KERNEL} -- ${PROMOTE_KERNEL_DETAIL};" \
        "placements read from ${PROMOTE_REACHABLE:-no peer}${PROMOTE_UNREPORTED:+, NOT read from }${PROMOTE_UNREPORTED})"

    _left=""
    printf '%s\n' "${_estate}" > "${PROMOTE_TMPDIR}/estate"

    while IFS= read -r _row || [ -n "${_row}" ]; do
        [ -n "${_row}" ] || continue

        _guest=${_row%%"${PROMOTE_TAB}"*}
        _ds=${_row#*"${PROMOTE_TAB}"}
        _ts=${_ds#*"${PROMOTE_TAB}"}
        _ds=${_ds%%"${PROMOTE_TAB}"*}

        [ -n "${_gf}" ] && [ "${_gf}" != "${_guest}" ] && continue

        PROMOTE_GUESTS_SEEN=$(( PROMOTE_GUESTS_SEEN + 1 ))

        if promote_guest_disposition "${_guest}" "${_ds}" "${_ts}" "${_self}" "${_now}"; then
            _left="${_left} ${_guest}${PROMOTE_TAB}${_ds}${PROMOTE_TAB}${_ts}"
        fi
    done < "${PROMOTE_TMPDIR}/estate"

    if [ -n "${_gf}" ] && [ "${PROMOTE_GUESTS_SEEN}" -eq 0 ]; then
        seance_log err "promote: ${_dead} has no guest called \"${_gf}\" on this node"
        printf 'promote: FAIL%sno guest called "%s" in the estate of %s held here\n' \
            "${PROMOTE_SEP}" "${_gf}" "${_dead}"
        return 2
    fi

    # --- rung 6 -----------------------------------------------------------
    if [ -z "${_left}" ]; then
        promote_rung 6 promotion "n/a" \
            "no guest of ${_dead}'s estate is this node's to promote right now"
    else
        promote_rung 6 promotion pass \
            "promoting, alphabetically:" \
            "$( printf '%s' "${_left}" | tr ' ' '\n' | cut -f 1 | tr '\n' ' ' )"

        printf '%s' "${_left}" | tr ' ' '\n' > "${PROMOTE_TMPDIR}/todo"

        while IFS= read -r _row || [ -n "${_row}" ]; do
            [ -n "${_row}" ] || continue

            _guest=${_row%%"${PROMOTE_TAB}"*}
            _ds=${_row#*"${PROMOTE_TAB}"}
            _ts=${_ds#*"${PROMOTE_TAB}"}
            _ds=${_ds%%"${PROMOTE_TAB}"*}

            if promote_guest_promote "${_guest}" "${_ds}" "${_ts}" "${_self}" \
                    "${_now}" "${_sroot}"; then
                PROMOTE_GUESTS_PROMOTED=$(( PROMOTE_GUESTS_PROMOTED + 1 ))
            else
                PROMOTE_GUEST_DISPOSITIONS=$( printf '%s' "${PROMOTE_GUEST_DISPOSITIONS}" |
                    sed -e "s|${_guest}=proceed|${_guest}=abort|" )
            fi
        done < "${PROMOTE_TMPDIR}/todo"
    fi

    # --- rung 7 -----------------------------------------------------------
    #
    # Nothing to configure, and that is the assertion: `repl` already
    # replicates every guest THIS node hosts (adapter_guest_list) to that
    # guest's heirs, and a guest promoted here is now one of them. The
    # direction reverses because the home in the snapshot name is the node
    # taking it, not the node the guest came from.
    _peers=$( pol_heirs "$( conf_get "node_${_self}_heir" "" )" \
        "$( conf_get "node_${_self}_heir2" "" )" "" "" 2>/dev/null |
        tr '\n' ' ' ) || _peers=""
    promote_rung 7 post "n/a (nothing to configure)" \
        "the next repl tick on this node snapshots every guest it hosts as" \
        "@seance-${_self}-* and sends to that guest's heirs (${_peers:-see the succession map});" \
        "${_dead} is one of them again the moment it returns, and until then that pair" \
        "is logged as failed, not fatal"

    PROMOTE_DISPOSITION=$( promote_worst_disposition )

    # Before the verdict line, never after it: the verdict is the last line of
    # stdout (D-110) and the tier-7 oracle reads it as one.
    if [ -n "${PROMOTE_DEFERRED}" ]; then
        printf 'deferred%sno automation will promote these; run each command on the node named:\n' \
            "${PROMOTE_SEP}"
        printf '%s' "${PROMOTE_DEFERRED}"
    fi

    printf 'promote: %d of %d guest(s) promoted from %s%sevidence %s, disposition %s\n' \
        "${PROMOTE_GUESTS_PROMOTED}" "${PROMOTE_GUESTS_SEEN}" "${_dead}" \
        "${PROMOTE_SEP}" "${PROMOTE_EVIDENCE}" "${PROMOTE_DISPOSITION}"

    promote_auto_report

    case "${PROMOTE_DISPOSITION}" in
        proceed|stand-down) return 0 ;;
    esac

    return 1
}

# promote_worst_disposition
#
# One word for a run that may have decided differently about each guest, worst
# first: an operator reading the exit code must not have to guess which guest
# it belongs to, and the per-guest lines above say which is which.
promote_worst_disposition()
{
    local _d _w

    _w=""

    for _d in ${PROMOTE_GUEST_DISPOSITIONS}; do
        case "${_d#*=}" in
            abort)      printf 'abort\n'; return 0 ;;
            notify)     _w=notify ;;
            force-only) [ "${_w}" = "notify" ] || _w=force-only ;;
            # deferred outranks stand-down and proceed, and is outranked by
            # everything that stopped a rung: a run that promoted four guests
            # and left one for a node nobody woke has not finished, and its
            # exit status says so (D-130).
            deferred)
                case "${_w}" in
                    notify|force-only) ;;
                    *) _w=deferred ;;
                esac
                ;;
            stand-down) [ -n "${_w}" ] || _w=stand-down ;;
            proceed)    [ -n "${_w}" ] || _w=proceed ;;
        esac
    done

    [ -n "${_w}" ] || _w=abort

    printf '%s\n' "${_w}"
}
